# Dependencias
node_modules/

# Variables de entorno sensibles
.env
.env.production
.env.local

# Caché de sesión OAuth — contiene access_token y refresh_token activos
src/scripts/.ml_token_cache.json

# Catálogo editorial — activo de negocio, no código público
src/data/ids_curados.json

# ── DATOS DERIVADOS (se regeneran en cada build; NUNCA versionar) ────────────
# Versionar estos archivos es lo que dejó la portada sirviendo precios de junio
# durante dos meses: el extractor falló, nadie se enteró, y el JSON viejo
# seguía en el repo listo para desplegarse.
src/data/secciones-feed.json
public/_redirects
docker/redirects.caddy
public/data/relampago.json
public/data/enlaces.json
public/data/feed.json

# ── OBSERVACIÓN ACUMULADA — esto SÍ se versiona ─────────────────────────────
# src/data/historico-precios.json NO está en esta lista, y no debe estarlo.
# Los archivos de arriba son DERIVADOS: cada build los regenera. El histórico
# de precios es lo contrario — si se borra, se pierde para siempre: no hay
# forma de reconstruir a qué precio estaba un producto la semana pasada.
# Se poda solo (90 días de historia, 30 sin aparecer y fuera), así que no
# crece sin techo. Si algún día "estorba", pódalo; no lo ignores.

