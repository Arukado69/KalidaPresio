---
/**
 * Layout — El papel sobre el que se pega todo.
 *
 * Dirección de arte en src/styles/global.css («el tianguis honesto»).
 *
 * Lo que este layout ya NO carga, a propósito: GSAP + ScrollTrigger (~46 KB
 * gzip solo para animar), View Transitions y una docena de efectos de cursor.
 * Las animaciones que quedan son CSS (las cartulinas «se pegan», los sellos
 * «golpean») y respetan prefers-reduced-motion. El único JavaScript propio es
 * funcional: cuentas regresivas, relámpagos en vivo y el enlace activo.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Newsletter from '../components/Newsletter.astro';
import Analitica from '../components/Analitica.astro';
import SelloFrescura from '../components/SelloFrescura.astro';
import { GENERADO_EL } from '../data/secciones.js';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Medidas reales de ogImage. La tarjeta de un producto es 4:5 (1080×1350). */
  ogImageAncho?: number;
  ogImageAlto?: number;
  ogType?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  ogImageAncho = 1200,
  ogImageAlto = 630,
  ogType = 'website',
} = Astro.props;

const metaTitle = title.length > 60 ? title.substring(0, 57) + '...' : title;
const metaDescription = description.length > 160 ? description.substring(0, 157) + '...' : description;

// Open Graph exige URLs ABSOLUTAS: una ruta relativa como "/og-default.png" no
// la resuelve ningún scraper (WhatsApp, Facebook, X) y la vista previa sale sin
// imagen. `Astro.site` viene de `site` en astro.config.mjs.
const urlCanonica = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
const ogImageAbsoluta = new URL(ogImage, Astro.site).href;

// JSON-LD de sitio y organización. Describe lo que KalidaPresio ES; nada de
// ratings agregados inventados (la versión anterior emitía un aggregateRating
// fijo de 4.5 con un reviewCount derivado del número de bullets del texto, que
// es exactamente el marcado de reseñas falso que Google sanciona).
const datosSitio = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: Astro.site?.href,
      name: 'KalidaPresio',
      inLanguage: 'es-MX',
      description:
        'Revisamos precios, calificaciones y ventas reales de Mercado Libre México para recomendar las mejores ofertas calidad-precio.',
      publisher: { '@id': `${Astro.site}#org` },
    },
    {
      '@type': 'Organization',
      '@id': `${Astro.site}#org`,
      name: 'KalidaPresio',
      url: Astro.site?.href,
      logo: new URL('/favicon.svg', Astro.site).href,
    },
  ],
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f3ede0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Cuatro voces: rótulo, plumón, texto y ticket (ver global.css).
         swap = sin bloquear el render; el respaldo del sistema ya se parece. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=Martian+Mono:wght@400;600&family=Permanent+Marker&family=Schibsted+Grotesk:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />

    <!-- Open Graph Protocol -->
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageAbsoluta} />
    <meta property="og:image:width" content={String(ogImageAncho)} />
    <meta property="og:image:height" content={String(ogImageAlto)} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KalidaPresio" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageAbsoluta} />

    <!-- Canonical URL (absoluta; ver nota en el frontmatter) -->
    <link rel="canonical" href={urlCanonica} />

    <!-- Analítica (Umami autoalojado). No emite nada si no está configurada. -->
    <Analitica />

    <!-- Schema.org: quiénes somos. Solo hechos verificables del sitio. -->
    <script type="application/ld+json" set:html={JSON.stringify(datosSitio)} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />

    <main id="contenido" class="principal">
      <slot />
    </main>

    <!-- Boletín (doble opt-in, sin login) — en todo el sitio, antes del pie -->
    <Newsletter />

    <footer class="pie">
      <div class="hoja pie-in">
        <div class="pie-marca">
          <p class="pie-logo rotulo">Kalida<span>Presio</span></p>
          <p class="pie-lema plumon">Precios a la vista. Sin cuento.</p>
        </div>
        <nav class="pie-nav" aria-label="Pie de página">
          <a href="/">Inicio</a>
          <a href="/hoy">Ofertas de hoy</a>
          <a href="/ofertas">Por presupuesto</a>
          <a href="/buen-fin">Detector del Buen Fin</a>
          <a href="/sobre-mi">Cómo calificamos</a>
          <a href="/contacto">Contacto</a>
          <a href="/privacidad">Aviso de privacidad</a>
        </nav>
        <!-- Divulgación honesta: los precios son una foto, no un contrato.
             La compra ocurre en ML a su precio; por eso pedimos verificar. -->
        <p class="pie-aviso">
          En KalidaPresio elegimos a mano ofertas de Mercado Libre México y anotamos el día
          en que vimos cada precio. Los precios son una referencia de ese momento —
          <strong>verifica siempre el precio final en Mercado Libre antes de comprar</strong>.
          {GENERADO_EL && <SelloFrescura generadoEl={GENERADO_EL} variante="pie" punto />}
        </p>
        <p class="pie-aviso">
          Participamos en el Programa de Afiliados de Mercado Libre: si compras por nuestros enlaces
          recibimos una comisión, sin costo extra para ti. La comisión no cambia qué recomendamos.
        </p>
        <p class="pie-copy etiqueta">© {new Date().getFullYear()} KalidaPresio · Hecho en México</p>
      </div>
    </footer>

    <script>
      // ── Lo único que hace falta en el navegador ─────────────────────────────
      // 1) Cuentas regresivas de relámpago ([data-countdown][data-fin]).
      // 2) Relámpagos en vivo: el carrusel lee /data/relampago.json al abrir,
      //    para no anunciar una que ya terminó aunque el HTML sea de ayer.
      // 3) El enlace del menú de la página actual.

      const esc = (s: unknown) =>
        String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
      const pesos = (n: number) =>
        new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(Number(n) || 0);

      function restante(ms: number) {
        if (ms <= 0) return 'terminó';
        const s = Math.floor(ms / 1000);
        const h = Math.floor(s / 3600);
        const m = Math.floor((s % 3600) / 60);
        const seg = s % 60;
        const dos = (n: number) => String(n).padStart(2, '0');
        return `${h > 0 ? `${h}:` : ''}${dos(m)}:${dos(seg)}`;
      }

      function cuentas() {
        const nodos = Array.from(document.querySelectorAll<HTMLElement>('[data-countdown][data-fin]'));
        if (!nodos.length) return;
        const pintar = () => {
          const ahora = Date.now();
          for (const n of nodos) {
            const fin = Date.parse(n.dataset.fin || '');
            if (Number.isNaN(fin)) continue;
            n.textContent = restante(fin - ahora);
            // Una relámpago que terminó se retira de la vista.
            if (fin <= ahora) n.closest('[data-relampago-item]')?.remove();
          }
        };
        pintar();
        setInterval(pintar, 1000);
      }

      async function relampagos() {
        const zona = document.querySelector<HTMLElement>('[data-relampago]');
        if (!zona) return;
        const lista = zona.querySelector<HTMLElement>('[data-relampago-lista]');
        try {
          const r = await fetch(zona.dataset.rsUrl || '/data/relampago.json', { cache: 'no-cache' });
          const datos = await r.json();
          const ahora = Date.now();
          const vivas = (datos?.ofertas ?? []).filter((o: any) => Date.parse(o.endsAt || o.caduca || '') > ahora).slice(0, 8);
          if (!vivas.length || !lista) return;
          lista.innerHTML = vivas.map((o: any, i: number) => `
            <article class="rel-carta anima-pegar" data-relampago-item style="--i:${i};--giro:${i % 2 ? 1.4 : -1.2}deg">
              ${o.imagen ? `<img src="${esc(o.imagen)}" alt="" width="96" height="96" loading="lazy">` : ''}
              <div class="rel-datos">
                <p class="rel-titulo">${esc(o.titulo)}</p>
                <p class="rel-precio"><span class="plumon">${pesos(o.precioActual)}</span>${o.precioOriginal ? ` <s class="tache">${pesos(o.precioOriginal)}</s>` : ''}</p>
                ${o.endsAt ? `<p class="etiqueta">Termina en <b data-countdown data-fin="${esc(o.endsAt)}">—</b></p>` : ''}
                <a class="boton boton--chico" href="${esc(o.urlAfiliado)}" target="_blank" rel="nofollow sponsored noopener noreferrer"
                   data-ml-id="${esc(o.id)}" data-kp-seccion="relampago" data-precio="${Number(o.precioActual) || 0}"
                   data-kp="${Number(o.scoreKP) || 0}" data-descuento="${Number(o.descuentoReal) || 0}">Ver la relámpago</a>
              </div>
            </article>`).join('');
          zona.hidden = false;
          cuentas();
        } catch { /* sin relámpagos: la sección se queda escondida */ }
      }

      function menuActivo() {
        const aqui = location.pathname.replace(/\/$/, '') || '/';
        document.querySelectorAll<HTMLAnchorElement>('[data-menu] a[href]').forEach((a) => {
          const destino = (a.getAttribute('href') || '').replace(/\/$/, '') || '/';
          if (destino === aqui) a.setAttribute('aria-current', 'page');
        });
      }

      menuActivo();
      cuentas();
      relampagos();
    </script>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    background: var(--fosfo);
    color: var(--tinta);
    padding: 0.6rem 1rem;
    font-weight: 700;
  }
  .saltar:focus { top: 12px; }

  .principal { display: block; min-height: 60vh; }

  .pie {
    margin-top: clamp(3rem, 8vw, 6rem);
    background: var(--tinta);
    color: var(--papel);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem;
  }
  .pie-in { display: grid; gap: 1.6rem; }
  .pie-marca { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1.2rem; }
  .pie-logo { margin: 0; font-size: clamp(2.6rem, 9vw, 5.2rem); color: var(--papel); letter-spacing: 0.01em; }
  .pie-logo span { color: var(--fosfo); }
  .pie-lema { margin: 0; font-size: 1.25rem; color: var(--fosfo); transform: rotate(-2deg); }
  .pie-nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }
  .pie-nav a { color: var(--papel); font-weight: 700; text-decoration: none; border-bottom: 2px solid transparent; }
  .pie-nav a:hover { border-bottom-color: var(--fosfo); }
  .pie-aviso { margin: 0; max-width: 78ch; color: rgba(243, 237, 224, 0.78); font-size: 0.86rem; line-height: 1.7; }
  .pie-aviso strong { color: var(--papel); }
  .pie-copy { margin: 0; color: rgba(243, 237, 224, 0.55); }

  /* Relámpagos: el HTML lo pinta el script, por eso estos estilos son globales. */
  :global(.rel-carta) {
    --giro: -1.2deg;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 0.9rem;
    align-items: start;
    background: var(--fosfo-naranja);
    padding: 0.9rem;
    transform: rotate(var(--giro));
    box-shadow: var(--sombra-papel);
    border-radius: 2px;
    min-width: min(320px, 86vw);
    scroll-snap-align: start;
  }
  :global(.rel-carta img) { width: 96px; height: 96px; object-fit: contain; background: var(--cartulina); border-radius: 2px; }
  :global(.rel-titulo) { margin: 0 0 0.3rem; font-weight: 700; font-size: 0.92rem; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  :global(.rel-precio) { margin: 0 0 0.3rem; display: flex; align-items: baseline; gap: 0.5rem; }
  :global(.rel-precio .plumon) { font-size: 1.7rem; line-height: 1; }
  :global(.rel-datos .etiqueta) { margin: 0 0 0.6rem; color: var(--tinta); }
</style>
