---
/**
 * 404 — Página de "no encontrado" real.
 *
 * Antes no existía y el Caddyfile hacía `try_files … /index.html`: CUALQUIER
 * URL inexistente devolvía la portada con HTTP 200. Google lo registra como
 * soft-404 y diluye el rastreo de las páginas que sí importan.
 *
 * La ruta más común para caer aquí es un enlace viejo a una oferta que ya
 * terminó, así que el copy empuja de vuelta a las ofertas vivas.
 */
import Layout from '../layouts/Layout.astro';
import { CATALOGO } from '../data/secciones.js';

// Tres sugerencias reales de la vitrina, no enlaces genéricos.
const sugerencias = CATALOGO.slice(0, 3);
const pesos = (n) =>
  new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(Number(n) || 0);
---

<Layout
  title="Página no encontrada — KalidaPresio"
  description="Esa página no existe o la oferta ya caducó. Te dejamos las ofertas que sí están vivas ahora mismo."
>
  <section class="e404 hoja">
    <div class="e404-letrero" aria-hidden="true">
      <span class="e404-num">404</span>
      <span class="e404-sello sello anima-sellar" style="--giro:-12deg;--retraso:.25s">Se acabó</span>
    </div>
    <h1 class="e404-titulo">Esta página ya no está aquí</h1>
    <p class="e404-texto">
      Puede que la oferta haya caducado (las buenas duran poco) o que el enlace esté mal escrito. Ninguna de las dos
      cosas es culpa tuya.
    </p>
    <div class="e404-acciones">
      <a class="boton" href="/">Ver las de hoy</a>
      <a class="boton boton--papel" href="/ofertas">Por sección</a>
    </div>

    {sugerencias.length > 0 && (
      <div class="e404-sug">
        <h2 class="e404-sub">Mientras, esto sí está vivo</h2>
        <ul class="e404-lista">
          {sugerencias.map((o, i) => (
            <li class="anima-pegar" style={`--i:${i + 2}`}>
              <a class="e404-carta" href={o.link_afiliado} data-ml-id={o.id} data-kp-seccion="sugerencia404" target="_blank" rel="nofollow sponsored noopener noreferrer">
                <span class="e404-sug-precio plumon">{pesos(o.precio_actual)}</span>
                <span class="e404-sug-titulo">{o.titulo}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Layout>

<style>
  .e404 { padding-block: clamp(2rem, 6vw, 4rem) 0; text-align: center; }
  .e404-letrero { position: relative; display: inline-block; margin-bottom: 0.5rem; }
  .e404-num { display: block; font: 900 clamp(7rem, 30vw, 15rem)/0.8 var(--f-rotulo); color: var(--tinta); opacity: 0.12; letter-spacing: -0.02em; }
  .e404-sello { position: absolute; top: 50%; left: 50%; translate: -50% -50%; font-size: clamp(1.8rem, 6vw, 3rem); white-space: nowrap; }
  .e404-titulo { font-size: clamp(2.4rem, 7vw, 4.4rem); text-transform: uppercase; margin: 0.4rem auto 1rem; max-width: 16ch; }
  .e404-texto { color: var(--tinta-2); max-width: 52ch; margin-inline: auto; }
  .e404-acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.9rem; margin-top: 1.8rem; }

  .e404-sug { margin-top: clamp(3rem, 7vw, 4.5rem); }
  .e404-sub { font-size: clamp(1.8rem, 4.5vw, 2.6rem); text-transform: uppercase; margin-bottom: 1.4rem; }
  .e404-lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1.2rem; text-align: left; }
  .e404-carta {
    display: grid;
    gap: 0.4rem;
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--cartulina);
    border: 2px solid var(--tinta);
    box-shadow: 4px 4px 0 var(--tinta);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .e404-carta:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--tinta); }
  .e404-sug-precio { font-size: 1.7rem; line-height: 1.1; }
  .e404-sug-titulo { font-size: 0.92rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
