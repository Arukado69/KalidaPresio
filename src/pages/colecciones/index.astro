---
/**
 * /colecciones — Página índice (Hub) de todas las colecciones.
 *
 * Propósito SEO: actúa como "Hub Page" que enlaza a todos los clústeres.
 * Google la rastrea y distribuye autoridad hacia cada colección hija.
 * También sirve como página de descubrimiento para el usuario.
 */
import Layout from '../../layouts/Layout.astro';
import { COLECCIONES_ACTIVAS } from '../../data/colecciones.js';
import Explorar from '../../components/Explorar.astro';

const colores = ['', 'cartulina--rosa', 'cartulina--verde', 'cartulina--cielo', 'cartulina--naranja'];
const giros = [-1.6, 1.4, -0.9, 1.8, -1.2];
---

<Layout
  title="Colecciones — KalidaPresio"
  description="Colecciones de ofertas de Mercado Libre México elegidas a mano: por presupuesto, tecnología, lo más vendido y el mayor descuento, ordenadas con el Sello K-P."
>
  <article class="ci hoja">
    <nav class="ci-migas etiqueta" aria-label="Estás en">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">Colecciones</span>
    </nav>

    <header class="ci-cabeza">
      <h1 class="ci-titulo">Colecciones</h1>
      <p class="ci-sub">
        Cada colección agrupa lo que elegimos a mano con un criterio: presupuesto, tecnología, lo más vendido o el
        mayor descuento. Dentro, se ordenan con el Sello K-P.
      </p>
    </header>

    {COLECCIONES_ACTIVAS.length > 0 ? (
      <ul class="ci-pared">
        {COLECCIONES_ACTIVAS.map((col, i) => (
          <li class="anima-pegar" style={`--i:${i + 1}`}>
            <a href={`/colecciones/${col.slug}`} class:list={['ci-carta', 'cartulina', 'con-cinta', colores[i % colores.length]]} style={`--giro:${giros[i % giros.length]}deg`}>
              <span class="ci-n plumon">{col.items.length}</span>
              <span class="ci-carta-t rotulo">{col.titulo}</span>
              <span class="ci-carta-d">{col.descripcion.length > 120 ? `${col.descripcion.slice(0, 117).trimEnd()}…` : col.descripcion}</span>
              <span class="ci-ver etiqueta">Ver colección →</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="ci-vacio cartulina cartulina--blanca con-cinta">
        <p class="ci-vacio-h rotulo">Hoy no hay colecciones</p>
        <p>Una colección necesita al menos dos productos elegidos a mano. <a href="/">En la portada</a> están todas las de hoy.</p>
      </div>
    )}

    <Explorar solo="secciones" titulo="También por sección" />
  </article>
</Layout>

<style>
  .ci { padding-block: clamp(1.2rem, 3vw, 2rem) 0; }
  .ci-migas { margin-bottom: 1.2rem; }
  .ci-migas a { color: inherit; }
  .ci-cabeza { margin-bottom: clamp(2.2rem, 5vw, 3.2rem); }
  .ci-titulo { font-size: clamp(3rem, 9vw, 6rem); text-transform: uppercase; margin-bottom: 0.9rem; }
  .ci-sub { color: var(--tinta-2); max-width: 60ch; }

  .ci-pared {
    list-style: none;
    margin: 0;
    padding: 0.6rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(2rem, 4vw, 2.8rem) clamp(1.4rem, 3vw, 2.2rem);
  }
  .ci-carta {
    display: grid;
    gap: 0.6rem;
    height: 100%;
    padding: 1.6rem 1.4rem 1.3rem;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .ci-carta:hover { transform: rotate(0deg) translateY(-4px); box-shadow: 8px 10px 0 var(--tinta); }
  .ci-n { font-size: 3.4rem; line-height: 1; }
  .ci-carta-t { font-size: clamp(1.7rem, 3.2vw, 2.2rem); }
  .ci-carta-d { font-size: 0.9rem; line-height: 1.5; }
  .ci-ver { color: var(--tinta); align-self: end; }

  .ci-vacio { --giro: -0.8deg; max-width: 720px; padding: clamp(1.4rem, 4vw, 2.2rem); }
  .ci-vacio-h { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 0.6rem; }
  .ci-vacio a { font-weight: 700; }
</style>
