---
/**
 * /colecciones/[coleccion] — Página dinámica SSG de Clústeres de Intención.
 *
 * Cada clúster es una página estática generada en build-time con su propio
 * H1, meta description y URL SEO-friendly. Las tarjetas reutilizan
 * TarjetaOferta.astro con el mismo sistema de scoring y diseño.
 *
 * La primera según el criterio de la colección (Sello K-P, ventas o
 * descuento: ver src/data/colecciones.js) va en grande, con su sello de «la
 * mejor de aquí»; el resto, en la Rejilla con filtro y orden.
 */
import Layout from '../../layouts/Layout.astro';
import TarjetaOferta from '../../components/TarjetaOferta.astro';
import Rejilla from '../../components/Rejilla.astro';
import Explorar from '../../components/Explorar.astro';
import { COLECCIONES_ACTIVAS } from '../../data/colecciones.js';
import SelloFrescura from '../../components/SelloFrescura.astro';
import { GENERADO_EL } from '../../data/secciones.js';

export function getStaticPaths() {
  return COLECCIONES_ACTIVAS.map(col => ({
    params: { coleccion: col.slug },
    props: { coleccion: col },
  }));
}

const { coleccion } = Astro.props;
const [ganador, ...resto] = coleccion.items; // la primera según el orden de la colección
// La Rejilla lee el score de score_seccion; aquí manda el de la colección.
const restoConScore = resto.map((o) => ({ ...o, score_seccion: o.score100 }));
---

<Layout
  title={`${coleccion.titulo} — KalidaPresio`}
  description={coleccion.descripcion}
>
  <article class="col hoja">
    <nav class="col-migas etiqueta" aria-label="Estás en">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span>
      <a href="/colecciones">Colecciones</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{coleccion.titulo}</span>
    </nav>

    <header class="col-cabeza">
      <h1 class="col-titulo">{coleccion.titulo}</h1>
      <p class="col-desc">{coleccion.descripcion}</p>
      <p class="col-cuenta etiqueta"><b>{coleccion.items.length} productos</b> · <SelloFrescura generadoEl={GENERADO_EL} /></p>
    </header>

    {ganador && (
      <section class="col-ganador" aria-labelledby="col-ganador-h">
        <h2 id="col-ganador-h" class="col-ganador-h sello sello--verde sello--doble anima-sellar">La mejor de aquí</h2>
        <TarjetaOferta oferta={ganador} score={ganador.score100} indice={0} variant="deal" campana={coleccion.slug} />
      </section>
    )}

    {restoConScore.length > 0 && (
      <section class="col-resto" aria-labelledby="col-resto-h">
        <h2 id="col-resto-h" class="col-h2">Las demás de la colección</h2>
        <Rejilla productos={restoConScore} campana={coleccion.slug} />
      </section>
    )}

    <Explorar excluir={`/colecciones/${coleccion.slug}`} titulo="Sigue explorando" />
  </article>
</Layout>

<style>
  .col { padding-block: clamp(1.2rem, 3vw, 2rem) 0; }
  .col-migas { margin-bottom: 1.2rem; }
  .col-migas a { color: inherit; }
  .col-cabeza { margin-bottom: clamp(2rem, 5vw, 3rem); }
  .col-titulo { font-size: clamp(2.6rem, 7.5vw, 5rem); text-transform: uppercase; margin-bottom: 0.9rem; }
  .col-desc { color: var(--tinta-2); max-width: 64ch; }
  .col-cuenta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin-top: 0.8rem; }
  .col-cuenta b { background: var(--fosfo); color: var(--tinta); padding: 0.1em 0.4em; }

  .col-ganador { max-width: 980px; }
  /* El sello va arriba a la izquierda, montado en el borde de la tarjeta: la
     esquina derecha es del moño de «destacado». */
  .col-ganador-h { position: relative; z-index: 3; margin: 0 0 -0.7rem 0.8rem; --giro: -4deg; font-size: clamp(1.1rem, 2.6vw, 1.5rem); }

  .col-resto { margin-top: clamp(3rem, 7vw, 4.5rem); }
  .col-h2 { font-size: clamp(2rem, 5vw, 3rem); text-transform: uppercase; margin-bottom: 1.4rem; }
</style>
