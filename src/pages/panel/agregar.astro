---
/**
 * /panel/agregar — Donde entra cada producto a la vitrina.
 *
 * ── QUÉ PROBLEMA RESUELVE ──────────────────────────────────────────────────
 * Un link de afiliado solo cobra si sale del generador de tu panel de Mercado
 * Libre, y ese paso no se puede automatizar (no hay API pública). Lo que sí se
 * puede es que todo lo demás cueste dos clics: el marcador lee la ficha del
 * producto en TU navegador, esta página arma la entrada, valida que el link
 * sea oficial y te da el archivo vitrina.json completo para pegarlo en GitHub.
 *
 * ── DÓNDE VIVEN LOS CAMBIOS ────────────────────────────────────────────────
 * Lo que agregas aquí se guarda en ESTE navegador (borrador) hasta que lo
 * subes. El sitio es estático: no hay base de datos que escribir, y eso es una
 * ventaja — cada cambio queda como un commit en GitHub, con historia.
 *
 * Va con `noindex`, fuera del sitemap y con Disallow en robots.txt. No lleva
 * secretos: solo productos que ya son públicos.
 */
import vitrinaCruda from '../../data/vitrina.json';
import ofertasCrudas from '../../data/ofertas.json';
import { claveProducto, urlProductoLimpia } from '../../utils/vitrina.js';
import { enlaceMarcador } from '../../utils/marcador.js';
import { CANALES } from '../../utils/canales.js';
import { repoDesdeUrlEditor } from '../../utils/publicarGithub.js';
import PanelApp from '../../components/PanelApp.astro';

const SITIO = String(Astro.site ?? 'https://kalidapresio.albis-labs.xyz').replace(/\/+$/, '');
const EDITAR_EN_GITHUB = import.meta.env.PUBLIC_EDITAR_VITRINA_URL
  || 'https://github.com/Arukado69/KalidaPresio/edit/main/src/data/vitrina.json';
const { repo: REPO, rama: RAMA } = repoDesdeUrlEditor(EDITAR_EN_GITHUB);

// Sugerencias: lo mejor del último escaneo que funcionó (ofertas.json). Sus
// precios son viejos: sirven para saber QUÉ abrir en Mercado Libre y para
// llenar lo que cambia poco (título, foto, calificación, id de artículo). El
// precio se escribe siempre a mano, el que se ve hoy.
const enVitrina = new Set(
  (vitrinaCruda.productos ?? []).map((p) => claveProducto(p?.url_producto)).filter(Boolean),
);
const listaOfertas = Array.isArray(ofertasCrudas) ? ofertasCrudas : (ofertasCrudas?.items ?? []);
const sugerencias = listaOfertas
  .map((o) => ({
    titulo: o.titulo,
    imagen: o.imagen,
    url: urlProductoLimpia(o.url_producto ?? o.link_afiliado),
    // El id de la tarjeta es el de ARTÍCULO: con él, el producto encuentra su histórico.
    id_articulo: o.id ?? null,
    rating: o.rating ?? null,
    vendidos: o.vendidos ?? null,
    envio_gratis: o.envio_gratis === true,
    precio_visto: o.precio_actual ?? null,
    score: o.score_kalidad_presio ?? 0,
  }))
  .filter((o) => o.url && !enVitrina.has(claveProducto(o.url)))
  .sort((a, b) => b.score - a.score)
  .slice(0, 24);
const escaneoDel = ofertasCrudas?.generadoEl
  ? new Date(ofertasCrudas.generadoEl).toLocaleDateString('es-MX', { day: 'numeric', month: 'long' })
  : null;

const marcador = enlaceMarcador(SITIO);
const canalesExtra = Object.entries(CANALES).filter(([c]) => c !== 'wb');

// Lo que el script del navegador necesita. `<` escapado: un título con
// «</script>» no puede cerrar la etiqueta antes de tiempo.
const datos = JSON.stringify({
  archivo: vitrinaCruda,
  editarEnGithub: EDITAR_EN_GITHUB,
  repo: REPO,
  rama: RAMA,
  // Para saber si lo último que publicaste desde aquí ya está en esta página.
  construidoEl: new Date().toISOString(),
  ideas: sugerencias,
  escaneoDel,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Agregar productos — KalidaPresio</title>
  <PanelApp />
  <!-- Global: parte del contenido se pinta desde el script (filas, consejos)
       y no lleva la marca de los estilos con alcance de Astro. -->
  <style is:global>
    :root {
      --fondo: #140b21; --panel: #1d1230; --panel-2: #241636; --linea: #342346;
      --tinta: #f0e8fa; --tinta-2: #a897be; --acento: #ff8a3d; --bien: #57c68e; --mal: #f0776c; --aviso: #f6d14f;
    }
    * { box-sizing: border-box; }
    /* `hidden` tiene que ganarle a cualquier display de clase (.btn, .campo…). */
    [hidden] { display: none !important; }
    body { margin: 0; background: var(--fondo); color: var(--tinta); font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; padding: 0 16px 120px; }
    .hoja { max-width: 820px; margin: 0 auto; }
    header { padding: 28px 0 16px; border-bottom: 1px solid var(--linea); }
    h1 { font-size: 1.5rem; margin: 0 0 4px; letter-spacing: -.02em; }
    h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .14em; color: var(--tinta-2); margin: 32px 0 12px; font-weight: 600; }
    .sub { color: var(--tinta-2); font-size: .9rem; margin: 0; }
    .nav { display: flex; gap: 14px; font-size: .85rem; margin-top: 10px; }
    .nav a { color: var(--acento); }
    .contadores { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
    .contador { background: var(--panel); border: 1px solid var(--linea); border-radius: 999px; padding: 4px 12px; font-size: .82rem; color: var(--tinta-2); }
    .contador b { color: var(--tinta); }
    .pegar { background: var(--panel); border: 1px solid var(--acento); border-radius: 12px; padding: 14px 16px; margin-top: 16px; }
    .pegar h2 { font-size: 1.05rem; margin: 0 0 6px; }
    .pegar-texto { width: 100%; margin: 10px 0 8px; background: var(--fondo); border: 1px solid var(--linea); color: var(--tinta); border-radius: 8px; padding: 10px 12px; font: inherit; font-size: .88rem; resize: vertical; }
    .pegar-texto:focus { outline: 2px solid var(--acento); outline-offset: 1px; }
    .pegar-acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
    .pegar-acciones input[type=date] { background: var(--fondo); border: 1px solid var(--linea); color: var(--tinta); border-radius: 6px; padding: 5px 8px; font: inherit; font-size: .82rem; }
    .pegar-auto { display: flex; gap: 8px; align-items: flex-start; margin: 10px 0 0; cursor: pointer; }
    .pegar-auto input { margin-top: 3px; accent-color: var(--acento); }
    .pegar-resultado { margin: 10px 0 0; padding: 8px 12px; border-radius: 8px; font-size: .88rem; background: rgba(87, 198, 142, .12); border: 1px solid var(--bien); }
    .pegar-resultado[data-tipo='error'] { background: rgba(240, 119, 108, .12); border-color: var(--mal); }
    .instalar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin: 0 0 12px; padding: 10px 12px; border-radius: 10px; background: rgba(255, 138, 61, .1); border: 1px dashed var(--acento); font-size: .88rem; }
    .instalar p { margin: 0; flex: 1 1 260px; }
    details.guia { background: var(--panel); border: 1px solid var(--linea); border-radius: 12px; padding: 14px 16px; margin-top: 16px; }
    details.guia summary { cursor: pointer; font-weight: 600; }
    .guia ol { padding-left: 20px; margin: 12px 0 0; color: var(--tinta-2); font-size: .92rem; }
    .guia li { margin-bottom: 8px; }
    .guia b { color: var(--tinta); }
    .marcador { display: inline-block; background: var(--acento); color: #23120a; font-weight: 700; padding: 8px 16px; border-radius: 8px; text-decoration: none; cursor: grab; margin: 4px 0; }
    form, .tarjeta { background: var(--panel); border: 1px solid var(--linea); border-radius: 12px; padding: 16px; }
    .campos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .campo { display: flex; flex-direction: column; gap: 4px; font-size: .82rem; color: var(--tinta-2); }
    .campo.ancho { grid-column: 1 / -1; }
    .campo input, .campo textarea { background: var(--fondo); border: 1px solid var(--linea); color: var(--tinta); border-radius: 8px; padding: 9px 11px; font: inherit; font-size: .92rem; width: 100%; }
    .campo input:focus, .campo textarea:focus { outline: 2px solid var(--acento); outline-offset: 1px; }
    .campo input[aria-invalid="true"] { border-color: var(--mal); }
    .ayuda { font-size: .76rem; color: var(--tinta-2); }
    .ayuda.mal { color: var(--mal); }
    .ayuda.bien { color: var(--bien); }
    .checks { display: flex; flex-wrap: wrap; gap: 16px; grid-column: 1 / -1; font-size: .88rem; }
    .checks label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
    details.extra { grid-column: 1 / -1; border-top: 1px dashed var(--linea); padding-top: 10px; }
    details.extra summary { cursor: pointer; font-size: .85rem; color: var(--tinta-2); }
    .acciones { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; align-items: center; }
    .btn { border: 1px solid var(--linea); background: var(--panel-2); color: var(--tinta); border-radius: 8px; padding: 9px 14px; font-size: .86rem; cursor: pointer; font-family: inherit; text-decoration: none; display: inline-block; }
    .btn-principal { background: var(--acento); border-color: var(--acento); color: #23120a; font-weight: 700; }
    .btn-peligro { color: var(--mal); }
    .btn:focus-visible { outline: 2px solid var(--acento); outline-offset: 2px; }
    .btn[data-hecho] { background: var(--bien); border-color: var(--bien); color: #06281a; }
    .error { color: var(--mal); font-size: .88rem; margin: 10px 0 0; }
    .lista { display: flex; flex-direction: column; gap: 10px; }
    .fila { display: grid; grid-template-columns: 64px 1fr; gap: 12px; background: var(--panel); border: 1px solid var(--linea); border-radius: 12px; padding: 12px; }
    .fila img, .fila .sin-foto { width: 64px; height: 64px; object-fit: contain; background: #fff; border-radius: 8px; }
    .fila .sin-foto { background: var(--panel-2); }
    .f-titulo { font-weight: 600; font-size: .92rem; margin: 0 0 4px; line-height: 1.35; }
    .f-codigo { display: inline-block; background: var(--acento); color: #23120a; font-weight: 800; font-size: .74rem; border-radius: 999px; padding: 1px 8px; margin-right: 4px; vertical-align: 1px; }
    .f-meta { font-size: .82rem; color: var(--tinta-2); margin: 0 0 6px; }
    .estado { display: inline-block; font-size: .74rem; border-radius: 999px; padding: 2px 9px; border: 1px solid currentColor; margin-right: 6px; }
    .estado.ok { color: var(--bien); } .estado.mal { color: var(--mal); } .estado.aviso { color: var(--aviso); } .estado.local { color: var(--acento); }
    .fila .acciones { margin-top: 8px; }
    .fila .btn { padding: 6px 10px; font-size: .8rem; }
    .vacio { color: var(--tinta-2); font-size: .9rem; }
    .subir { position: fixed; left: 0; right: 0; bottom: 0; background: var(--panel-2); border-top: 2px solid var(--acento); padding: 12px 16px; z-index: 10; }
    .subir-in { max-width: 820px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .subir p { margin: 0; flex: 1 1 100%; font-size: .84rem; }
    .subir .btn { padding: 8px 12px; font-size: .82rem; }
    .sugs { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
    .sug { background: var(--panel); border: 1px solid var(--linea); border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 8px; font-size: .82rem; }
    .sug img { width: 100%; height: 110px; object-fit: contain; background: #fff; border-radius: 6px; }
    .sug a { color: var(--acento); font-weight: 600; }
    .nota-ok { margin: 12px 0 0; padding: 10px 14px; border-radius: 10px; background: rgba(87, 198, 142, .12); border: 1px solid var(--bien); color: var(--tinta); font-size: .9rem; }
    .btn:disabled { opacity: .6; cursor: progress; }
    @media (max-width: 560px) { .campos { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="hoja">
    <header>
      <h1>Agregar productos a tu vitrina</h1>
      <p class="sub">Todo lo que publica KalidaPresio sale de aquí, y cada producto lleva <b>tu link oficial</b> de afiliado.</p>
      <div class="nav"><a href="/panel/hoy">→ Publicar en redes</a><a href="/hoy" target="_blank">→ Ver /hoy</a></div>
      <div class="contadores" data-contadores></div>
      <p class="nota-ok" data-nota role="status" hidden></p>
    </header>

    <!-- La forma rápida: lo que da «Compartir para ganar una comisión» en la
         app de Mercado Libre ya trae título, precio y tu link oficial. -->
    <section class="pegar" aria-labelledby="pegar-h">
      <h2 id="pegar-h">La forma rápida: pega lo que te da la app</h2>
      <div class="instalar" data-instalar hidden>
        <p><b>Aún más rápido en Android:</b> instala este panel como app y aparecerá en el menú «Compartir» de Mercado Libre. Compartes un producto y entra solo, sin copiar ni pegar.</p>
        <button class="btn btn-principal" type="button" data-instalar-boton>Instalar como app</button>
      </div>
      <p class="ayuda">
        En la app de Mercado Libre toca <b>«Compartir para ganar una comisión»</b> y copia el mensaje
        (o mándatelo por WhatsApp). Pega aquí uno o muchos, de una vez: cada uno trae el título, el precio y tu link.
      </p>
      <textarea class="pegar-texto" rows="5" data-pegar-texto placeholder="¡Mira lo que encontré! Playera Polo Hombre … - $ 99,59 en Mercado Libre. Entra aquí: https://meli.la/…"></textarea>
      <div class="pegar-acciones">
        <label class="ayuda">Los precios los viste el <input type="date" data-pegar-fecha /></label>
        <button class="btn" type="button" data-pegar-portapapeles>Pegar del portapapeles</button>
        <button class="btn btn-principal" type="button" data-pegar-agregar>Agregar a mi vitrina</button>
      </div>
      <label class="pegar-auto ayuda">
        <input type="checkbox" data-auto-publicar />
        <span><b>Publicar solo cada vez que agregas un producto</b> (desde la app, el marcador de la computadora o el formulario). Sin tocar «Publicar ahora»: en unos minutos está en el sitio. Usa tu token de GitHub (te lo pide la primera vez).</span>
      </label>
      <p class="pegar-resultado" data-pegar-resultado role="status" hidden></p>
      <p class="ayuda">Sin foto ni calificación el producto se publica igual (sale «sin calificar»). Puedes completarlo cuando quieras con el marcador: se reconoce por su link y no se duplica.</p>
    </section>

    <details class="guia" data-guia-android>
      <summary>En Android: comparte directo desde Mercado Libre, sin copiar ni pegar</summary>
      <ol>
        <li><b>Abre esta página en Chrome</b>, en tu celular.</li>
        <li><b>Instálala como app:</b> toca «Instalar como app» (arriba) o, en Chrome, el menú <b>⋮</b> → <b>«Instalar app»</b> (en algunos celulares dice «Agregar a la pantalla principal» → «Instalar»).</li>
        <li><b>En la app de Mercado Libre</b>, en un producto: <b>«Compartir para ganar una comisión»</b> → elige <b>KalidaPresio</b> en la lista. Si no la ves, búscala en «Más». Recién instalada puede tardar unos minutos en aparecer.</li>
        <li><b>Se abre este panel con el producto ya agregado:</b> título, precio de hoy y tu link. Regresa a Mercado Libre y repite con los que quieras.</li>
        <li>Al terminar, toca <b>«Publicar ahora»</b> (abajo). La foto y la calificación se pueden completar después, con el marcador.</li>
      </ol>
      <p class="ayuda">En iPhone no se puede: Apple no deja que una página web aparezca en «Compartir». Ahí copia el mensaje y pégalo arriba.</p>
    </details>

    <details class="guia" data-guia>
      <summary>En la computadora: el marcador (dos clics por producto)</summary>
      <ol>
        <li>
          <b>Instala el marcador una sola vez:</b> arrastra este botón a tu barra de marcadores
          (si no ves la barra: Ctrl/Cmd + Shift + B). <b>Si ya tenías uno, bórralo e instala este</b>: el de antes te pedía pegar el link.<br />
          <a class="marcador" href={marcador} title="Arrástrame a tu barra de marcadores">➕ Agregar a KalidaPresio</a>
          <br /><button class="btn" type="button" data-copiar-marcador>Copiar el código del marcador</button>
          <span class="ayuda">(si tu navegador no deja arrastrarlo: crea un marcador nuevo y pega el código como dirección)</span>
        </li>
        <li><b>En Mercado Libre, con tu sesión iniciada</b>, abre la página del producto.</li>
        <li><b>Toca «Compartir»</b> en la barra azul de afiliados (arriba de la página) y deja abierta la ventanita con tu link.</li>
        <li>
          <b>Toca el marcador.</b> El producto se guarda solo en esta pestaña del panel, con foto, precio, calificación y tu link
          (y se publica, si activaste «Publicar solo»). Regresa a Mercado Libre y sigue con el siguiente: el marcador usa siempre esta misma pestaña.
        </li>
      </ol>
      <p class="ayuda">
        Si la ventanita no muestra el link pero tú lo copiaste, el marcador lo toma de lo que copiaste (Chrome te pide permiso la primera vez)
        y te lo deja aquí para confirmarlo con «Guardar», por si era el del producto anterior. Un link que ya usa otro producto de tu vitrina nunca se guarda.
      </p>
      <p class="ayuda">Para separar las ventas por red: en tu panel de afiliados crea una etiqueta por canal (whatsapp, telegram, instagram…), genera el link con esa etiqueta y pégalo en «Links por canal».</p>
    </details>

    <details class="guia">
      <summary>Publicar sin copiar y pegar (una sola vez: tu token de GitHub)</summary>
      <ol>
        <li>Abre <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">GitHub → nuevo token «fine-grained»</a>. Se puede desde el celular.</li>
        <li><b>Repository access:</b> «Only select repositories» y elige solo <b>{REPO}</b>.</li>
        <li><b>Permissions → Repository permissions → Contents:</b> «Read and write». Nada más.</li>
        <li><b>Expiration:</b> 90 días está bien. Genera el token y cópialo.</li>
        <li>Aquí, toca <b>«Publicar ahora»</b> y pégalo cuando te lo pida. Se guarda solo en este navegador.</li>
      </ol>
      <p class="ayuda">
        Ese token solo puede escribir archivos de este repositorio, y el panel solo escribe <code>src/data/vitrina.json</code>.
        Si lo pierdes o alguien más lo ve, bórralo en GitHub y crea otro.
        <button class="btn" type="button" data-olvidar-token>Olvidar el token de este navegador</button>
      </p>
    </details>

    <h2 data-titulo-form>Producto</h2>
    <form data-form novalidate>
      <div class="campos">
        <label class="campo ancho">Link oficial de afiliado *
          <input name="link" type="url" inputmode="url" placeholder="https://meli.la/…" autocomplete="off" required />
          <span class="ayuda" data-ayuda-link>El link corto del generador: meli.la/… o mercadolibre.com/sec/… Pégalo sin editar.</span>
        </label>
        <label class="campo ancho">Título *
          <input name="titulo" type="text" required />
        </label>
        <label class="campo">Precio actual *
          <input name="precio" type="number" inputmode="decimal" min="1" step="any" required />
        </label>
        <label class="campo">Precio anterior (tachado)
          <input name="precio_antes" type="number" inputmode="decimal" min="0" step="any" />
        </label>
        <label class="campo ancho">URL del producto en Mercado Libre
          <input name="url_producto" type="url" placeholder="https://www.mercadolibre.com.mx/…/p/MLM…" />
        </label>
        <label class="campo ancho">ID del artículo en ML (lo llena el marcador)
          <input name="id_articulo" type="text" placeholder="MLM1932698151" autocomplete="off" spellcheck="false" />
          <span class="ayuda">Sirve para encontrar su histórico de precios. Si queda vacío, no pasa nada.</span>
        </label>
        <label class="campo ancho">Foto (URL de la imagen)
          <input name="imagen" type="url" placeholder="https://http2.mlstatic.com/…" />
        </label>
        <label class="campo">Calificación (0–5)
          <input name="rating" type="number" inputmode="decimal" min="0" max="5" step="0.1" />
        </label>
        <label class="campo">Unidades vendidas
          <input name="vendidos" type="number" inputmode="numeric" min="0" step="1" />
        </label>
        <div class="checks">
          <label><input name="envio_gratis" type="checkbox" /> Envío gratis</label>
          <label><input name="destacado" type="checkbox" /> Destacado (moño «Elegido» en su tarjeta)</label>
          <label><input name="relampago" type="checkbox" /> ⚡ Oferta relámpago</label>
        </div>
        <label class="campo ancho" data-campo-termina hidden>¿Cuándo termina la relámpago? (si no lo sabes, déjalo vacío: se retira sola a las 12 h)
          <input name="termina" type="datetime-local" />
        </label>
        <label class="campo ancho">Tu nota (por qué lo recomiendas; sale en el sitio y en las publicaciones)
          <textarea name="nota" rows="2" maxlength="160"></textarea>
        </label>
        <details class="extra">
          <summary>Links por canal (opcional, para separar ventas por red)</summary>
          <div class="campos" style="margin-top:10px">
            {canalesExtra.map(([codigo, nombre]) => (
              <label class="campo">{nombre}
                <input name={`enlace_${codigo}`} type="url" placeholder="https://meli.la/…" data-enlace-canal={codigo} />
              </label>
            ))}
          </div>
        </details>
      </div>
      <p class="error" data-error hidden></p>
      <div class="acciones">
        <button class="btn btn-principal" type="submit" data-guardar>Guardar en la lista</button>
        <button class="btn" type="button" data-limpiar>Limpiar</button>
        <span class="ayuda">Guardar marca el precio como «visto hoy».</span>
      </div>
    </form>

    <h2>Tu vitrina</h2>
    <div class="lista" data-lista></div>

    <section data-seccion-retirados hidden>
      <h2>Retirados</h2>
      <p class="sub" style="margin-bottom:12px">Ya no se publican, pero su página con el historial de precio sigue en línea.</p>
      <div class="lista" data-retirados></div>
    </section>

    {sugerencias.length > 0 && (
      <>
        <h2>Ideas para empezar</h2>
        <p class="sub" style="margin-bottom:12px">
          Lo mejor del último escaneo automático{escaneoDel ? ` (${escaneoDel})` : ''}. Toca <b>«Agregar esta»</b>: se llena el
          formulario y se abre la ficha en Mercado Libre. Ahí genera tu link, cópialo, vuelve aquí, pégalo y escribe el
          precio que ves hoy (el de entonces ya no vale).
        </p>
        <div class="sugs">
          {sugerencias.map((s, i) => (
            <div class="sug">
              {s.imagen && <img src={s.imagen} alt="" loading="lazy" />}
              <span>{s.titulo}</span>
              <button class="btn btn-principal" type="button" data-idea={i}>Agregar esta</button>
              <a href={s.url} target="_blank" rel="noopener noreferrer">Solo abrir en Mercado Libre →</a>
            </div>
          ))}
        </div>
      </>
    )}
  </div>

  <div class="subir" data-subir hidden>
    <div class="subir-in">
      <p data-subir-texto></p>
      <button class="btn btn-principal" type="button" data-publicar>Publicar ahora</button>
      <button class="btn" type="button" data-copiar-archivo>Copiar vitrina.json</button>
      <a class="btn" data-abrir-github target="_blank" rel="noopener noreferrer">Abrir en GitHub y pegar</a>
      <button class="btn btn-peligro" type="button" data-descartar>Descartar cambios</button>
    </div>
  </div>

  <script type="application/json" id="kp-datos" set:html={datos}></script>

  <script>
    import { normalizarProducto, esLinkOficial, claveProducto, urlProductoLimpia, idArticulo, DIAS_VIGENCIA_PRECIO } from '../../utils/vitrina.js';
    import { leerEnvioMarcador } from '../../utils/marcador.js';
    import { mezclarDelMarcador } from '../../utils/marcadorEntrada.js';
    import { publicarVitrina } from '../../utils/publicarGithub.js';
    import { asignarCodigos, formatoCodigo } from '../../utils/codigos.js';
    import { leerMensajesCompartidos, leerCompartido, traeLinkSinComision, mezclarCompartidos } from '../../utils/compartir.js';
    import { pesos } from '../../utils/pesos.js';
    import { anotarVisto, vistosValidos } from '../../utils/vistos.js';
    import { resumirHistorico, veredictoPrecio } from '../../utils/historico.js';

    const DATOS = JSON.parse(document.getElementById('kp-datos')?.textContent || '{}');
    const ARCHIVO = DATOS.archivo || { productos: [] };
    const CLAVE = 'kp-vitrina-borrador';
    const CLAVE_PUBLICADA = 'kp-vitrina-publicada';
    const CLAVE_TOKEN = 'kp-github-token';
    const $ = (s: string) => document.querySelector(s) as HTMLElement | null;

    const form = $('[data-form]') as HTMLFormElement;
    const campo = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    let editando: number | null = null;

    // ── La base: lo que ya está en GitHub ──────────────────────────────────
    // Recién publicado desde aquí, GitHub ya tiene lo nuevo pero esta página
    // se construyó con lo anterior. Hasta que el sitio se reconstruya, la base
    // es lo último que publicaste; si no, todo saldría «sin subir».
    function cargarBase(): any {
      try {
        const p = JSON.parse(localStorage.getItem(CLAVE_PUBLICADA) || 'null');
        if (p?.archivo && Number(p.cuando) > Date.parse(DATOS.construidoEl || '')) return p.archivo;
        localStorage.removeItem(CLAVE_PUBLICADA);
      } catch { /* sin almacenamiento: la base es la de la página */ }
      return ARCHIVO;
    }
    let BASE = cargarBase();

    // ── Borrador local ─────────────────────────────────────────────────────
    // Se guarda {productos, retirados, ultimo_codigo}. Un borrador de antes
    // (solo la lista de productos) se sigue leyendo, con los retirados de la base.
    function cargar(): { productos: any[]; retirados: any[]; ultimo: number | null } {
      const ultimoBase = BASE.ultimo_codigo ?? null;
      try {
        const b = JSON.parse(localStorage.getItem(CLAVE) || 'null');
        if (Array.isArray(b)) return { productos: b, retirados: structuredClone(BASE.retirados || []), ultimo: ultimoBase };
        if (b && Array.isArray(b.productos)) {
          return { productos: b.productos, retirados: Array.isArray(b.retirados) ? b.retirados : [], ultimo: b.ultimo_codigo ?? ultimoBase };
        }
      } catch { /* sin almacenamiento: se trabaja en memoria */ }
      return { productos: structuredClone(BASE.productos || []), retirados: structuredClone(BASE.retirados || []), ultimo: ultimoBase };
    }
    let { productos, retirados, ultimo } = cargar();

    // El código fijo («K-17») se pone al guardar y no cambia nunca: ver
    // src/utils/codigos.js. Así el que ves aquí es el que dirás en tus videos.
    function ponerCodigos() {
      const r = asignarCodigos({ productos, retirados, ultimo_codigo: ultimo });
      productos = r.productos;
      retirados = r.retirados;
      ultimo = r.ultimo_codigo;
    }
    ponerCodigos();

    const iguales = () => JSON.stringify(productos) === JSON.stringify(BASE.productos || [])
      && JSON.stringify(retirados) === JSON.stringify(BASE.retirados || [])
      && (ultimo ?? null) === (BASE.ultimo_codigo ?? null);
    function guardarBorrador() {
      ponerCodigos();
      try {
        if (iguales()) localStorage.removeItem(CLAVE);
        else localStorage.setItem(CLAVE, JSON.stringify({ productos, retirados, ultimo_codigo: ultimo }));
      } catch { /* modo privado: el borrador vive mientras la pestaña esté abierta */ }
    }
    const archivoCompleto = () => JSON.stringify(
      {
        _ayuda: ARCHIVO._ayuda,
        ...(ultimo ? { ultimo_codigo: ultimo } : {}),
        productos,
        ...(retirados.length ? { retirados } : {}),
      }, null, 2,
    ) + '\n';

    // ── Copiar (con respaldo para http y navegadores viejos) ──────────────
    function marcar(btn: HTMLElement, texto: string) {
      const original = btn.textContent;
      btn.textContent = texto;
      btn.setAttribute('data-hecho', '');
      setTimeout(() => { btn.textContent = original; btn.removeAttribute('data-hecho'); }, 1800);
    }
    async function copiar(btn: HTMLElement, texto: string) {
      try {
        await navigator.clipboard.writeText(texto);
        marcar(btn, '✓ Copiado');
      } catch {
        const ta = document.createElement('textarea');
        ta.value = texto;
        ta.style.cssText = 'position:fixed;inset:10% 5%;z-index:99;background:#1d1230;color:#f0e8fa;border:1px solid #ff8a3d;border-radius:10px;padding:12px';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        if (ok) { ta.remove(); marcar(btn, '✓ Copiado'); }
        else { ta.addEventListener('blur', () => ta.remove()); marcar(btn, 'Copia a mano ↑'); }
      }
    }

    // ── Pintar ──────────────────────────────────────────────────────────────
    const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    const yaSubidos = () => new Set([...(BASE.productos || []), ...(BASE.retirados || [])].map((p: any) => JSON.stringify(p)));
    let enArchivo = yaSubidos();

    function avisar(texto: string) {
      const nota = $('[data-nota]')!;
      nota.textContent = texto;
      nota.hidden = false;
      nota.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // ── Publicar sin copiar y pegar ────────────────────────────────────────
    // El token vive solo en este navegador. Ver «Publicar sin copiar y pegar»
    // en la página y src/utils/publicarGithub.js.
    const leerToken = () => { try { return localStorage.getItem(CLAVE_TOKEN) || ''; } catch { return ''; } };
    const olvidarToken = () => { try { localStorage.removeItem(CLAVE_TOKEN); } catch { /* nada que olvidar */ } };
    function pedirToken(): string {
      const t = (prompt('Pega tu token de GitHub (fine-grained, solo de este repositorio, con Contents de lectura y escritura). Se guarda solo en este navegador. Si no tienes uno, abre «Publicar sin copiar y pegar» arriba.') || '').trim();
      if (t) { try { localStorage.setItem(CLAVE_TOKEN, t); } catch { /* sin almacenamiento: sirve solo esta vez */ } }
      return t;
    }
    /**
     * Sube la vitrina del panel a GitHub. Lo usan el botón «Publicar ahora»
     * (que pregunta ante un conflicto) y la publicación sola al compartir (que
     * no pregunta: si algo no cuadra, no publica y lo dice).
     */
    async function subirVitrina(token: string, preguntar: boolean) {
      const contenido = archivoCompleto();
      const publicables = productos.filter((p) => !('motivo' in normalizarProducto(p, Date.now()))).length;
      const opciones = {
        token, contenido, base: BASE, repo: DATOS.repo, rama: DATOS.rama,
        mensaje: `vitrina: ${publicables} producto(s) publicable(s), desde el panel`,
      };
      let r: any = await publicarVitrina(opciones);
      if (!r.ok && r.motivo === 'conflicto' && preguntar) {
        if (!confirm('La vitrina en GitHub cambió desde la última vez que la viste aquí (¿la editaste desde otro lado?). ¿Reemplazarla con la de este panel?')) return { ...r, cancelado: true, publicables };
        r = await publicarVitrina({ ...opciones, forzar: true });
      }
      if (r.ok) {
        BASE = JSON.parse(contenido);
        try { localStorage.setItem(CLAVE_PUBLICADA, JSON.stringify({ archivo: BASE, cuando: Date.now() })); } catch { /* la base vive mientras la pestaña esté abierta */ }
        enArchivo = yaSubidos();
        guardarBorrador();
        pintar();
      } else if (r.motivo === 'token') {
        olvidarToken();
      }
      return { ...r, publicables };
    }

    async function publicarAhora(btn: HTMLButtonElement) {
      const token = leerToken() || pedirToken();
      if (!token) return;
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Publicando…';
      try {
        const r: any = await subirVitrina(token, true);
        if (r.cancelado) return;
        if (r.ok) {
          avisar(r.sinCambios
            ? 'GitHub ya tenía esta misma vitrina: no hacía falta publicar nada.'
            : `✓ Publicado: ${r.publicables} producto(s) publicable(s). El sitio se reconstruye solo; en unos minutos lo verás en línea.`);
        } else if (r.motivo === 'token') {
          alert(`GitHub no aceptó el token (${r.detalle}). Revisa que sea de este repositorio y tenga Contents de lectura y escritura; al volver a tocar «Publicar ahora» te pedirá uno nuevo.`);
        } else {
          alert(`No se pudo publicar: ${r.detalle}. Tus cambios siguen guardados en este navegador; inténtalo otra vez o usa «Copiar vitrina.json» + «Abrir en GitHub y pegar».`);
        }
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    }

    // ── Publicar solo al compartir (opcional) ─────────────────────────────
    const CLAVE_AUTO = 'kp-auto-publicar';
    const autoPublicar = () => { try { return localStorage.getItem(CLAVE_AUTO) === '1'; } catch { return false; } };

    // Una publicación a la vez: si agregas otro mientras se publica el
    // anterior, se publica una vez más al terminar (con todo junto). Dos
    // escrituras al mismo tiempo chocarían en GitHub.
    let publicandoSolo = false;
    let otraVez: string | null = null;
    /**
     * Publica sola si la opción está activa y hay token. Devuelve si lo hará.
     * `dicho` es el mensaje del producto: se completa con el resultado.
     */
    function publicarSiToca(dicho = ''): boolean {
      const token = leerToken();
      if (!autoPublicar() || !token) return false;
      if (publicandoSolo) { otraVez = dicho; return true; }
      publicandoSolo = true;
      subirVitrina(token, false).then((r: any) => {
        publicandoSolo = false;
        const siguiente = otraVez;
        otraVez = null;
        if (r.ok) {
          if (dicho && siguiente === null) decirPegar(`${dicho} ✓ Publicado: en unos minutos está en el sitio.`, 'ok');
        } else {
          const motivo = r.motivo === 'conflicto' ? 'la vitrina cambió en GitHub' : r.motivo === 'token' ? 'GitHub no aceptó tu token' : r.detalle;
          decirPegar(`${dicho ? `${dicho} ` : ''}No se pudo publicar solo (${motivo}). Quedó guardado aquí: toca «Publicar ahora».`, 'error');
          return;
        }
        if (siguiente !== null) publicarSiToca(siguiente);
      });
      return true;
    }

    function pintar() {
      const ahora = Date.now();
      const lista = $('[data-lista]')!;
      let ok = 0, mal = 0;
      lista.innerHTML = productos.length ? productos.map((p, i) => {
        const r: any = normalizarProducto(p, ahora);
        const dias = p.revisado ? Math.floor((ahora - Date.parse(p.revisado)) / 86_400_000) : null;
        let estado = '';
        if (r.motivo) { mal++; estado = `<span class="estado mal">✗ ${esc(r.motivo)}</span>`; }
        else {
          ok++;
          estado = `<span class="estado ok">✓ Publicable</span>`;
          if (r.producto.oferta_relampago) estado += `<span class="estado aviso">⚡ hasta ${esc(new Date(r.producto.caduca).toLocaleString('es-MX', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }))}</span>`;
          if (dias !== null && dias >= DIAS_VIGENCIA_PRECIO - 2) estado += `<span class="estado aviso">precio de hace ${dias} días</span>`;
        }
        if (!enArchivo.has(JSON.stringify(p))) estado += `<span class="estado local">sin subir</span>`;
        const img = p.imagen ? `<img src="${esc(p.imagen)}" alt="" loading="lazy">` : '<div class="sin-foto"></div>';
        const ml = urlProductoLimpia(p.url_producto);
        return `<article class="fila">${img}<div>`
          + `<p class="f-titulo">${p.codigo ? `<span class="f-codigo" title="Código fijo: el que dices en historias y videos">${esc(formatoCodigo(p.codigo))}</span> ` : ''}${esc(p.titulo || '(sin título)')}</p>`
          + `<p class="f-meta">${p.precio ? pesos(Number(p.precio)) : 'sin precio'}${p.precio_antes ? ` · antes ${pesos(Number(p.precio_antes))}` : ''}${p.revisado ? ` · visto el ${esc(new Date(p.revisado).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }))}` : ''}</p>`
          + `<div>${estado}</div>`
          + `<div class="acciones">`
          + `<button class="btn" type="button" data-editar="${i}">Editar</button>`
          + (r.motivo ? '' : `<button class="btn" type="button" data-revisado="${i}" title="Abriste la ficha y el precio sigue igual">Ya revisé: sigue igual</button>`)
          + (ml ? `<a class="btn" href="${esc(ml)}" target="_blank" rel="noopener noreferrer">Abrir en ML</a>` : '')
          + `<button class="btn btn-peligro" type="button" data-quitar="${i}">Quitar</button>`
          + `</div></div></article>`;
      }).join('') : '<p class="vacio">Tu vitrina está vacía. Agrega el primer producto con el marcador o con el formulario de arriba.</p>';

      // Retirados: ya no se publican, pero su página (con el historial) sigue.
      ($('[data-seccion-retirados]') as HTMLElement).hidden = retirados.length === 0;
      $('[data-retirados]')!.innerHTML = retirados.map((p, i) => {
        const r: any = normalizarProducto(p, ahora, { exigirVigencia: false });
        const slug = r.producto?.slug;
        const cuando = p.retirado ? new Date(p.retirado).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }) : '';
        const img = p.imagen ? `<img src="${esc(p.imagen)}" alt="" loading="lazy">` : '<div class="sin-foto"></div>';
        return `<article class="fila">${img}<div>`
          + `<p class="f-titulo">${p.codigo ? `<span class="f-codigo">${esc(formatoCodigo(p.codigo))}</span> ` : ''}${esc(p.titulo || '(sin título)')}</p>`
          + `<p class="f-meta">Retirado${cuando ? ` el ${esc(cuando)}` : ''} · su página sigue en línea${p.codigo ? ` (y /k/${esc(String(p.codigo))} lleva a ella)` : ''}</p>`
          + (enArchivo.has(JSON.stringify(p)) ? '' : '<div><span class="estado local">sin subir</span></div>')
          + `<div class="acciones">`
          + (slug ? `<a class="btn" href="/p/${esc(slug)}" target="_blank" rel="noopener">Ver su página</a>` : '')
          + `<button class="btn" type="button" data-reactivar="${i}">Volver a la vitrina</button>`
          + `<button class="btn btn-peligro" type="button" data-borrar="${i}">Borrar del todo</button>`
          + `</div></div></article>`;
      }).join('');

      const cambios = !iguales();
      $('[data-contadores]')!.innerHTML =
        `<span class="contador"><b>${ok}</b> publicables</span>`
        + (mal ? `<span class="contador"><b>${mal}</b> con algo que arreglar</span>` : '')
        + (retirados.length ? `<span class="contador"><b>${retirados.length}</b> retirados</span>` : '')
        + (cambios ? `<span class="contador"><b>cambios sin subir</b></span>` : '');
      const barra = $('[data-subir]')!;
      barra.hidden = !cambios;
      $('[data-subir-texto]')!.textContent = 'Cambios sin subir. «Publicar ahora» los sube a GitHub con tu token; si no tienes uno, cópialos y pégalos en GitHub reemplazando todo. El sitio se actualiza en unos minutos.';
      (document.querySelector('[data-guia]') as HTMLDetailsElement).open = ok === 0;
    }

    // ── Formulario ─────────────────────────────────────────────────────────
    function aLocal(iso?: string) {
      if (!iso) return '';
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return '';
      const p = (n: number) => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
    }
    /** Las pistas de una idea (el precio de entonces) no deben quedarse en otro producto. */
    function limpiarPistas() {
      campo('precio').placeholder = '';
    }
    function llenar(p: any) {
      form.reset();
      limpiarPistas();
      for (const n of ['link', 'titulo', 'precio', 'precio_antes', 'url_producto', 'id_articulo', 'imagen', 'rating', 'vendidos', 'nota']) {
        if (p[n] !== undefined && p[n] !== null) campo(n).value = String(p[n]);
      }
      campo('envio_gratis').checked = p.envio_gratis === true;
      campo('destacado').checked = Boolean(p.destacado);
      campo('relampago').checked = p.relampago === true;
      campo('termina').value = aLocal(p.termina);
      for (const el of Array.from(form.querySelectorAll('[data-enlace-canal]')) as HTMLInputElement[]) {
        el.value = p.enlaces?.[el.dataset.enlaceCanal as string] ?? '';
      }
      alternarTermina();
      validarLink();
    }
    function leer(): any {
      const n = (v: string) => (v.trim() === '' ? undefined : Number(v));
      const t = (v: string) => (v.trim() === '' ? undefined : v.trim());
      const previo = editando !== null ? productos[editando] : {};
      const entrada: any = {
        link: campo('link').value.trim(),
        titulo: t(campo('titulo').value),
        precio: n(campo('precio').value),
        precio_antes: n(campo('precio_antes').value),
        revisado: new Date().toISOString(),
        imagen: t(campo('imagen').value),
        url_producto: urlProductoLimpia(campo('url_producto').value) ?? t(campo('url_producto').value),
        // Se lee de la URL ANTES de limpiarla: el artículo viaja en wid=/item_id.
        id_articulo: t(campo('id_articulo').value)?.toUpperCase() ?? idArticulo(campo('url_producto').value) ?? undefined,
        rating: n(campo('rating').value),
        vendidos: n(campo('vendidos').value),
        envio_gratis: campo('envio_gratis').checked || undefined,
        relampago: campo('relampago').checked || undefined,
        termina: campo('relampago').checked && campo('termina').value ? new Date(campo('termina').value).toISOString() : undefined,
        // Conserva la etiqueta de texto si ya la tenía («Más vendido»).
        destacado: campo('destacado').checked ? (typeof previo?.destacado === 'string' ? previo.destacado : true) : undefined,
        nota: t(campo('nota').value),
      };
      const enlaces: Record<string, string> = {};
      for (const el of Array.from(form.querySelectorAll('[data-enlace-canal]')) as HTMLInputElement[]) {
        if (el.value.trim()) enlaces[el.dataset.enlaceCanal as string] = el.value.trim();
      }
      if (Object.keys(enlaces).length) entrada.enlaces = enlaces;
      // Fuera los campos vacíos: el archivo queda legible para quien lo abra.
      for (const k of Object.keys(entrada)) if (entrada[k] === undefined) delete entrada[k];
      return entrada;
    }
    function validarLink() {
      const v = campo('link').value.trim();
      const ayuda = $('[data-ayuda-link]')!;
      if (!v) { ayuda.className = 'ayuda'; ayuda.textContent = 'El link corto del generador: meli.la/… o mercadolibre.com/sec/… Pégalo sin editar.'; campo('link').removeAttribute('aria-invalid'); return; }
      const ok = esLinkOficial(v);
      campo('link').setAttribute('aria-invalid', String(!ok));
      ayuda.className = ok ? 'ayuda bien' : 'ayuda mal';
      ayuda.textContent = ok
        ? '✓ Link oficial'
        : /matt_tool|matt_word/.test(v)
          ? '✗ Ese es un link armado a mano (matt_tool/matt_word): no genera comisión. Usa el link corto del generador.'
          : '✗ No es un link corto oficial. Debe empezar con https://meli.la/ o https://mercadolibre.com/sec/';
    }
    function alternarTermina() {
      ($('[data-campo-termina]') as HTMLElement).hidden = !campo('relampago').checked;
    }
    function editar(i: number | null) {
      editando = i;
      $('[data-titulo-form]')!.textContent = i === null ? 'Producto' : 'Editando producto';
      ($('[data-guardar]') as HTMLElement).textContent = i === null ? 'Guardar en la lista' : 'Guardar cambios';
    }

    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'link') validarLink();
      if (t.name === 'relampago') alternarTermina();
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const entrada = leer();
      const r: any = normalizarProducto(entrada, Date.now());
      const error = $('[data-error]')!;
      if (r.motivo) { error.textContent = `No se puede guardar: ${r.motivo}.`; error.hidden = false; return; }
      error.hidden = true;
      // Mismo producto ya en la lista → se actualiza en vez de duplicarlo.
      const clave = claveProducto(entrada.url_producto);
      // Se reconoce por la ficha de Mercado Libre o, si no la tenía (lo pegaste
      // desde la app), por su link oficial: completarlo no lo duplica.
      const porLink = (l: string) => productos.findIndex((p) => String(p.link ?? '').trim() === String(l ?? '').trim());
      let otro = editando ?? (clave ? productos.findIndex((p) => claveProducto(p.url_producto) === clave) : -1);
      if (otro === -1 && entrada.link) otro = porLink(entrada.link);
      // El código es del producto, no del formulario: editar no lo cambia, y
      // un producto retirado que vuelve recupera el suyo.
      const retiradoPrevio = clave ? retirados.find((x) => claveProducto(x.url_producto) === clave) : null;
      const codigoPrevio = (otro !== null && otro >= 0 ? productos[otro]?.codigo : null) ?? retiradoPrevio?.codigo;
      if (codigoPrevio) entrada.codigo = codigoPrevio;
      // Guardar marca el precio como visto hoy: se suma a su historial, no lo pisa.
      entrada.vistos = anotarVisto((otro !== null && otro >= 0 ? productos[otro] : null) ?? retiradoPrevio, entrada.precio, entrada.revisado);
      if (otro !== null && otro >= 0) productos[otro] = entrada;
      else productos.unshift(entrada);
      // Si estaba retirado, vuelve: no puede estar en las dos listas.
      if (clave) retirados = retirados.filter((x) => claveProducto(x.url_producto) !== clave);
      guardarBorrador();
      if (publicarSiToca(`✓ Guardado: «${recortar(String(entrada.titulo ?? ''), 70)}».`)) decirPegar(`✓ Guardado: «${recortar(String(entrada.titulo ?? ''), 70)}». Publicando…`, 'ok');
      form.reset();
      editar(null);
      validarLink();
      alternarTermina();
      pintar();
      $('[data-lista]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    $('[data-limpiar]')!.addEventListener('click', () => { form.reset(); limpiarPistas(); editar(null); validarLink(); alternarTermina(); });

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const ed = t.closest('[data-editar]');
      if (ed) {
        const i = Number(ed.getAttribute('data-editar'));
        llenar(productos[i]);
        editar(i);
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      const rev = t.closest('[data-revisado]');
      if (rev) {
        const i = Number(rev.getAttribute('data-revisado'));
        const ahora = new Date().toISOString();
        // «Sigue igual» también es un precio visto hoy: va a su historial.
        productos[i] = { ...productos[i], revisado: ahora, vistos: anotarVisto(productos[i], productos[i].precio, ahora) };
        guardarBorrador();
        pintar();
        return;
      }
      const q = t.closest('[data-quitar]');
      if (q) {
        const i = Number(q.getAttribute('data-quitar'));
        const p = productos[i];
        if (!p) return;
        // Con link oficial ya tuvo página: se retira y la página se queda con su
        // historial. Un borrador sin link nunca se publicó: se borra y ya.
        const conPagina = esLinkOficial(p.link);
        const pregunta = conPagina
          ? `¿Retirar «${p.titulo ?? 'este producto'}» de la vitrina? Deja de publicarse, pero su página con el historial de precio sigue en línea (para Google y para quien ya la compartió). Puedes borrarla del todo en «Retirados».`
          : `¿Quitar «${p.titulo ?? 'este producto'}» de la vitrina?`;
        if (confirm(pregunta)) {
          productos.splice(i, 1);
          if (conPagina) retirados.unshift({ ...p, retirado: new Date().toISOString() });
          // Los índices se corren: cualquier edición abierta se cierra.
          if (editando !== null) { form.reset(); editar(null); }
          guardarBorrador();
          pintar();
        }
        return;
      }
      const vuelve = t.closest('[data-reactivar]');
      if (vuelve) {
        const i = Number(vuelve.getAttribute('data-reactivar'));
        const { retirado, ...p } = retirados[i] ?? {};
        if (!p.link) return;
        retirados.splice(i, 1);
        productos.unshift(p);
        guardarBorrador();
        pintar();
        return;
      }
      const borrar = t.closest('[data-borrar]');
      if (borrar) {
        const i = Number(borrar.getAttribute('data-borrar'));
        if (confirm(`¿Borrar del todo «${retirados[i]?.titulo ?? 'este producto'}»? Su página deja de existir: quien tenga el enlace verá «no encontrado».`)) {
          retirados.splice(i, 1);
          guardarBorrador();
          pintar();
        }
        return;
      }
      const idea = t.closest('[data-idea]');
      if (idea) {
        const s = (DATOS.ideas || [])[Number(idea.getAttribute('data-idea'))];
        if (!s) return;
        // Se llena lo que cambia poco. El precio NO: el de la idea es de otro
        // día, y publicarlo como «visto hoy» sería mentir. Va como pista.
        llenar({
          titulo: s.titulo, imagen: s.imagen, url_producto: s.url, id_articulo: s.id_articulo,
          rating: s.rating, vendidos: s.vendidos, envio_gratis: s.envio_gratis,
        });
        editar(null);
        if (s.precio_visto) {
          campo('precio').placeholder = `era ${pesos(s.precio_visto)}${DATOS.escaneoDel ? ` el ${DATOS.escaneoDel}` : ''}: ¿y hoy?`;
        }
        window.open(s.url, '_blank', 'noopener');
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      const pub = t.closest('[data-publicar]') as HTMLButtonElement | null;
      if (pub) { if (!pub.disabled) publicarAhora(pub); return; }
      if (t.closest('[data-olvidar-token]')) {
        olvidarToken();
        marcar(t.closest('[data-olvidar-token]') as HTMLElement, '✓ Olvidado');
        return;
      }
      if (t.closest('[data-copiar-archivo]')) { copiar(t.closest('[data-copiar-archivo]') as HTMLElement, archivoCompleto()); return; }
      if (t.closest('[data-copiar-marcador]')) {
        copiar(t.closest('[data-copiar-marcador]') as HTMLElement, (document.querySelector('.marcador') as HTMLAnchorElement).getAttribute('href') || '');
        return;
      }
      if (t.closest('[data-descartar]') && confirm('¿Descartar todos los cambios que no has subido?')) {
        productos = structuredClone(BASE.productos || []);
        retirados = structuredClone(BASE.retirados || []);
        ultimo = BASE.ultimo_codigo ?? null;
        guardarBorrador();
        form.reset();
        editar(null);
        pintar();
      }
    });
    ($('[data-abrir-github]') as HTMLAnchorElement).href = DATOS.editarEnGithub;
    // Un clic en el marcador desde ESTA página no hace nada útil: avisarlo.
    $('.marcador')!.addEventListener('click', (e) => { e.preventDefault(); alert('Arrástrame a tu barra de marcadores y úsame en la página de un producto de Mercado Libre.'); });

    // ── Pegar lo que da «Compartir para ganar una comisión» ────────────────
    const fechaPegar = $('[data-pegar-fecha]') as HTMLInputElement;
    const hoyLocal = () => {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    };
    fechaPegar.value = hoyLocal();
    fechaPegar.max = hoyLocal();
    const resultadoPegar = $('[data-pegar-resultado]') as HTMLElement;
    const decirPegar = (texto: string, tipo: 'ok' | 'error') => {
      resultadoPegar.textContent = texto;
      resultadoPegar.dataset.tipo = tipo;
      resultadoPegar.hidden = false;
    };
    /** El instante de «revisado»: ahora si es hoy; si elegiste otro día, ese día a mediodía. */
    function revisadoPegado(): string {
      const v = fechaPegar.value;
      if (!v || v >= hoyLocal()) return new Date().toISOString();
      return new Date(`${v}T12:00:00`).toISOString();
    }
    $('[data-pegar-portapapeles]')!.addEventListener('click', async () => {
      try {
        const t = await navigator.clipboard.readText();
        const caja = $('[data-pegar-texto]') as HTMLTextAreaElement;
        caja.value = caja.value ? `${caja.value}\n${t}` : t;
      } catch {
        decirPegar('Tu navegador no dejó leer el portapapeles: mantén presionado el cuadro y elige «Pegar».', 'error');
      }
    });
    const SIN_COMISION = 'Ese link es del «Compartir» normal y no lleva tu comisión. En la app de Mercado Libre usa «Compartir para ganar una comisión».';
    const recortar = (t: string, n: number) => (t.length > n ? `${t.slice(0, n - 1).trimEnd()}…` : t);

    /**
     * Agrega a la vitrina lo leído (pegado o compartido) y dice qué pasó.
     * Devuelve lo que dijo, sin el «qué sigue», para poder completarlo cuando
     * se publica solo.
     */
    function agregarLeidos(leidos: ReturnType<typeof leerMensajesCompartidos>, compartido = false, seguira = ''): string {
      const r = mezclarCompartidos(productos, leidos, revisadoPegado());
      productos = r.productos;
      if (editando !== null) { form.reset(); editar(null); }
      guardarBorrador();
      pintar();

      // Llegó uno solo desde «Compartir»: se dice cuál, con su código.
      if (compartido && leidos.length === 1) {
        const p = productos.find((x) => String(x?.link ?? '').trim() === leidos[0].link);
        if (!p?.titulo || !p?.precio) {
          const dicho = '✓ Llegó tu link, pero sin título o precio: complétalo en tu lista con «Editar».';
          decirPegar(`${dicho} Después toca «Publicar ahora».`, 'ok');
          return dicho;
        }
        const codigo = p.codigo ? ` (${formatoCodigo(p.codigo)})` : '';
        // Si ya lo habías visto otro día, cómo cambió: lo mismo que dirá el sitio.
        const v = veredictoPrecio(p.precio, resumirHistorico(vistosValidos(p.vistos)));
        const cambio = v.dias >= 2 && v.texto ? ` ${v.texto}.` : '';
        const dicho = `✓ ${r.nuevos ? 'Agregado' : 'Actualizado'}: «${recortar(p.titulo, 70)}» a ${pesos(p.precio)}${codigo}.${cambio}`;
        decirPegar(`${dicho} ${seguira || 'Regresa a Mercado Libre y comparte el siguiente, o toca «Publicar ahora» cuando termines.'}`, 'ok');
        return dicho;
      }

      const partes = [];
      if (r.nuevos) partes.push(`${r.nuevos} nuevo${r.nuevos === 1 ? '' : 's'}`);
      if (r.actualizados) partes.push(`${r.actualizados} actualizado${r.actualizados === 1 ? '' : 's'}`);
      const dicho = `✓ ${partes.join(' y ')}.`
        + (r.incompletos ? ` ${r.incompletos} sin título o precio: complétalo${r.incompletos === 1 ? '' : 's'} en la lista con «Editar».` : '');
      decirPegar(`${dicho} ${seguira || 'Cuando termines, toca «Publicar ahora» abajo.'}`, 'ok');
      return dicho;
    }

    $('[data-pegar-agregar]')!.addEventListener('click', () => {
      const caja = $('[data-pegar-texto]') as HTMLTextAreaElement;
      const leidos = leerMensajesCompartidos(caja.value);
      if (!leidos.length) {
        decirPegar(
          traeLinkSinComision(caja.value)
            ? SIN_COMISION
            : 'No encontré ningún link oficial (https://meli.la/… o mercadolibre.com/sec/…). Copia el mensaje completo que te da «Compartir para ganar una comisión».',
          'error',
        );
        return;
      }
      const auto = autoPublicar() && Boolean(leerToken());
      const dicho = agregarLeidos(leidos, false, auto ? 'Publicando…' : '');
      if (auto) publicarSiToca(dicho);
      caja.value = '';
      $('[data-lista]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // ── Lo que llega del menú «Compartir» del celular ──────────────────────
    // El panel instalado como app recibe ?titulo=&texto=&enlace= (ver
    // public/panel/manifest.json). Se lee una vez y se limpia la dirección,
    // para que recargar no lo vuelva a agregar.
    const recibido = new URLSearchParams(location.search);
    if (['titulo', 'texto', 'enlace'].some((k) => recibido.has(k))) {
      const partes = { titulo: recibido.get('titulo'), texto: recibido.get('texto'), enlace: recibido.get('enlace') };
      history.replaceState(null, '', location.pathname);
      const leidos = leerCompartido(partes);
      if (leidos.length) {
        const auto = autoPublicar() && Boolean(leerToken());
        const dicho = agregarLeidos(leidos, true, auto ? 'Publicando…' : '');
        if (auto) publicarSiToca(dicho);
      } else {
        // No traía tu link: se deja a la vista lo que llegó, para que se entienda por qué.
        const caja = $('[data-pegar-texto]') as HTMLTextAreaElement;
        caja.value = [partes.titulo, partes.texto, partes.enlace].filter(Boolean).join('\n');
        decirPegar(
          traeLinkSinComision(caja.value)
            ? SIN_COMISION
            : 'Lo que compartiste no trae un link de afiliado (meli.la/… o mercadolibre.com/sec/…). Arriba está lo que llegó.',
          'error',
        );
      }
      resultadoPegar.scrollIntoView({ block: 'center' });
    }

    const casillaAuto = $('[data-auto-publicar]') as HTMLInputElement;
    casillaAuto.checked = autoPublicar() && Boolean(leerToken());
    casillaAuto.addEventListener('change', () => {
      if (casillaAuto.checked && !(leerToken() || pedirToken())) casillaAuto.checked = false;
      try { localStorage.setItem(CLAVE_AUTO, casillaAuto.checked ? '1' : '0'); } catch { /* sin almacenamiento no se recuerda */ }
    });

    // ── Instalar como app (Chrome en Android y en computadora) ─────────────
    // Chrome avisa que se puede instalar con «beforeinstallprompt»; dentro de
    // la app ya instalada no tiene caso ofrecerlo.
    const cajaInstalar = $('[data-instalar]') as HTMLElement;
    const enLaApp = matchMedia('(display-mode: standalone)').matches;
    let pedirInstalar: any = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      pedirInstalar = e;
      cajaInstalar.hidden = enLaApp;
    });
    $('[data-instalar-boton]')!.addEventListener('click', async () => {
      if (!pedirInstalar) return;
      pedirInstalar.prompt();
      const { outcome } = await pedirInstalar.userChoice;
      pedirInstalar = null;
      if (outcome === 'accepted') cajaInstalar.hidden = true;
    });
    window.addEventListener('appinstalled', () => {
      cajaInstalar.hidden = true;
      avisar('✓ Listo: el panel ya está en tu celular. En la app de Mercado Libre toca «Compartir para ganar una comisión» y elige KalidaPresio.');
    });

    // ── Lo que manda el marcador (computadora) ─────────────────────────────
    // Completo y con el link de la ventanita «Compartir» de esa página: se
    // guarda solo (y se publica, si activaste «Publicar solo»). Si no, o si el
    // link pudo ser de otro producto, se abre el formulario para revisarlo
    // (ver src/utils/marcadorEntrada.js). El marcador abre siempre la MISMA
    // pestaña, así que cada producto nuevo llega como cambio de #.
    function procesarMarcador(enviado: any) {
      history.replaceState(null, '', location.pathname);
      const r: any = mezclarDelMarcador(productos, enviado, new Date().toISOString());
      if (r.estado === 'agregado' || r.estado === 'actualizado') {
        productos = r.productos;
        if (editando !== null) { form.reset(); editar(null); }
        guardarBorrador();
        pintar();
        const p = productos.find((x) => String(x?.link ?? '').trim() === r.producto.link) ?? r.producto;
        const codigo = p.codigo ? ` (${formatoCodigo(p.codigo)})` : '';
        const v = veredictoPrecio(p.precio, resumirHistorico(vistosValidos(p.vistos)));
        const cambio = v.dias >= 2 && v.texto ? ` ${v.texto}.` : '';
        const dicho = `✓ ${r.estado === 'agregado' ? 'Agregado' : 'Actualizado'} desde Mercado Libre: «${recortar(p.titulo, 70)}» a ${pesos(p.precio)}${codigo}.${cambio}`;
        const auto = publicarSiToca(dicho);
        decirPegar(`${dicho} ${auto ? 'Publicando…' : 'Sigue con el siguiente producto, o toca «Publicar ahora» cuando termines.'}`, 'ok');
        resultadoPegar.scrollIntoView({ block: 'center' });
        return;
      }

      // Al formulario, como antes: para revisarlo y tocar «Guardar».
      const clave = claveProducto(enviado.url_producto);
      let i = clave ? productos.findIndex((p) => claveProducto(p.url_producto) === clave) : -1;
      // Un producto que pegaste desde la app no tiene ficha: se reconoce por el link.
      if (i < 0 && enviado.link && r.estado !== 'link-ajeno') i = productos.findIndex((p) => String(p.link ?? '').trim() === String(enviado.link).trim());
      const recibido = { ...enviado };
      delete recibido.link_origen;
      if (r.estado === 'link-ajeno') recibido.link = '';
      if (i >= 0) {
        // Ya estaba: se actualiza el precio y se conserva lo tuyo (link, nota,
        // links por canal) si el marcador no trajo uno nuevo.
        const actual = productos[i];
        llenar({ ...actual, ...Object.fromEntries(Object.entries(recibido).filter(([, v]) => v !== '' && v !== null && v !== undefined)), link: recibido.link || actual.link, nota: actual.nota, enlaces: actual.enlaces, destacado: actual.destacado });
        editar(i);
      } else {
        llenar(recibido);
        editar(null);
      }
      const error = $('[data-error]')!;
      if (r.estado === 'link-ajeno') {
        error.textContent = `Ese link ya es de «${recortar(String(r.ajeno?.titulo ?? 'otro producto'), 60)}». Abre «Compartir» en la barra de afiliados de ESTE producto, copia su link y pégalo aquí.`;
        error.hidden = false;
      } else if (r.motivo === 'confirmar-link') {
        error.textContent = 'Revisa que el link sea de este producto (lo tomé de lo que copiaste) y toca «Guardar en la lista».';
        error.hidden = false;
      }
      form.scrollIntoView({ block: 'start' });
      if (!campo('link').value) campo('link').focus();
    }
    const enviado = leerEnvioMarcador(location.hash);
    if (enviado) procesarMarcador(enviado);
    window.addEventListener('hashchange', () => {
      const otro = leerEnvioMarcador(location.hash);
      if (otro) procesarMarcador(otro);
    });

    pintar();
  </script>
</body>
</html>
