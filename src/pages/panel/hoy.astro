---
/**
 * /panel/hoy — El centro de publicación: tu vitrina, lista para cada red.
 *
 * ── QUÉ PROBLEMA RESUELVE ──────────────────────────────────────────────────
 * Publicar a diario en cinco redes solo se sostiene si cada publicación sale
 * en dos toques. Aquí eliges la red arriba y cada producto te da el texto ya
 * escrito en el formato de esa red, con TU link oficial (el de la etiqueta de
 * ese canal si lo generaste) y la imagen del tamaño correcto: 4:5 para el feed,
 * 9:16 para estados, historias y TikTok.
 *
 * Arriba está el «paquete relámpago»: un solo mensaje con lo mejor del día,
 * para soltarlo de una vez en un canal o grupo.
 *
 * ── LO QUE NO HACE, A PROPÓSITO ────────────────────────────────────────────
 * No publica por ti. Repartir a mano es lo que te obliga a mirar lo que
 * publicas, y es la diferencia entre participar en una comunidad y ser el que
 * la llena de enlaces hasta que lo expulsan. (Telegram sí puede ir solo: ver
 * n8n/telegram-tecnologia.json.)
 *
 * Va con `noindex`, fuera del sitemap y con Disallow en robots.txt.
 */
import historicoCrudo from '../../data/historico-precios.json';
import { VITRINA } from '../../data/ofertas.js';
import { ordenParaPublicar } from '../../utils/vitrina.js';
import { entradasPara, resumirHistorico, veredictoPrecio, NIVELES_NO_DISTRIBUIBLES } from '../../utils/historico.js';
import { FORMATOS, HORARIOS_SUGERIDOS } from '../../utils/publicacion.js';

const SITIO = String(Astro.site ?? 'https://kalidapresio.albis-labs.xyz').replace(/\/+$/, '');
const productosHist = historicoCrudo?.productos ?? {};

// El MISMO orden y numeración que /hoy y feed.json.
const ordenados = ordenParaPublicar(VITRINA).map((p, i) => {
  const v = veredictoPrecio(p.precio_actual, resumirHistorico(entradasPara(productosHist, p.claves_historico ?? p.id)), { descuento: p.descuento });
  return { ...p, numero: i + 1, nivel: v.nivel, veredicto: v.texto };
});

// El corte que da la credibilidad: 'alto' = ha estado más barato; el
// descuento es contra un precio inflado. Repartirlo es prestarle nuestra
// credibilidad a la mentira. NIVELES_NO_DISTRIBUIBLES es la fuente única.
const publicables = ordenados.filter((p) => !NIVELES_NO_DISTRIBUIBLES.includes(p.nivel));
const noPublicar = ordenados.filter((p) => NIVELES_NO_DISTRIBUIBLES.includes(p.nivel));

const fecha = new Date().toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Mexico_City' });
const datos = JSON.stringify({ sitio: SITIO, productos: publicables }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Publicar hoy — KalidaPresio</title>
  <link rel="icon" href="/favicon.svg" />
  <!-- Global: parte del contenido se pinta desde el script (filas, consejos)
       y no lleva la marca de los estilos con alcance de Astro. -->
  <style is:global>
    :root {
      --fondo: #140b21; --panel: #1d1230; --panel-2: #241636; --linea: #342346;
      --tinta: #f0e8fa; --tinta-2: #a897be; --acento: #ff8a3d; --bien: #57c68e; --mal: #f0776c; --aviso: #f6d14f;
      /* Mismo valor que --color-error en src/styles/global.css. */
      --color-error: #ff5d76;
    }
    * { box-sizing: border-box; }
    /* `hidden` tiene que ganarle a cualquier display de clase (.btn, .campo…). */
    [hidden] { display: none !important; }
    body { margin: 0; background: var(--fondo); color: var(--tinta); font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; padding: 0 16px 80px; }
    .hoja { max-width: 820px; margin: 0 auto; }
    header { padding: 28px 0 16px; border-bottom: 1px solid var(--linea); }
    h1 { font-size: 1.5rem; margin: 0 0 4px; letter-spacing: -.02em; }
    .sub { color: var(--tinta-2); font-size: .9rem; margin: 0; }
    .nav { display: flex; gap: 14px; font-size: .85rem; margin-top: 10px; flex-wrap: wrap; }
    .nav a { color: var(--acento); }
    .barra { position: sticky; top: 0; z-index: 5; background: var(--fondo); padding: 12px 0; border-bottom: 1px solid var(--linea); }
    .barra-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; color: var(--tinta-2); display: block; margin-bottom: 8px; }
    .chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
    .chip { border: 1px solid var(--linea); background: var(--panel); color: var(--tinta-2); border-radius: 999px; padding: 7px 14px; font-size: .82rem; cursor: pointer; font-family: inherit; white-space: nowrap; }
    .chip[aria-pressed="true"] { background: var(--acento); border-color: var(--acento); color: #23120a; font-weight: 600; }
    .chip:focus-visible, .btn:focus-visible { outline: 2px solid var(--acento); outline-offset: 2px; }
    .consejo { font-size: .84rem; color: var(--tinta-2); margin: 10px 0 0; }
    .consejo b { color: var(--tinta); }
    h2 { font-size: .78rem; text-transform: uppercase; letter-spacing: .14em; color: var(--tinta-2); margin: 28px 0 12px; font-weight: 600; }
    .cuenta { color: var(--acento); }
    .caja { background: var(--panel); border: 1px solid var(--linea); border-radius: 12px; padding: 14px; }
    .caja pre { white-space: pre-wrap; word-break: break-word; font: .84rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; margin: 0 0 10px; max-height: 260px; overflow: auto; color: var(--tinta); }
    .horarios { display: flex; flex-direction: column; gap: 6px; font-size: .86rem; }
    .horarios span b { color: var(--acento); font-variant-numeric: tabular-nums; margin-right: 8px; }
    .tarjeta { display: grid; grid-template-columns: 84px 1fr; gap: 14px; background: var(--panel); border: 1px solid var(--linea); border-radius: 12px; padding: 14px; margin-bottom: 10px; }
    .media { position: relative; }
    .media img { width: 84px; height: 84px; object-fit: contain; background: #fff; border-radius: 8px; display: block; }
    .numero { position: absolute; top: -8px; left: -8px; background: var(--acento); color: #23120a; font-weight: 800; font-size: .78rem; border-radius: 999px; padding: 2px 8px; }
    .t-titulo { font-size: .93rem; font-weight: 600; margin: 0 0 6px; line-height: 1.35; }
    .t-meta { font-size: .82rem; color: var(--tinta-2); margin: 0 0 6px; }
    .t-precio { color: var(--tinta); font-weight: 600; }
    .etiquetas { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .etiqueta { font-size: .72rem; border-radius: 999px; padding: 2px 9px; border: 1px solid currentColor; }
    .e-relampago { color: var(--aviso); } .e-destacado { color: var(--bien); } .e-veredicto { color: var(--tinta-2); }
    .acciones { display: flex; gap: 8px; flex-wrap: wrap; }
    .btn { border: 1px solid var(--linea); background: var(--panel-2); color: var(--tinta); border-radius: 8px; padding: 8px 13px; font-size: .82rem; cursor: pointer; font-family: inherit; text-decoration: none; display: inline-block; }
    .btn-principal { background: var(--acento); border-color: var(--acento); color: #23120a; font-weight: 600; }
    .btn[data-hecho] { background: var(--bien); border-color: var(--bien); color: #06281a; }
    .idea { margin-top: 10px; font-size: .82rem; color: var(--tinta-2); white-space: pre-line; border-left: 3px solid var(--acento); padding-left: 10px; }
    .aviso { border-left: 3px solid var(--mal); background: var(--panel); padding: 12px 16px; border-radius: 0 8px 8px 0; margin: 12px 0 16px; font-size: .88rem; color: var(--tinta-2); }
    .aviso b { color: var(--tinta); }
    .n-alto { color: var(--mal); } .n-descuento-falso { color: var(--color-error); font-weight: 600; }
    .vacio { color: var(--tinta-2); font-size: .9rem; }
    .vacio a { color: var(--acento); }
    footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--linea); font-size: .8rem; color: var(--tinta-2); }
    footer li { margin-bottom: 6px; }
    @media (max-width: 520px) { .tarjeta { grid-template-columns: 64px 1fr; } .media img { width: 64px; height: 64px; } }
  </style>
</head>
<body>
  <div class="hoja">
    <header>
      <h1>Publicar hoy</h1>
      <p class="sub">{fecha} · <span data-cuenta>{publicables.length}</span> productos listos · cada texto lleva tu link oficial del canal que elijas</p>
      <div class="nav"><a href="/panel/agregar">→ Agregar productos</a><a href="/hoy" target="_blank">→ Ver /hoy (tu «link en bio»)</a></div>
    </header>

    <div class="barra" role="group" aria-label="Red donde vas a publicar">
      <span class="barra-label">¿Dónde vas a publicar?</span>
      <div class="chips">
        {FORMATOS.map((f, i) => (
          <button class="chip" type="button" data-formato={f.id} aria-pressed={i === 0 ? 'true' : 'false'} title={f.detalle}>{f.nombre}</button>
        ))}
      </div>
      <p class="consejo" data-consejo></p>
    </div>

    {publicables.length === 0 ? (
      <p class="vacio" style="margin-top:28px">
        Todavía no hay productos publicables. <a href="/panel/agregar">Agrega el primero</a> con tu link oficial.
      </p>
    ) : (
      <>
        <h2>⚡ Paquete relámpago <span class="cuenta">(un solo mensaje con lo mejor de hoy)</span></h2>
        <div class="caja">
          <pre data-paquete></pre>
          <button class="btn btn-principal" type="button" data-copiar-paquete>Copiar paquete</button>
        </div>

        <h2>Horario sugerido</h2>
        <div class="caja horarios">
          {HORARIOS_SUGERIDOS.slice(0, publicables.length).map((hora, i) => (
            <span><b>{hora}</b>#{publicables[i].numero} {publicables[i].titulo}</span>
          ))}
          <span class="consejo" style="margin:6px 0 0">Una a la vez, repartidas: la ventana para que una compra cuente después del clic es corta, así que varias publicaciones a lo largo del día rinden más que un bloque.</span>
        </div>

        <h2>Uno por uno <span class="cuenta">({publicables.length})</span></h2>
        <div data-lista>
          {publicables.map((p) => (
            <article class="tarjeta" data-id={p.id} data-caduca={p.caduca ?? ''}>
              <div class="media">
                {p.imagen ? <img src={p.imagen} alt="" loading="lazy" width="84" height="84" /> : <div></div>}
                <span class="numero">#{p.numero}</span>
              </div>
              <div>
                <p class="t-titulo">{p.titulo}</p>
                <p class="t-meta">
                  <span class="t-precio">${Math.round(p.precio_actual).toLocaleString('es-MX')}</span>
                  {p.precio_previo ? ` · antes $${Math.round(p.precio_previo).toLocaleString('es-MX')} (−${p.descuento}%)` : ''}
                  {p.score_kalidad_presio ? ` · K-P ${p.score_kalidad_presio}` : ''}
                </p>
                <div class="etiquetas">
                  {p.oferta_relampago && <span class="etiqueta e-relampago" data-fin-texto>⚡ relámpago</span>}
                  {p.destacado && <span class="etiqueta e-destacado">{p.destacado}</span>}
                  {p.veredicto && <span class="etiqueta e-veredicto">{p.veredicto}</span>}
                </div>
                <div class="acciones">
                  <button class="btn btn-principal" type="button" data-copiar-texto={p.id}>Copiar texto</button>
                  <button class="btn" type="button" data-copiar-link={p.id}>Solo el link</button>
                  <a class="btn" data-imagen={p.id} href={`/promos/${p.id}.jpg`} download={`kalidapresio-${p.numero}.jpg`}>Descargar imagen</a>
                  <button class="btn" type="button" data-idea={p.id} hidden>Idea de video</button>
                </div>
                <p class="idea" data-idea-texto={p.id} hidden></p>
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    {noPublicar.length > 0 && (
      <>
        <h2>No publicar hoy <span class="cuenta">({noPublicar.length})</span></h2>
        <p class="aviso">
          El histórico dice que estas han estado <b>más baratas</b> hace poco, o que el descuento que anuncian
          es <b>directamente falso</b>. Publicarlas es lo que hacen los otros canales de ofertas — y no hacerlo
          es la razón por la que alguien seguiría el tuyo.
        </p>
        {noPublicar.map((p) => (
          <article class="tarjeta">
            <div class="media">{p.imagen ? <img src={p.imagen} alt="" loading="lazy" width="84" height="84" /> : <div></div>}</div>
            <div>
              <p class="t-titulo">{p.titulo}</p>
              <p class={`t-meta n-${p.nivel}`}>{p.veredicto}</p>
            </div>
          </article>
        ))}
      </>
    )}

    <footer>
      <ul>
        <li><b>Siempre di que es enlace de afiliado.</b> Los textos ya lo incluyen: no lo borres.</li>
        <li><b>Grupos ajenos:</b> lee sus reglas antes. Casi todos prohíben enlaces de afiliado; ahí aporta sin link y lleva a la gente a tu canal.</li>
        <li><b>Para separar ventas por red:</b> crea una etiqueta por canal en tu panel de afiliados y pega esos links en «Links por canal» al agregar el producto.</li>
        <li>Los precios son los que viste al agregar el producto. Si pasó más de un día, ábrelo en Mercado Libre antes de publicar.</li>
      </ul>
    </footer>
  </div>

  <script type="application/json" id="kp-datos" set:html={datos}></script>

  <script>
    import { FORMATOS, textoProducto, textoPaquete, ideaVideo } from '../../utils/publicacion.js';
    import { enlacePara } from '../../utils/vitrina.js';

    const DATOS = JSON.parse(document.getElementById('kp-datos')?.textContent || '{}');
    const SITIO: string = DATOS.sitio || '';
    const CLAVE = 'kp-panel-formato';

    // Las relámpago que ya terminaron no se ofrecen, aunque la página sea de antes.
    const ahora = Date.now();
    const vivos = (DATOS.productos || []).filter((p: any) => !p.caduca || Date.parse(p.caduca) > ahora);
    document.querySelectorAll('[data-caduca]').forEach((el) => {
      const c = el.getAttribute('data-caduca');
      if (c && Date.parse(c) <= ahora) (el as HTMLElement).hidden = true;
    });
    const cuenta = document.querySelector('[data-cuenta]');
    if (cuenta) cuenta.textContent = String(vivos.length);
    const porId = new Map(vivos.map((p: any) => [p.id, p]));

    const CONSEJOS: Record<string, string> = {
      wa: '<b>WhatsApp:</b> los *asteriscos* salen en negritas. En tu canal, una publicación cada pocas horas; en grupos ajenos, solo si las reglas lo permiten.',
      estado: '<b>Estado:</b> sube la imagen vertical y pega el texto encima. El link sí se puede tocar en los estados.',
      tg: '<b>Telegram:</b> los **dobles asteriscos** salen en negritas al enviar. Si tienes el bot de n8n, no publiques aquí lo mismo a mano.',
      fb: '<b>Facebook:</b> pega el texto y espera a que cargue la vista previa del link antes de publicar. En grupos, revisa sus reglas.',
      ig: '<b>Instagram no deja links en el texto.</b> Pon en tu perfil: <code data-bio></code> <button class="btn" type="button" data-copiar-bio>Copiar</button> y di el número del producto.',
      tt: '<b>TikTok no deja links en el texto.</b> Pon en tu perfil: <code data-bio></code> <button class="btn" type="button" data-copiar-bio>Copiar</button> y di el número en el video.',
      pn: '<b>Pinterest:</b> crea un pin con la imagen 4:5, el título y pega el link en «Destino».',
      cr: '<b>Correo:</b> la primera línea es el asunto.',
    };

    let formato = 'wa';
    try {
      const guardado = localStorage.getItem(CLAVE);
      if (guardado && FORMATOS.some((f) => f.id === guardado)) formato = guardado;
    } catch { /* sin almacenamiento */ }

    const fmt = () => FORMATOS.find((f) => f.id === formato) ?? FORMATOS[0];
    const bio = () => `${SITIO}/hoy?c=${fmt().canal}`;

    function pintar() {
      const f = fmt();
      document.querySelectorAll('[data-formato]').forEach((c) => c.setAttribute('aria-pressed', String(c.getAttribute('data-formato') === f.id)));
      const consejo = document.querySelector('[data-consejo]') as HTMLElement | null;
      if (consejo) {
        consejo.innerHTML = CONSEJOS[f.id] ?? '';
        const code = consejo.querySelector('[data-bio]');
        if (code) code.textContent = bio();
      }
      const paquete = document.querySelector('[data-paquete]');
      if (paquete) paquete.textContent = textoPaquete(f.id, vivos, { sitio: SITIO });
      const sinLink = f.id === 'ig' || f.id === 'tt';
      document.querySelectorAll('[data-copiar-link]').forEach((b) => ((b as HTMLElement).hidden = sinLink));
      document.querySelectorAll('[data-idea]').forEach((b) => ((b as HTMLElement).hidden = !sinLink));
      if (!sinLink) document.querySelectorAll('[data-idea-texto]').forEach((b) => ((b as HTMLElement).hidden = true));
      document.querySelectorAll('[data-imagen]').forEach((a) => {
        const id = a.getAttribute('data-imagen');
        const historia = f.imagen === 'historia';
        a.setAttribute('href', `/promos/${id}${historia ? '-historia' : ''}.jpg`);
        a.textContent = historia ? 'Imagen vertical (9:16)' : 'Imagen (4:5)';
      });
    }

    function marcar(btn: HTMLElement, texto: string) {
      const original = btn.textContent;
      btn.textContent = texto;
      btn.setAttribute('data-hecho', '');
      setTimeout(() => { btn.textContent = original; btn.removeAttribute('data-hecho'); }, 1600);
    }
    // Copiado con respaldo: navigator.clipboard no existe fuera de HTTPS, y
    // este panel se usa desde el teléfono, que es donde más falta hace.
    async function copiar(btn: HTMLElement, texto: string) {
      try {
        await navigator.clipboard.writeText(texto);
        marcar(btn, '✓ Copiado');
      } catch {
        const ta = document.createElement('textarea');
        ta.value = texto;
        ta.setAttribute('readonly', '');
        ta.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:min(92vw,520px);height:40vh;z-index:99;padding:12px;border-radius:10px;border:1px solid #ff8a3d;background:#1d1230;color:#f0e8fa;font:14px/1.5 system-ui';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        if (ok) { ta.remove(); marcar(btn, '✓ Copiado'); }
        else { ta.addEventListener('blur', () => ta.remove()); marcar(btn, 'Copia a mano ↑'); }
      }
    }

    document.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const chip = t.closest('[data-formato]');
      if (chip) {
        formato = chip.getAttribute('data-formato') || 'wa';
        try { localStorage.setItem(CLAVE, formato); } catch { /* sin almacenamiento */ }
        pintar();
        return;
      }
      const btnTexto = t.closest('[data-copiar-texto]') as HTMLElement | null;
      if (btnTexto) {
        const p = porId.get(btnTexto.getAttribute('data-copiar-texto'));
        if (p) copiar(btnTexto, textoProducto(formato, p, { numero: (p as any).numero, sitio: SITIO }));
        return;
      }
      const btnLink = t.closest('[data-copiar-link]') as HTMLElement | null;
      if (btnLink) {
        const p = porId.get(btnLink.getAttribute('data-copiar-link'));
        if (p) copiar(btnLink, enlacePara(p as any, fmt().canal));
        return;
      }
      const btnIdea = t.closest('[data-idea]') as HTMLElement | null;
      if (btnIdea) {
        const id = btnIdea.getAttribute('data-idea');
        const p: any = porId.get(id);
        const caja = document.querySelector(`[data-idea-texto="${id}"]`) as HTMLElement | null;
        if (p && caja) { caja.textContent = ideaVideo(p, p.numero); caja.hidden = !caja.hidden; }
        return;
      }
      const btnPaquete = t.closest('[data-copiar-paquete]') as HTMLElement | null;
      if (btnPaquete) { copiar(btnPaquete, textoPaquete(formato, vivos, { sitio: SITIO })); return; }
      const btnBio = t.closest('[data-copiar-bio]') as HTMLElement | null;
      if (btnBio) copiar(btnBio, bio());
    });

    pintar();
  </script>
</body>
</html>
