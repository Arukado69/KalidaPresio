---
/**
 * /contacto — El formulario de contacto, en una hoja para llenar a mano.
 *
 * Envía por fetch a /api/contact (backend Express). Los ganchos data-c-* son
 * los que lee el script de abajo; el honeypot frena a los bots.
 */
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contacto — KalidaPresio"
  description="¿Encontraste un error, quieres proponer un producto para que lo revisemos o eres prensa? Escríbenos."
  ogType="website"
>
  <div class="ct hoja">
    <header class="ct-cabeza">
      <p class="etiqueta">Contacto · respondemos en 48 a 72 horas hábiles</p>
      <h1 class="ct-titulo">Escríbenos</h1>
      <p class="ct-sub">¿Encontraste un error, un precio que ya cambió o tienes una sugerencia? Lo revisamos.</p>
    </header>

    <div class="ct-grid">
      <!-- Sin action ni recarga: el envío es por fetch a /api/contact -->
      <form class="ct-hoja" data-contacto novalidate>
        <div class="ct-campo">
          <label for="nombre">Nombre</label>
          <input type="text" id="nombre" placeholder="Tu nombre" required autocomplete="name" data-c-nombre />
        </div>

        <div class="ct-campo">
          <label for="email">Correo electrónico</label>
          <input type="email" id="email" placeholder="tu@correo.com" required autocomplete="email" data-c-email />
        </div>

        <div class="ct-campo">
          <label for="asunto">Asunto</label>
          <select id="asunto" data-c-asunto>
            <option value="Corrección técnica">Corrección técnica</option>
            <option value="Proponer producto para análisis">Proponer un producto</option>
            <option value="Colaboración / Prensa">Colaboración o prensa</option>
            <option value="Otro">Otro</option>
          </select>
        </div>

        <div class="ct-campo">
          <label for="mensaje">Mensaje</label>
          <textarea id="mensaje" placeholder="Cuéntanos con el mayor detalle posible…" rows="6" required data-c-mensaje></textarea>
        </div>

        <!-- Honeypot anti-bots (oculto para humanos) -->
        <div class="c-hp" aria-hidden="true">
          <label>No llenar<input type="text" name="company" tabindex="-1" autocomplete="off" data-c-hp /></label>
        </div>

        <button type="submit" class="boton boton--tinta ct-enviar" data-c-submit>
          <span class="c-submit-txt">Enviar mensaje</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>

        <p class="c-status" data-c-status role="status" aria-live="polite" hidden></p>
        <p class="c-legal">Tratamos tu mensaje conforme a nuestro <a href="/privacidad">aviso de privacidad</a>.</p>
      </form>

      <aside class="ct-antes cartulina cartulina--rosa con-cinta" aria-labelledby="ct-antes-h">
        <h2 id="ct-antes-h" class="ct-antes-h">Antes de escribir</h2>
        <ul>
          <li>No aceptamos reseñas pagadas ni menciones a cambio de dinero.</li>
          <li>Si viste un error en especificaciones, incluye la fuente del fabricante.</li>
          <li>Para proponer un producto, pega el enlace de Mercado Libre.</li>
          <li>¿Un precio que ya cambió? Dinos cuál y lo revisamos.</li>
        </ul>
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      function bind() {
        document.querySelectorAll('[data-contacto]:not([data-c-bound])').forEach((form) => {
          form.setAttribute('data-c-bound', '');
          const nombre = form.querySelector('[data-c-nombre]');
          const email = form.querySelector('[data-c-email]');
          const asunto = form.querySelector('[data-c-asunto]');
          const mensaje = form.querySelector('[data-c-mensaje]');
          const hp = form.querySelector('[data-c-hp]');
          const btn = form.querySelector('[data-c-submit]');
          const txt = form.querySelector('.c-submit-txt');
          const status = form.querySelector('[data-c-status]');
          const setStatus = (m, t) => { status.textContent = m; status.hidden = !m; status.dataset.tipo = t || ''; };
          const emailOk = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test((v || '').trim());

          async function enviar(e) {
            e.preventDefault();
            if (!nombre.value.trim() || !emailOk(email.value) || mensaje.value.trim().length < 5) {
              setStatus('Revisa los campos: nombre, correo válido y un mensaje de al menos 5 caracteres.', 'error');
              return;
            }
            btn.disabled = true; txt.textContent = 'Enviando…'; setStatus('', '');
            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  nombre: nombre.value.trim(),
                  email: email.value.trim(),
                  mensaje: `[${asunto.value}] ${mensaje.value.trim()}`,
                  honeypot: hp ? hp.value : '',
                }),
              });
              const data = await res.json().catch(() => ({}));
              if (res.ok && data.ok) {
                setStatus('¡Gracias! Recibimos tu mensaje y te responderemos pronto.', 'ok');
                document.dispatchEvent(new CustomEvent('kp:evento', {
                  detail: { nombre: 'contacto-enviado', datos: { asunto: asunto.value } },
                }));
                form.reset(); txt.textContent = 'Enviado ✓';
              } else {
                setStatus('No pudimos enviar tu mensaje. Intenta de nuevo en un momento.', 'error');
                txt.textContent = 'Enviar mensaje'; btn.disabled = false;
              }
            } catch {
              setStatus('Hubo un problema de conexión. Intenta de nuevo.', 'error');
              txt.textContent = 'Enviar mensaje'; btn.disabled = false;
            }
          }
          form.addEventListener('submit', enviar);
        });
      }
      if (document.readyState !== 'loading') bind();
      else document.addEventListener('DOMContentLoaded', bind);
    })();
  </script>
</Layout>

<style>
  .ct { padding-block: clamp(1.5rem, 4vw, 2.5rem) 0; }
  .ct-cabeza { margin-bottom: clamp(2rem, 5vw, 3rem); }
  .ct-titulo { font-size: clamp(3.2rem, 10vw, 6.6rem); text-transform: uppercase; margin: 0.6rem 0 0.8rem; }
  .ct-sub { color: var(--tinta-2); max-width: 56ch; }

  .ct-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }

  /* La hoja: renglones de cuaderno detrás, campos de formulario impreso. */
  .ct-hoja {
    position: relative;
    display: grid;
    gap: 1.3rem;
    padding: clamp(1.4rem, 4vw, 2.4rem);
    background-color: var(--cartulina);
    background-image: linear-gradient(transparent calc(2.2rem - 1px), rgba(29, 64, 184, 0.1) calc(2.2rem - 1px));
    background-size: 100% 2.2rem;
    border: 2px solid var(--tinta);
    box-shadow: 6px 6px 0 var(--tinta);
  }
  .ct-campo { display: grid; gap: 0.35rem; }
  .ct-campo label { font: 600 0.72rem/1.4 var(--f-ticket); letter-spacing: 0.08em; text-transform: uppercase; }
  .ct-campo input,
  .ct-campo select,
  .ct-campo textarea {
    width: 100%;
    font: 400 1.05rem/1.5 var(--f-texto);
    color: var(--tinta);
    background: rgba(255, 252, 244, 0.9);
    border: 2px solid var(--tinta);
    border-radius: 2px;
    padding: 0.7rem 0.85rem;
  }
  .ct-campo textarea { resize: vertical; min-height: 9rem; }
  .ct-campo input:focus,
  .ct-campo select:focus,
  .ct-campo textarea:focus { outline: none; background: #fffde0; box-shadow: 4px 4px 0 var(--fosfo); }
  .ct-enviar { justify-self: start; }
  .ct-enviar:disabled { opacity: 0.6; cursor: wait; }

  /* Honeypot oculto + estados del formulario */
  .c-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .c-status { margin: 0; padding: 0.7rem 0.9rem; font-weight: 700; border: 2px solid currentColor; }
  .c-status[data-tipo='ok'] { color: var(--sello-verde); }
  .c-status[data-tipo='error'] { color: var(--sello-rojo); }
  .c-legal { margin: 0; font-size: 0.82rem; color: var(--tinta-2); }
  .c-legal a { font-weight: 700; }

  .ct-antes { --giro: 1.6deg; padding: 1.6rem 1.4rem 1.4rem; }
  .ct-antes-h { font-size: 1.9rem; text-transform: uppercase; margin-bottom: 0.8rem; }
  .ct-antes ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.6rem; }
  .ct-antes li::marker { content: "✗  "; font-weight: 700; }
  .ct-antes li:nth-child(n + 2)::marker { content: "→  "; }

  @media (max-width: 860px) {
    .ct-grid { grid-template-columns: 1fr; }
  }
</style>
