---
/**
 * /ofertas/<seccion> — Una página por sección de la vitrina.
 *
 * POR QUÉ PÁGINAS Y NO MÁS BLOQUES EN LA PORTADA: páginas separadas dan
 * contenido propio que Google puede indexar, una etiqueta de sección distinta
 * en la analítica (data-kp-seccion) para saber cuál genera clics, y un filtro
 * y orden propios (los trae la Rejilla).
 *
 * Relámpago no tiene página: tiene hora de fin, y una página estática la
 * seguiría mostrando hasta el próximo build. Para eso está la fila relámpago de
 * la portada, que la retira en el navegador al vencer.
 */
import Layout from '../../layouts/Layout.astro';
import Rejilla from '../../components/Rejilla.astro';
import Explorar from '../../components/Explorar.astro';
import SelloFrescura from '../../components/SelloFrescura.astro';
import { SECCIONES_CON_PAGINA, GENERADO_EL } from '../../data/secciones.js';

export function getStaticPaths() {
  return SECCIONES_CON_PAGINA.map((s) => ({
    params: { seccion: s.slug },
    props: { seccion: s },
  }));
}

const { seccion } = Astro.props;
---

<Layout
  title={`${seccion.titulo} — Ofertas de Mercado Libre | KalidaPresio`}
  description={seccion.descripcion}
>
  <article class="sec hoja">
    <nav class="sec-migas etiqueta" aria-label="Estás en">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span>
      <a href="/ofertas">Por sección</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{seccion.titulo}</span>
    </nav>

    <header class="sec-cabeza">
      <h1 class="sec-titulo">{seccion.titulo}</h1>
      <p class="sec-cuenta etiqueta">
        <b>{seccion.items.length} productos</b> · {seccion.resumen} · <SelloFrescura generadoEl={GENERADO_EL} />
      </p>
    </header>

    <Rejilla productos={seccion.items} campana={seccion.campana} />

    <!-- La descripción va DESPUÉS de la rejilla: quien llega busca productos,
         pero es el texto estable que Google indexa de un catálogo que cambia. -->
    <p class="sec-intro">{seccion.descripcion}</p>

    <Explorar excluir={`/ofertas/${seccion.slug}`} titulo="Sigue explorando" />
  </article>
</Layout>

<style>
  .sec { padding-block: clamp(1.2rem, 3vw, 2rem) 0; }
  .sec-migas { margin-bottom: 1.2rem; }
  .sec-migas a { color: inherit; }
  .sec-cabeza { margin-bottom: clamp(1.6rem, 4vw, 2.4rem); }
  .sec-titulo { font-size: clamp(2.8rem, 8vw, 5.4rem); text-transform: uppercase; margin-bottom: 0.8rem; }
  .sec-cuenta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .sec-cuenta b { background: var(--fosfo); color: var(--tinta); padding: 0.1em 0.4em; }
  .sec-intro { max-width: 68ch; margin-top: clamp(2.5rem, 6vw, 3.5rem); color: var(--tinta-2); }
</style>
