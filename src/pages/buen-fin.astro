---
/**
 * /buen-fin — El Detector de descuentos falsos del Buen Fin.
 *
 * ── POR QUÉ EXISTE ─────────────────────────────────────────────────────────
 * La promesa de KalidaPresio es «te digo cuándo el descuento es mentira», y
 * el Buen Fin es cuando más se pone a prueba: precios que suben antes para
 * «rebajarse» después. Esta página publica el veredicto de cada producto en
 * oferta con el historial que observamos (src/utils/detector.js).
 *
 * ── LA REGLA ───────────────────────────────────────────────────────────────
 * Solo se afirma lo observado, con las mismas puertas del histórico. Sin
 * precios recientes no hay veredictos, y la página lo dice en vez de
 * rellenar. Los números de «Cómo lo decidimos» salen de las constantes
 * reales: si cambia un umbral, cambia el texto.
 *
 * Es contenido de temporada pero la URL es permanente: después del Buen Fin
 * sigue sirviendo como detector, y el próximo año ya tiene historia en Google.
 */
import Layout from '../layouts/Layout.astro';
import { BUEN_FIN } from '../data/buenFin.js';
import { pesos } from '../utils/pesos.js';
import { DETECTOR, OBSERVACION, HOY } from '../data/detector.js';
import { DIAS_EN_OFERTA } from '../utils/detector.js';
import {
  DIAS_DESCUENTO_FALSO,
  DESCUENTO_SOSPECHOSO,
  DIAS_MINIMOS,
  DENSIDAD_MINIMA,
  MARGEN_PLANO,
  MARGEN_BAJO,
} from '../utils/historico.js';

/** Fechas 'YYYY-MM-DD' sin que la zona horaria las mueva de día. */
const fecha = (iso, opciones = { day: 'numeric', month: 'long' }) =>
  new Intl.DateTimeFormat('es-MX', { timeZone: 'UTC', ...opciones }).format(new Date(`${iso}T12:00:00Z`));
const pct = (x) => `${Math.round(x * 100)} %`;

// «viernes 13» y «martes 17 de noviembre»: armado a mano porque Intl pone
// una coma después del día de la semana («martes, 17 de noviembre»).
const conDia = (iso) => `${fecha(iso, { weekday: 'long' })} ${fecha(iso, { day: 'numeric' })}`;
const inicio = conDia(BUEN_FIN.inicio);
const fin = `${conDia(BUEN_FIN.fin)} de ${fecha(BUEN_FIN.fin, { month: 'long' })}`;

const diasSinObservar = OBSERVACION.hasta
  ? Math.round((Date.parse(`${HOY}T00:00:00Z`) - Date.parse(`${OBSERVACION.hasta}T00:00:00Z`)) / 86_400_000)
  : null;
const fresca = diasSinObservar !== null && diasSinObservar <= DIAS_EN_OFERTA;
const conVeredicto = DETECTOR.falsos.length + DETECTOR.inflados.length + DETECTOR.reales.length;

const MAX = 24;
const grupos = [
  {
    id: 'falsos',
    clase: 'g-falso',
    sello: '',
    titulo: 'Descuento falso',
    desc: `Anuncian un descuento de ${DESCUENTO_SOSPECHOSO} % o más, y su precio no se ha movido en al menos ${DIAS_DESCUENTO_FALSO} días de observación.`,
    items: DETECTOR.falsos,
  },
  {
    id: 'inflados',
    clase: 'g-inflado',
    sello: 'sello--azul',
    titulo: 'Ha estado más barato',
    desc: 'El precio tachado puede ser cierto, pero lo vimos más barato hace poco: hoy no es el mejor momento.',
    items: DETECTOR.inflados,
  },
  {
    id: 'reales',
    clase: 'g-real',
    sello: 'sello--verde',
    titulo: 'Precio realmente bajo',
    desc: 'Está en su precio más bajo de lo que llevamos observando, o muy cerca de él.',
    items: DETECTOR.reales,
  },
].filter((g) => g.items.length > 0);
---

<Layout
  title={`Descuentos falsos del Buen Fin ${BUEN_FIN.edicion} — KalidaPresio`}
  description={`Del ${BUEN_FIN.inicio.slice(8)} al ${BUEN_FIN.fin.slice(8)} de noviembre: qué descuentos de Mercado Libre son reales y cuáles no, según los precios que observamos cada día. Con fecha y sin adivinar.`}
>
  <article class="bf">
    <header class="bf-portada hoja">
      <div class="bf-portada-txt">
        <p class="etiqueta">Buen Fin {BUEN_FIN.edicion} · del {inicio} al {fin}</p>
        <h1 class="bf-titulo">Detector de descuentos <span class="bf-falsos">falsos</span></h1>
        <p class="bf-sub">
          En el Buen Fin hay rebajas de verdad y precios que suben antes para «bajar» después.
          Observamos los precios de Mercado Libre día con día y te decimos cuál es cuál, <span class="resalta">con fecha y sin adivinar</span>.
        </p>
        <p class="bf-estado etiqueta" data-nivel={fresca ? 'fresco' : 'viejo'}>
          {OBSERVACION.dias === 0
            ? 'Todavía no tenemos precios observados.'
            : fresca
              ? `Llevamos ${OBSERVACION.dias} días de observación (desde el ${fecha(OBSERVACION.desde)}). Hoy seguimos ${DETECTOR.enOferta} productos en oferta; ${conVeredicto} ya tienen veredicto.`
              : `Última observación de precios: ${fecha(OBSERVACION.hasta)}. Aquí solo se publica lo visto en los últimos ${DIAS_EN_OFERTA} días.`}
        </p>
      </div>
      <!-- Los tres sellos del detector: lo que la página puede decirte. -->
      <div class="bf-sellos" aria-hidden="true">
        <span class="sello anima-sellar" style="--giro:-12deg;--retraso:.3s">Descuento falso</span>
        <span class="sello sello--azul anima-sellar" style="--giro:7deg;--retraso:.55s">Ha estado más barato</span>
        <span class="sello sello--verde sello--doble anima-sellar" style="--giro:-4deg;--retraso:.8s">Precio realmente bajo</span>
      </div>
    </header>

    <div class="hoja">
      {grupos.length > 0 ? (
        <nav class="bf-indice" aria-label="Veredictos">
          {grupos.map((g) => <a class={`chip ${g.clase}`} href={`#${g.id}`}>{g.titulo} <b>{g.items.length}</b></a>)}
        </nav>
      ) : (
        <section class="bf-vacio cartulina cartulina--blanca con-cinta">
          <h2 class="bf-vacio-h">Todavía no hay veredictos</h2>
          <p>
            {fresca
              ? `Para decir «descuento falso» necesitamos al menos ${DIAS_DESCUENTO_FALSO} días observando el mismo producto, y ${DIAS_MINIMOS} para decir «el más bajo en N días». Los primeros aparecen aquí conforme se cumplan, antes del ${inicio}.`
              : 'Los veredictos aparecen aquí en cuanto haya precios recientes. No vamos a rellenar con precios viejos: un veredicto sobre un precio que ya nadie vio sería adivinar.'}
          </p>
        </section>
      )}

      {grupos.map((g) => (
        <section class={`bf-grupo ${g.clase}`} id={g.id} aria-labelledby={`${g.id}-h`}>
          <header class="bf-grupo-cabeza">
            <h2 id={`${g.id}-h`} class={`bf-grupo-titulo sello ${g.sello}`}>{g.titulo} · {g.items.length}</h2>
            <p class="bf-grupo-desc">{g.desc}</p>
          </header>
          <ul class="bf-lista">
            {g.items.slice(0, MAX).map((x) => (
              <li class="bf-item">
                {x.imagen
                  ? <img src={x.imagen} alt="" width="84" height="84" loading="lazy" />
                  : <span class="bf-sinfoto" aria-hidden="true"></span>}
                <div class="bf-info">
                  <h3 class="bf-nombre">{x.titulo}</h3>
                  <p class="bf-precios">
                    <strong class="plumon">{pesos(x.precio)}</strong>
                    {x.precio_antes && <s class="tache">{pesos(x.precio_antes)}</s>}
                    {x.descuento > 0 && <span class="bf-anuncia etiqueta">anuncia −{x.descuento}%</span>}
                  </p>
                  <p class="bf-veredicto">{x.texto}</p>
                  <p class="bf-meta etiqueta">
                    Visto el {fecha(x.visto)} ·
                    <a
                      href={x.enlace}
                      target="_blank"
                      rel={x.afiliado ? 'sponsored noopener noreferrer' : 'nofollow noopener noreferrer'}
                      data-kp-seccion="buenfin"
                    >compruébalo en Mercado Libre{x.afiliado ? ' (enlace de afiliado)' : ''}</a>
                  </p>
                </div>
              </li>
            ))}
          </ul>
          {g.items.length > MAX && <p class="bf-mas etiqueta">Y {g.items.length - MAX} más con el mismo veredicto.</p>}
        </section>
      ))}

      <div class="bf-reglas">
        <section class="bf-ticket ticket" id="como-lo-decidimos" aria-labelledby="bf-decidimos-h">
          <h2 id="bf-decidimos-h" class="bf-ticket-h">Cómo lo decidimos</h2>
          <hr />
          <ul>
            <li>Cada día miramos el precio de los productos en oferta de Mercado Libre y guardamos el más bajo y el más alto del día.</li>
            <li>
              <b>Descuento falso:</b> anuncia {DESCUENTO_SOSPECHOSO} % o más de descuento y, en al menos
              {DIAS_DESCUENTO_FALSO} días de calendario (con el {pct(DENSIDAD_MINIMA)} de esos días observados),
              su precio no se movió más de {pct(MARGEN_PLANO)}. Si hoy bajó de verdad, no lo acusamos.
            </li>
            <li>
              <b>Ha estado más barato:</b> hoy está más de {pct(MARGEN_BAJO)} por encima del precio más bajo
              que le vimos.
            </li>
            <li>
              <b>Precio realmente bajo:</b> está en su mínimo observado o a menos de {pct(MARGEN_BAJO)} de él,
              con al menos {DIAS_MINIMOS} días de observación.
            </li>
            <li>
              Ante la duda, no decimos nada: un producto con poca historia no aparece. Y solo publicamos
              precios vistos en los últimos {DIAS_EN_OFERTA} días; compruébalos en Mercado Libre antes de comprar.
            </li>
          </ul>
        </section>

        <section class="bf-tu" id="como-detectarlo" aria-labelledby="bf-tu-h">
          <h2 id="bf-tu-h" class="bf-tu-h">Cómo detectarlo <span class="plumon">tú</span></h2>
          <ol class="bf-pasos">
            <li><b>Desconfía del precio tachado.</b> Es el que el vendedor dice que tenía, no necesariamente el que cobraba.</li>
            <li><b>Mira el precio antes del Buen Fin.</b> Toma una captura unos días antes, o revisa esta página, y compara.</li>
            <li><b>Compara el costo total.</b> Suma el envío y revisa si a meses sin intereses pagas lo mismo que de contado.</li>
            <li><b>Revisa al vendedor.</b> Su reputación y la política de devolución, antes de pagar.</li>
            <li><b>Guarda la evidencia.</b> Si te anuncian un precio y te cobran otro, con capturas puedes quejarte ante la PROFECO.</li>
          </ol>
        </section>
      </div>

      <p class="bf-nota">
        Los enlaces de esta página llevan a la ficha del producto, sin comisión, salvo los de «Precio realmente
        bajo» que también recomendamos: esos son enlaces de afiliado y lo dicen. Nunca cobramos por lo que
        señalamos como descuento falso.
      </p>
    </div>
  </article>
</Layout>

<style>
  .bf-portada {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .bf-titulo { font-size: clamp(3rem, 8.5vw, 6.6rem); text-transform: uppercase; margin: 0.6rem 0 1.2rem; }
  .bf-falsos { color: var(--sello-rojo); }
  .bf-sub { font-size: clamp(1.02rem, 2vw, 1.18rem); max-width: 54ch; }
  .bf-estado { display: flex; gap: 0.6em; max-width: 62ch; margin-top: 1.2rem; line-height: 1.6; }
  .bf-estado::before { content: ""; flex: none; width: 0.75em; height: 0.75em; margin-top: 0.3em; border-radius: 50%; background: var(--sello-verde); }
  .bf-estado[data-nivel='viejo']::before { background: var(--sello-rojo); }

  .bf-sellos { display: grid; justify-items: center; gap: 2.2rem; padding: 1rem 0; }
  .bf-sellos .sello { font-size: clamp(1.3rem, 2.6vw, 1.9rem); }

  .bf-indice { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0.5rem 0 2.5rem; }
  .bf-indice .chip { font-size: 0.78rem; padding: 0.55em 1em; }
  .bf-indice b { font-variant-numeric: tabular-nums; }
  .bf-indice .g-falso b { color: var(--sello-rojo); }

  .bf-vacio { --giro: -0.7deg; max-width: 760px; padding: clamp(1.4rem, 4vw, 2.2rem); margin-bottom: 3rem; }
  .bf-vacio-h { font-size: clamp(1.8rem, 5vw, 2.6rem); text-transform: uppercase; margin-bottom: 0.6rem; }

  .bf-grupo { margin-bottom: clamp(2.5rem, 6vw, 4rem); scroll-margin-top: 1rem; }
  .bf-grupo-cabeza { display: grid; gap: 0.8rem; margin-bottom: 1.4rem; }
  .bf-grupo-titulo { --giro: -2deg; justify-self: start; font-size: clamp(1.4rem, 3.4vw, 2rem); line-height: 1.05; }
  .bf-grupo-desc { color: var(--tinta-2); max-width: 62ch; }

  .bf-lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 1rem; }
  .bf-item {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem;
    background: var(--cartulina);
    border: 2px solid var(--tinta);
    border-left-width: 8px;
    box-shadow: var(--sombra-papel);
  }
  .g-falso .bf-item { border-left-color: var(--sello-rojo); }
  .g-inflado .bf-item { border-left-color: var(--sello-azul); }
  .g-real .bf-item { border-left-color: var(--sello-verde); }
  .bf-item img,
  .bf-sinfoto { width: 84px; height: 84px; object-fit: contain; background: #fff; }
  .bf-sinfoto { display: block; background: var(--papel-2); }
  .bf-info { min-width: 0; }
  .bf-nombre { font: 700 0.95rem/1.35 var(--f-texto); margin: 0 0 0.35rem; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .bf-precios { margin: 0 0 0.3rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.7rem; }
  .bf-precios strong { font-size: 1.45rem; line-height: 1.1; }
  .bf-precios s { font: 600 0.85rem/1 var(--f-ticket); }
  .bf-anuncia { font-size: 0.64rem; }
  .bf-veredicto { margin: 0 0 0.3rem; font-weight: 700; font-size: 0.92rem; }
  .g-falso .bf-veredicto { color: var(--sello-rojo); }
  .g-inflado .bf-veredicto { color: var(--sello-azul); }
  .g-real .bf-veredicto { color: var(--sello-verde); }
  .bf-meta { margin: 0; font-size: 0.6rem; }
  .bf-meta a { color: var(--tinta); }
  .bf-mas { margin-top: 1rem; }

  .bf-reglas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: clamp(1rem, 4vw, 2rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 2px solid var(--tinta);
  }
  .bf-ticket { --giro: -0.8deg; transform: rotate(var(--giro)); font-size: 0.8rem; line-height: 1.65; }
  .bf-ticket-h { font: 600 0.85rem/1.4 var(--f-ticket); letter-spacing: 0.08em; text-transform: uppercase; text-align: center; }
  .bf-ticket ul { margin: 0; padding-left: 1.1rem; }
  .bf-ticket li { margin-bottom: 0.6rem; }
  .bf-ticket li::marker { content: "→ "; }

  .bf-tu-h { font-size: clamp(2rem, 5vw, 3rem); text-transform: uppercase; margin-bottom: 1.2rem; }
  .bf-tu-h .plumon { text-transform: none; color: var(--sello-rojo); }
  .bf-pasos { list-style: none; counter-reset: paso; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .bf-pasos li { counter-increment: paso; position: relative; padding-left: 3.2rem; min-height: 2.4rem; }
  .bf-pasos li::before {
    content: counter(paso);
    position: absolute;
    left: 0;
    top: -0.1rem;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    font: 400 1.25rem/1 var(--f-plumon);
    background: var(--fosfo);
    border: 2px solid var(--tinta);
    border-radius: 50%;
    transform: rotate(-8deg);
  }

  .bf-nota { max-width: 68ch; margin: clamp(2.5rem, 6vw, 3.5rem) 0 0; color: var(--tinta-2); font-size: 0.86rem; }

  @media (max-width: 860px) {
    .bf-portada,
    .bf-reglas { grid-template-columns: 1fr; }
    .bf-sellos { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); justify-items: center; align-items: center; }
    .bf-sellos .sello { font-size: 1.1rem; }
  }
  @media (max-width: 480px) {
    .bf-item { grid-template-columns: 64px minmax(0, 1fr); }
    .bf-item img, .bf-sinfoto { width: 64px; height: 64px; }
  }
</style>
