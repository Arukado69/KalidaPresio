---
/**
 * /buen-fin — El Detector de descuentos falsos del Buen Fin.
 *
 * ── POR QUÉ EXISTE ─────────────────────────────────────────────────────────
 * La promesa de KalidaPresio es «te digo cuándo el descuento es mentira», y
 * el Buen Fin es cuando más se pone a prueba: precios que suben antes para
 * «rebajarse» después. Esta página publica el veredicto de cada producto en
 * oferta con el historial que observamos (src/utils/detector.js).
 *
 * ── LA REGLA ───────────────────────────────────────────────────────────────
 * Solo se afirma lo observado, con las mismas puertas del histórico. Sin
 * precios recientes no hay veredictos, y la página lo dice en vez de
 * rellenar. Los números de «Cómo lo decidimos» salen de las constantes
 * reales: si cambia un umbral, cambia el texto.
 *
 * Es contenido de temporada pero la URL es permanente: después del Buen Fin
 * sigue sirviendo como detector, y el próximo año ya tiene historia en Google.
 */
import Layout from '../layouts/Layout.astro';
import { BUEN_FIN } from '../data/buenFin.js';
import { pesos } from '../utils/pesos.js';
import { DETECTOR, OBSERVACION, HOY } from '../data/detector.js';
import { DIAS_EN_OFERTA } from '../utils/detector.js';
import { FASE, VIGENTES, RESUMEN, ULTIMA_REVISION } from '../data/seleccionBuenFin.js';
import { DIAS_REFERENCIA } from '../utils/vitrinaBuenFin.js';
import { fechaDeRevision } from '../utils/vistos.js';
import { formatoCodigo } from '../utils/codigos.js';
import {
  DIAS_DESCUENTO_FALSO,
  DESCUENTO_SOSPECHOSO,
  DIAS_MINIMOS,
  DENSIDAD_MINIMA,
  MARGEN_PLANO,
  MARGEN_BAJO,
} from '../utils/historico.js';

/** Fechas 'YYYY-MM-DD' sin que la zona horaria las mueva de día. */
const fecha = (iso, opciones = { day: 'numeric', month: 'long' }) =>
  new Intl.DateTimeFormat('es-MX', { timeZone: 'UTC', ...opciones }).format(new Date(`${iso}T12:00:00Z`));
const pct = (x) => `${Math.round(x * 100)} %`;

// «viernes 13» y «martes 17 de noviembre»: armado a mano porque Intl pone
// una coma después del día de la semana («martes, 17 de noviembre»).
const conDia = (iso) => `${fecha(iso, { weekday: 'long' })} ${fecha(iso, { day: 'numeric' })}`;
const inicio = conDia(BUEN_FIN.inicio);
const fin = `${conDia(BUEN_FIN.fin)} de ${fecha(BUEN_FIN.fin, { month: 'long' })}`;

const diasSinObservar = OBSERVACION.hasta
  ? Math.round((Date.parse(`${HOY}T00:00:00Z`) - Date.parse(`${OBSERVACION.hasta}T00:00:00Z`)) / 86_400_000)
  : null;
const fresca = diasSinObservar !== null && diasSinObservar <= DIAS_EN_OFERTA;
const conVeredicto = DETECTOR.falsos.length + DETECTOR.inflados.length + DETECTOR.reales.length;

const MAX = 24;
const grupos = [
  {
    id: 'falsos',
    clase: 'g-falso',
    sello: '',
    titulo: 'Descuento falso',
    desc: `Anuncian un descuento de ${DESCUENTO_SOSPECHOSO} % o más, y su precio no se ha movido en al menos ${DIAS_DESCUENTO_FALSO} días de observación.`,
    items: DETECTOR.falsos,
  },
  {
    id: 'inflados',
    clase: 'g-inflado',
    sello: 'sello--azul',
    titulo: 'Ha estado más barato',
    desc: 'El precio tachado puede ser cierto, pero lo vimos más barato hace poco: hoy no es el mejor momento.',
    items: DETECTOR.inflados,
  },
  {
    id: 'reales',
    clase: 'g-real',
    sello: 'sello--verde',
    titulo: 'Precio realmente bajo',
    desc: 'Está en su precio más bajo de lo que llevamos observando, o muy cerca de él.',
    items: DETECTOR.reales,
  },
].filter((g) => g.items.length > 0);

// ── Nuestra selección (la vitrina) ────────────────────────────────────────
// El detector de arriba necesita observación diaria del mercado, que hoy no
// corre. La vitrina sí tiene historia: lo que viste al compartir o guardar
// cada producto (src/utils/vitrinaBuenFin.js).
const comparados = RESUMEN.bajaron.length + RESUMEN.iguales.length + RESUMEN.subieron.length;
// Antes del 13, y el 13 mientras no se haya revisado nada: los precios de antes.
const verPrecios = VIGENTES.length > 0 && (FASE === 'antes' || (FASE === 'durante' && comparados === 0));
const verResultados = FASE !== 'antes' && comparados > 0;
const haySeleccion = verPrecios || verResultados;
const diaVisto = (iso) => fecha(fechaDeRevision(iso));
const porcentaje = (c) => `${Math.abs(Math.round(c * 100))} %`;
const gruposSeleccion = [
  {
    id: 'bajaron',
    clase: 'g-real',
    sello: 'sello--verde',
    titulo: 'Bajó de verdad',
    desc: `Más barato que el precio más bajo que le vimos en los ${DIAS_REFERENCIA} días antes del Buen Fin.`,
    items: RESUMEN.bajaron,
    texto: (x) => `${porcentaje(x.cambio)} menos que el ${fecha(x.antes.fecha)} (${pesos(x.antes.precio)})`,
  },
  {
    id: 'iguales',
    clase: 'g-igual',
    sello: 'sello--tinta',
    titulo: 'Mismo precio que antes',
    desc: 'Cuesta lo mismo que antes del Buen Fin (menos de 2 % de diferencia): si anuncia descuento, no lo abarató.',
    items: RESUMEN.iguales,
    texto: (x) => `Mismo precio que el ${fecha(x.antes.fecha)} (${pesos(x.antes.precio)})`,
  },
  {
    id: 'subieron',
    clase: 'g-inflado',
    sello: 'sello--azul',
    titulo: 'Más caro que antes',
    desc: 'Antes del Buen Fin lo vimos más barato. Si anuncia descuento, es contra un precio que subió.',
    items: RESUMEN.subieron,
    texto: (x) => `El ${fecha(x.antes.fecha)} estaba a ${pesos(x.antes.precio)}: ${porcentaje(x.cambio)} más caro`,
  },
].filter((g) => g.items.length > 0);
---

<Layout
  title={`Descuentos falsos del Buen Fin ${BUEN_FIN.edicion} — KalidaPresio`}
  description={`Del ${BUEN_FIN.inicio.slice(8)} al ${BUEN_FIN.fin.slice(8)} de noviembre: qué descuentos de Mercado Libre son reales y cuáles no, según los precios que vimos antes y durante el Buen Fin. Con fecha y sin adivinar, y tus derechos como consumidor.`}
>
  <article class="bf">
    <header class="bf-portada hoja">
      <div class="bf-portada-txt">
        <p class="etiqueta">Buen Fin {BUEN_FIN.edicion} · del {inicio} al {fin}</p>
        <h1 class="bf-titulo">Detector de descuentos <span class="bf-falsos">falsos</span></h1>
        <p class="bf-sub">
          En el Buen Fin hay rebajas de verdad y precios que suben antes para «bajar» después.
          Seguimos los precios de Mercado Libre y te decimos cuál es cuál, <span class="resalta">con fecha y sin adivinar</span>.
        </p>
        <p class="bf-estado etiqueta" data-nivel={fresca || ULTIMA_REVISION ? 'fresco' : 'viejo'}>
          {fresca
            ? `Llevamos ${OBSERVACION.dias} días de observación (desde el ${fecha(OBSERVACION.desde)}). Hoy seguimos ${DETECTOR.enOferta} productos en oferta; ${conVeredicto} ya tienen veredicto.`
            : ULTIMA_REVISION
              ? `Seguimos ${VIGENTES.length} ${VIGENTES.length === 1 ? 'producto' : 'productos'} de nuestra selección, revisados a mano. La revisión más reciente: el ${diaVisto(ULTIMA_REVISION)}.`
              : OBSERVACION.dias === 0
                ? 'Todavía no tenemos precios observados.'
                : `Última observación de precios: ${fecha(OBSERVACION.hasta)}. Aquí solo se publica lo visto en los últimos ${DIAS_EN_OFERTA} días.`}
        </p>
      </div>
      <!-- Los tres sellos del detector: lo que la página puede decirte. -->
      <div class="bf-sellos" aria-hidden="true">
        <span class="sello anima-sellar" style="--giro:-12deg;--retraso:.3s">Descuento falso</span>
        <span class="sello sello--azul anima-sellar" style="--giro:7deg;--retraso:.55s">Ha estado más barato</span>
        <span class="sello sello--verde sello--doble anima-sellar" style="--giro:-4deg;--retraso:.8s">Precio realmente bajo</span>
      </div>
    </header>

    <div class="hoja">
      {haySeleccion && (
        <section class="bf-sel" id="nuestra-seleccion" aria-labelledby="bf-sel-h">
          <header class="bf-sel-cabeza">
            <p class="etiqueta">Nuestra selección · {verResultados ? 'antes contra durante' : 'precios de antes'}</p>
            <h2 id="bf-sel-h" class="bf-sel-h">
              {verResultados
                ? <>¿Bajaron <span class="plumon">de verdad</span>?</>
                : <>Así están <span class="plumon">antes</span> del Buen Fin</>}
            </h2>
            <p class="bf-grupo-desc">
              {verResultados
                ? `Los productos que recomendamos: el precio más bajo que les vimos en los ${DIAS_REFERENCIA} días antes del Buen Fin contra el más bajo durante el Buen Fin. Solo comparamos lo que vimos en los dos momentos.`
                : FASE === 'antes'
                  ? `Los productos que recomendamos, con el precio que vimos y cuándo. Del ${inicio} al ${fin} los revisamos otra vez y aquí te decimos cuáles bajaron de verdad, cuáles siguen igual y cuáles subieron.`
                  : 'Ya empezó el Buen Fin y los estamos revisando. En cuanto veamos su precio de hoy, aquí te decimos si bajó de verdad.'}
            </p>
          </header>

          {verPrecios && (
            <ul class="bf-lista g-ref">
              {VIGENTES.slice(0, MAX).map((p) => (
                <li class="bf-item">
                  {p.imagen
                    ? <img src={p.imagen} alt="" width="84" height="84" loading="lazy" />
                    : <span class="bf-sinfoto" aria-hidden="true"></span>}
                  <div class="bf-info">
                    <h3 class="bf-nombre"><a href={`/p/${p.slug}`}>{p.titulo}</a></h3>
                    <p class="bf-precios"><strong class="plumon">{pesos(p.precio_actual)}</strong></p>
                    <p class="bf-meta etiqueta">
                      {formatoCodigo(p.codigo) && <>{formatoCodigo(p.codigo)} · </>}Visto el {diaVisto(p.revisado)} ·
                      <a href={`/p/${p.slug}`}>su historial</a>
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          )}

          {verResultados && gruposSeleccion.map((g) => (
            <section class={`bf-grupo ${g.clase}`} id={`sel-${g.id}`} aria-labelledby={`sel-${g.id}-h`}>
              <header class="bf-grupo-cabeza">
                <h3 id={`sel-${g.id}-h`} class={`bf-grupo-titulo sello ${g.sello}`}>{g.titulo} · {g.items.length}</h3>
                <p class="bf-grupo-desc">{g.desc}</p>
              </header>
              <ul class="bf-lista">
                {g.items.slice(0, MAX).map((x) => (
                  <li class="bf-item">
                    {x.producto.imagen
                      ? <img src={x.producto.imagen} alt="" width="84" height="84" loading="lazy" />
                      : <span class="bf-sinfoto" aria-hidden="true"></span>}
                    <div class="bf-info">
                      <h4 class="bf-nombre"><a href={`/p/${x.producto.slug}`}>{x.producto.titulo}</a></h4>
                      <p class="bf-precios"><strong class="plumon">{pesos(x.durante.precio)}</strong></p>
                      <p class="bf-veredicto">{g.texto(x)}</p>
                      <p class="bf-meta etiqueta">
                        {formatoCodigo(x.producto.codigo) && <>{formatoCodigo(x.producto.codigo)} · </>}En el Buen Fin, visto el {fecha(x.durante.fecha)} ·
                        <a href={`/p/${x.producto.slug}`}>su historial</a>
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))}

          {verResultados && (RESUMEN.sinRevisar > 0 || RESUMEN.sinReferencia > 0) && (
            <p class="bf-mas etiqueta">
              {RESUMEN.sinRevisar > 0 && (FASE === 'durante'
                ? `Falta revisar ${RESUMEN.sinRevisar} ${RESUMEN.sinRevisar === 1 ? 'producto' : 'productos'} en el Buen Fin. `
                : `${RESUMEN.sinRevisar} ${RESUMEN.sinRevisar === 1 ? 'producto no se revisó' : 'productos no se revisaron'} durante el Buen Fin. `)}
              {RESUMEN.sinReferencia > 0 && `${RESUMEN.sinReferencia} no ${RESUMEN.sinReferencia === 1 ? 'tiene' : 'tienen'} un precio de antes del Buen Fin para comparar.`}
            </p>
          )}
        </section>
      )}

      {grupos.length > 0 ? (
        <nav class="bf-indice" aria-label="Veredictos">
          {grupos.map((g) => <a class={`chip ${g.clase}`} href={`#${g.id}`}>{g.titulo} <b>{g.items.length}</b></a>)}
        </nav>
      ) : haySeleccion ? null : (
        <section class="bf-vacio cartulina cartulina--blanca con-cinta">
          <h2 class="bf-vacio-h">Todavía no hay veredictos</h2>
          <p>
            {fresca
              ? `Para decir «descuento falso» necesitamos al menos ${DIAS_DESCUENTO_FALSO} días observando el mismo producto, y ${DIAS_MINIMOS} para decir «el más bajo en N días». Los primeros aparecen aquí conforme se cumplan, antes del ${inicio}.`
              : 'Los veredictos aparecen aquí en cuanto haya precios recientes. No vamos a rellenar con precios viejos: un veredicto sobre un precio que ya nadie vio sería adivinar.'}
          </p>
        </section>
      )}

      {grupos.map((g) => (
        <section class={`bf-grupo ${g.clase}`} id={g.id} aria-labelledby={`${g.id}-h`}>
          <header class="bf-grupo-cabeza">
            <h2 id={`${g.id}-h`} class={`bf-grupo-titulo sello ${g.sello}`}>{g.titulo} · {g.items.length}</h2>
            <p class="bf-grupo-desc">{g.desc}</p>
          </header>
          <ul class="bf-lista">
            {g.items.slice(0, MAX).map((x) => (
              <li class="bf-item">
                {x.imagen
                  ? <img src={x.imagen} alt="" width="84" height="84" loading="lazy" />
                  : <span class="bf-sinfoto" aria-hidden="true"></span>}
                <div class="bf-info">
                  <h3 class="bf-nombre">{x.titulo}</h3>
                  <p class="bf-precios">
                    <strong class="plumon">{pesos(x.precio)}</strong>
                    {x.precio_antes && <s class="tache">{pesos(x.precio_antes)}</s>}
                    {x.descuento > 0 && <span class="bf-anuncia etiqueta">anuncia −{x.descuento}%</span>}
                  </p>
                  <p class="bf-veredicto">{x.texto}</p>
                  <p class="bf-meta etiqueta">
                    Visto el {fecha(x.visto)} ·
                    <a
                      href={x.enlace}
                      target="_blank"
                      rel={x.afiliado ? 'sponsored noopener noreferrer' : 'nofollow noopener noreferrer'}
                      data-kp-seccion="buenfin"
                    >compruébalo en Mercado Libre{x.afiliado ? ' (enlace de afiliado)' : ''}</a>
                  </p>
                </div>
              </li>
            ))}
          </ul>
          {g.items.length > MAX && <p class="bf-mas etiqueta">Y {g.items.length - MAX} más con el mismo veredicto.</p>}
        </section>
      ))}

      <div class="bf-reglas">
        <section class="bf-ticket ticket" id="como-lo-decidimos" aria-labelledby="bf-decidimos-h">
          <h2 id="bf-decidimos-h" class="bf-ticket-h">Cómo lo decidimos</h2>
          <hr />
          <ul>
            <li>
              <b>Nuestra selección:</b> el precio de cada producto lo revisamos a mano y cada revisión queda guardada con
              su fecha. Comparamos el más bajo que le vimos en los {DIAS_REFERENCIA} días antes del Buen Fin con el más
              bajo durante el Buen Fin; menos de {pct(MARGEN_PLANO)} de diferencia es el mismo precio.
            </li>
            <li>Cuando podemos observar el mercado día con día, guardamos el precio más bajo y el más alto de cada día. Con eso decidimos:</li>
            <li>
              <b>Descuento falso:</b> anuncia {DESCUENTO_SOSPECHOSO} % o más de descuento y, en al menos
              {DIAS_DESCUENTO_FALSO} días de calendario (con el {pct(DENSIDAD_MINIMA)} de esos días observados),
              su precio no se movió más de {pct(MARGEN_PLANO)}. Si hoy bajó de verdad, no lo acusamos.
            </li>
            <li>
              <b>Ha estado más barato:</b> hoy está más de {pct(MARGEN_BAJO)} por encima del precio más bajo
              que le vimos.
            </li>
            <li>
              <b>Precio realmente bajo:</b> está en su mínimo observado o a menos de {pct(MARGEN_BAJO)} de él,
              con al menos {DIAS_MINIMOS} días de observación.
            </li>
            <li>
              Ante la duda, no decimos nada: un producto con poca historia no aparece. Y solo publicamos
              precios vistos en los últimos {DIAS_EN_OFERTA} días; compruébalos en Mercado Libre antes de comprar.
            </li>
          </ul>
        </section>

        <section class="bf-tu" id="como-detectarlo" aria-labelledby="bf-tu-h">
          <h2 id="bf-tu-h" class="bf-tu-h">Cómo detectarlo <span class="plumon">tú</span></h2>
          <ol class="bf-pasos">
            <li><b>Desconfía del precio tachado.</b> Es el que el vendedor dice que tenía, no necesariamente el que cobraba.</li>
            <li><b>Mira el precio antes del Buen Fin.</b> Toma una captura unos días antes, o revisa esta página, y compara.</li>
            <li><b>Compara el costo total.</b> Suma el envío y revisa si a meses sin intereses pagas lo mismo que de contado.</li>
            <li><b>Revisa al vendedor.</b> Su reputación y la política de devolución, antes de pagar.</li>
            <li><b>Guarda la evidencia.</b> Si te anuncian un precio y te cobran otro, con capturas puedes quejarte ante la PROFECO.</li>
          </ol>
        </section>
      </div>

      <section class="bf-derechos" id="tus-derechos" aria-labelledby="bf-derechos-h">
        <header class="bf-derechos-cabeza">
          <h2 id="bf-derechos-h" class="bf-tu-h">Tus <span class="plumon">derechos</span> en el Buen Fin</h2>
          <p class="bf-grupo-desc">
            Lo que dice la <a href="https://www.diputados.gob.mx/LeyesBiblio/pdf/LFPC.pdf" target="_blank" rel="noopener noreferrer">Ley Federal de Protección al Consumidor</a>
            (texto vigente, última reforma del 12 de diciembre de 2025). Es información general, no asesoría legal.
          </p>
        </header>
        <ul class="bf-derechos-lista">
          <li class="cartulina">
            <h3>Un descuento es contra el precio de siempre</h3>
            <p>«Descuento», «oferta» o «barata» quiere decir precios rebajados o menores a los normales de la tienda. Subir el precio para luego «rebajarlo» no es un descuento.</p>
            <p class="etiqueta">Art. 46</p>
          </li>
          <li class="cartulina">
            <h3>El precio que ves es el total</h3>
            <p>Tiene que incluir impuestos, comisiones, intereses, seguros y cualquier cargo extra, de contado o a crédito.</p>
            <p class="etiqueta">Art. 7 Bis</p>
          </li>
          <li class="cartulina">
            <h3>Te tienen que respetar lo anunciado</h3>
            <p>El precio, la garantía, los plazos y las condiciones con que te lo ofrecieron. Guarda capturas del anuncio y de tu compra.</p>
            <p class="etiqueta">Art. 7</p>
          </li>
          <li class="cartulina">
            <h3>Compraste en línea: 5 días hábiles para arrepentirte</h3>
            <p>Desde que lo recibes puedes cancelar sin penalización y te deben regresar lo que pagaste. El envío de regreso corre por tu cuenta.</p>
            <p class="etiqueta">Arts. 51 y 56</p>
          </li>
          <li class="cartulina">
            <h3>Garantía de al menos 90 días</h3>
            <p>Contados desde que te entregan el producto.</p>
            <p class="etiqueta">Art. 77</p>
          </li>
          <li class="cartulina">
            <h3>Si no es lo que te ofrecieron</h3>
            <p>Puedes pedir que te lo cambien o que te devuelvan tu dinero, y además una bonificación de al menos el 20 % del precio.</p>
            <p class="etiqueta">Arts. 92 y 92 Ter</p>
          </li>
        </ul>
        <div class="bf-profeco ticket">
          <h3 class="bf-ticket-h">¿Algo salió mal? PROFECO</h3>
          <hr />
          <ul>
            <li><b>Teléfono del Consumidor:</b> <a href="tel:+525555688722">55 5568 8722</a> (Ciudad de México y área metropolitana) · <a href="tel:+528004688722">800 468 8722</a> (resto del país).</li>
            <li><b>Queja en línea:</b> <a href="https://concilianet.profeco.gob.mx/" target="_blank" rel="noopener noreferrer">Concilianet</a>, si la tienda está registrada ahí. Si no, por teléfono o en una oficina de PROFECO.</li>
            <li><b>Precios de referencia de PROFECO:</b> <a href="https://elbuenfin.profeco.gob.mx/" target="_blank" rel="noopener noreferrer">elbuenfin.profeco.gob.mx</a>.</li>
          </ul>
        </div>
      </section>

      <p class="bf-nota">
        Los enlaces de esta página llevan a la ficha del producto, sin comisión, salvo los de «Precio realmente
        bajo» que también recomendamos: esos son enlaces de afiliado y lo dicen. Nunca cobramos por lo que
        señalamos como descuento falso.
      </p>
    </div>
  </article>
</Layout>

<style>
  .bf-portada {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .bf-titulo { font-size: clamp(3rem, 8.5vw, 6.6rem); text-transform: uppercase; margin: 0.6rem 0 1.2rem; }
  .bf-falsos { color: var(--sello-rojo); }
  .bf-sub { font-size: clamp(1.02rem, 2vw, 1.18rem); max-width: 54ch; }
  .bf-estado { display: flex; gap: 0.6em; max-width: 62ch; margin-top: 1.2rem; line-height: 1.6; }
  .bf-estado::before { content: ""; flex: none; width: 0.75em; height: 0.75em; margin-top: 0.3em; border-radius: 50%; background: var(--sello-verde); }
  .bf-estado[data-nivel='viejo']::before { background: var(--sello-rojo); }

  .bf-sellos { display: grid; justify-items: center; gap: 2.2rem; padding: 1rem 0; }
  .bf-sellos .sello { font-size: clamp(1.3rem, 2.6vw, 1.9rem); }

  .bf-indice { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0.5rem 0 2.5rem; }
