---
/**
 * /p/<slug> — La página permanente de cada producto de la vitrina.
 *
 * ── POR QUÉ EXISTE ─────────────────────────────────────────────────────────
 * Hasta octubre de 2026 el sitio perdía páginas indexadas cada semana: las
 * colecciones desaparecen al quedarse con pocos productos y la regla de los 7
 * días esconde un precio sin revisar. Esta página se queda (ver
 * src/utils/paginaProducto.js): con la oferta cuando está vigente, y con su
 * historial y un aviso honesto cuando no. Es la que puede aparecer en Google
 * para «<producto> precio» o «<producto> vale la pena».
 *
 * ── LO QUE NO HACE ─────────────────────────────────────────────────────────
 * No presenta como oferta un precio vencido: el aviso va arriba y el
 * veredicto («¿es buen momento?») solo sale si el precio es de hoy. La
 * gráfica no une días que nadie observó.
 */
import Layout from '../../layouts/Layout.astro';
import SelloKP from '../../components/SelloKP.astro';
import Estrellas from '../../components/Estrellas.astro';
import BotonCTA from '../../components/BotonCTA.astro';
import crudo from '../../data/vitrina.json';
import { paginasDeVitrina, seriePrecios, graficaPrecios } from '../../utils/paginaProducto.js';
import { entradasDe, veredictoDe } from '../../data/historico.js';
import { formatearVendidos } from '../../utils/mlPayload.js';
import { recortar } from '../../utils/publicacion.js';
import { ANCHO as PROMO_ANCHO, ALTO as PROMO_ALTO } from '../../utils/tarjetas.js';

export function getStaticPaths() {
  return paginasDeVitrina(crudo).map((pagina) => ({ params: { slug: pagina.slug }, props: { pagina } }));
}

const { pagina } = Astro.props;
const p = pagina.producto;
const vigente = pagina.estado === 'vigente';

const pesos = (n) =>
  new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(Number(n) || 0);
const fechaMx = (iso) =>
  new Intl.DateTimeFormat('es-MX', { timeZone: 'America/Mexico_City', day: 'numeric', month: 'long' }).format(new Date(iso));
/** Días 'YYYY-MM-DD' del histórico, sin que la zona horaria los mueva. */
const dia = (ymd) => new Intl.DateTimeFormat('es-MX', { timeZone: 'UTC', day: 'numeric', month: 'short' }).format(new Date(`${ymd}T12:00:00Z`));

const claves = p.claves_historico ?? [p.id];
const hoy = new Date().toISOString().slice(0, 10);
const serie = seriePrecios(entradasDe(claves), { hasta: hoy, dias: 90 });
const g = graficaPrecios(serie);
const ultimo = g?.puntos.at(-1);
// El veredicto habla del precio de HOY: con un precio vencido sería adivinar.
const v = vigente ? veredictoDe(claves, p.precio_actual, p.descuento) : null;

const visto = fechaMx(p.revisado);
const diasDesde = Math.max(0, Math.floor((Date.now() - Date.parse(p.revisado)) / 86_400_000));
const aviso = pagina.estado === 'retirado'
  ? `Ya no está en nuestra selección${pagina.retirado ? ` (desde el ${fechaMx(pagina.retirado)})` : ''}. La dejamos aquí con su historial de precio.`
  : pagina.estado === 'vencido'
    ? (/relámpago/.test(pagina.motivo ?? '')
      ? 'Esta oferta relámpago ya terminó. Abajo está su historial de precio.'
      : `Este precio lo vimos el ${visto}, hace ${diasDesde} días: puede haber cambiado. Revísalo en Mercado Libre antes de comprar.`)
    : null;

const descripcion = vigente
  ? `${p.titulo}: ${pesos(p.precio_actual)}${p.precio_previo ? ` (antes ${pesos(p.precio_previo)})` : ''}, visto el ${visto}. Su historial de precio y nuestro Sello K-P de calidad-precio.`
  : `${p.titulo}: historial de precio y Sello K-P de calidad-precio. Último precio que vimos: ${pesos(p.precio_actual)}, el ${visto}.`;

// La tarjeta 4:5 del producto (la que se comparte en redes) solo existe
// mientras se publica; si no, la imagen genérica del sitio.
const og = vigente
  ? { ogImage: `/promos/${p.id}.jpg`, ogImageAncho: PROMO_ANCHO, ogImageAlto: PROMO_ALTO }
  : {};

const migas = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: p.titulo, item: new URL(`/p/${p.slug}`, Astro.site).href },
  ],
}).replace(/</g, '\\u003c');
---

<Layout title={`${recortar(p.titulo, 45)} · KalidaPresio`} description={descripcion} {...og}>
  <script type="application/ld+json" set:html={migas} />
  <article class="pp">
    <nav class="pp-migas" aria-label="Estás en">
      <a href="/">Inicio</a> <span aria-hidden="true">›</span> <span>{recortar(p.titulo, 48)}</span>
    </nav>

    {aviso && <p class={`pp-aviso pp-aviso--${pagina.estado}`} role="note">{aviso}</p>}

    <div class="pp-cabeza">
      <div class="pp-foto">
        {p.imagen
          ? <img src={p.imagen} alt={p.titulo} width="320" height="320" loading="eager" fetchpriority="high" />
          : <span class="pp-sinfoto" aria-hidden="true"></span>}
      </div>
      <div class="pp-datos">
        <h1 class="pp-titulo">{p.titulo}</h1>
        <p class="pp-precios">
          <strong>{pesos(p.precio_actual)}</strong>
          {p.precio_previo && <s>{pesos(p.precio_previo)}</s>}
          {p.descuento > 0 && <span class="pp-desc">−{p.descuento} %</span>}
        </p>
        <p class="pp-visto">Precio visto el {visto}{vigente ? ' · confírmalo en Mercado Libre' : ` · hace ${diasDesde} días`}</p>
        <div class="pp-senales">
          {p.rating > 0 && <span class="pp-rating"><Estrellas rating={p.rating} size={14} /> {p.rating.toFixed(1)}</span>}
          {p.vendidos > 0 && <span>{formatearVendidos(p.vendidos)}</span>}
          {p.envio_gratis && <span>Envío gratis</span>}
        </div>
        <div class="pp-sello">
          <SelloKP score={p.score_kalidad_presio} size={64} tooltip tipAlign="start" />
          <span>Sello K-P: <b>{p.score_kalidad_presio}</b> de 100</span>
        </div>
        <BotonCTA
          id={p.id}
          enlace={p.link_afiliado}
          seccion="producto"
          texto={vigente ? 'Ver oferta en Mercado Libre' : 'Ver precio actual en Mercado Libre'}
        />
        <p class="pp-afiliado">Enlace de afiliado: si compras, recibimos una comisión sin costo extra para ti.</p>
      </div>
    </div>

    {p.nota && (
      <section class="pp-bloque">
        <h2>Por qué lo recomendamos</h2>
        <p>{p.nota}</p>
      </section>
    )}

    <section class="pp-bloque">
      <h2>{vigente ? '¿Es buen momento para comprarlo?' : 'Así se ha movido su precio'}</h2>
      {v && v.nivel !== 'sin-datos' && <p class={`pp-veredicto pp-veredicto--${v.nivel}`}>{v.texto}</p>}
      {g ? (
        <>
          <figure class="pp-grafica">
            <svg
              viewBox={`0 0 ${g.ancho} ${g.alto}`}
              role="img"
              aria-label={`Precio observado entre ${pesos(g.minimo)} y ${pesos(g.maximo)}, del ${dia(g.desde)} al ${dia(g.hasta)}`}
            >
              <line class="g-minimo" x1="0" x2={g.ancho} y1={g.yMinimo} y2={g.yMinimo} />
              {g.puntos.filter((pt) => pt.yMax !== pt.yMin).map((pt) => (
                <line class="g-rango" x1={pt.x} x2={pt.x} y1={pt.yMax} y2={pt.yMin} />
              ))}
              <path class="g-linea" d={g.ruta} />
              {ultimo && <circle class="g-ultimo" cx={ultimo.x} cy={ultimo.yMin} r="4" />}
            </svg>
            <figcaption><span>{dia(g.desde)}</span><span>{dia(g.hasta)}</span></figcaption>
          </figure>
          <p class="pp-resumen">
            Lo vimos {serie.length} días: el más bajo, {pesos(g.minimo)}; el más alto, {pesos(g.maximo)}.
            La línea punteada es su mínimo, y donde la línea se corta, no lo observamos.
          </p>
        </>
      ) : (
        <p class="pp-resumen">Todavía no tenemos historial suficiente de su precio: hacen falta al menos dos días observados.</p>
      )}
    </section>

    <section class="pp-bloque">
      <h2>Cómo lo calificamos</h2>
      <p>
        El Sello K-P combina la calificación real de los compradores, el descuento contra el precio anterior
        (con tope, para que un precio inflado no compre puntos) y las unidades vendidas. La fórmula es pública y
        la misma para todos: <a href="/sobre-mi">así se calcula</a>.
      </p>
    </section>

    <p class="pp-mas"><a href="/">Ver todo lo que recomendamos hoy →</a></p>
  </article>
</Layout>

<style>
  .pp { padding-top: var(--spacing-md); max-width: 860px; margin: 0 auto; }

  .pp-migas { font-size: var(--fs-xs); color: var(--color-text-muted); margin-bottom: var(--spacing-sm); }
  .pp-migas a { color: var(--color-text-muted); }

  .pp-aviso {
    margin: 0 0 var(--spacing-md);
    padding: 0.8rem 1rem;
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    line-height: 1.6;
    background: var(--color-warm-bg);
    border: 1px solid var(--color-warm-border);
    color: var(--color-text);
  }

  .pp-cabeza { display: grid; grid-template-columns: 320px 1fr; gap: var(--spacing-lg); align-items: start; }
  .pp-foto img,
  .pp-sinfoto {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    background: #fff;
    border-radius: var(--radius-md);
    display: block;
  }
  .pp-sinfoto { background: var(--color-surface-raised); }

  .pp-titulo { font-family: var(--font-display); font-size: var(--fs-lg); line-height: 1.2; color: #fff; margin: 0 0 0.6rem; }
  .pp-precios { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem; margin: 0 0 0.3rem; }
  .pp-precios strong { font-family: var(--font-display); font-size: var(--fs-xl); color: #fff; line-height: 1; }
  .pp-precios s { color: var(--color-text-muted); }
  .pp-desc { color: var(--color-primary); font-weight: 700; }
  .pp-visto { margin: 0 0 var(--spacing-sm); color: var(--color-text-muted); font-size: var(--fs-xs); }
  .pp-senales { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-bottom: var(--spacing-sm); font-size: var(--fs-sm); color: var(--color-text); }
  .pp-rating { display: inline-flex; align-items: center; gap: 0.35rem; }
  .pp-sello { display: flex; align-items: center; gap: 0.75rem; margin-bottom: var(--spacing-md); font-size: var(--fs-sm); color: var(--color-text-muted); }
  .pp-sello b { color: #fff; }
  .pp-afiliado { margin: 0.6rem 0 0; color: var(--color-text-muted); font-size: var(--fs-xs); }
  /* El botón alineado con el texto de su columna, no centrado en ella. */
  .pp-datos :global(.cta-wrapper) { justify-content: flex-start; margin: 0; }

  .pp-bloque {
    margin-top: var(--spacing-lg);
    background: var(--glass-bg);
    border: 1px solid var(--color-violet-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
  }
  .pp-bloque h2 { font-family: var(--font-display); font-size: var(--fs-md); color: #fff; margin: 0 0 0.6rem; }
  .pp-bloque p { margin: 0; color: var(--color-text); font-size: var(--fs-sm); line-height: 1.7; }
  .pp-bloque a { color: var(--color-primary); }

  /* El color dice el veredicto: verde afirma, ámbar advierte, rojo acusa. */
  .pp-veredicto { font-weight: 700; margin-bottom: 0.75rem !important; }
  .pp-veredicto--minimo, .pp-veredicto--bajo { color: var(--color-primary) !important; }
  .pp-veredicto--alto { color: var(--color-warm) !important; }
  .pp-veredicto--descuento-falso { color: var(--color-error) !important; }

  .pp-grafica { margin: 0 0 0.6rem; }
  .pp-grafica svg { width: 100%; height: auto; display: block; background: rgba(255, 255, 255, 0.03); border-radius: var(--radius-sm); }
  .pp-grafica figcaption { display: flex; justify-content: space-between; color: var(--color-text-muted); font-size: var(--fs-xs); margin-top: 0.3rem; }
  .g-linea { fill: none; stroke: var(--color-primary); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
  .g-rango { stroke: rgba(31, 210, 142, 0.35); stroke-width: 4; stroke-linecap: round; }
  .g-minimo { stroke: var(--color-text-muted); stroke-width: 1; stroke-dasharray: 4 5; opacity: 0.7; }
  .g-ultimo { fill: #fff; stroke: var(--color-primary); stroke-width: 2; }
  .pp-resumen { color: var(--color-text-muted) !important; }

  .pp-mas { text-align: center; margin: var(--spacing-lg) 0 0; }
  .pp-mas a { color: var(--color-primary); font-weight: 600; }

  @media (max-width: 720px) {
    .pp-cabeza { grid-template-columns: 1fr; gap: var(--spacing-md); }
    .pp-foto { max-width: 280px; margin: 0 auto; width: 100%; }
    .pp-bloque { padding: var(--spacing-sm); }
  }
</style>
