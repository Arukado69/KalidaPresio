---
/**
 * /p/<slug> — La página permanente de cada producto de la vitrina.
 *
 * ── POR QUÉ EXISTE ─────────────────────────────────────────────────────────
 * Hasta octubre de 2026 el sitio perdía páginas indexadas cada semana: las
 * colecciones desaparecen al quedarse con pocos productos y la regla de los 7
 * días esconde un precio sin revisar. Esta página se queda (ver
 * src/utils/paginaProducto.js): con la oferta cuando está vigente, y con su
 * historial y un aviso honesto cuando no. Es la que puede aparecer en Google
 * para «<producto> precio» o «<producto> vale la pena».
 *
 * ── LO QUE NO HACE ─────────────────────────────────────────────────────────
 * No presenta como oferta un precio vencido: el aviso va arriba y el
 * veredicto («¿es buen momento?») solo sale si el precio es de hoy. La
 * gráfica no une días que nadie observó.
 */
import Layout from '../../layouts/Layout.astro';
import SelloKP from '../../components/SelloKP.astro';
import Estrellas from '../../components/Estrellas.astro';
import BotonCTA from '../../components/BotonCTA.astro';
import AlertaPrecio from '../../components/AlertaPrecio.astro';
import crudo from '../../data/vitrina.json';
import { paginasDeVitrina, seriePrecios, graficaPrecios } from '../../utils/paginaProducto.js';
import { entradasDe, veredictoDe } from '../../data/historico.js';
import { formatearVendidos } from '../../utils/mlPayload.js';
import { recortar } from '../../utils/publicacion.js';
import { ANCHO as PROMO_ANCHO, ALTO as PROMO_ALTO } from '../../utils/tarjetas.js';

export function getStaticPaths() {
  return paginasDeVitrina(crudo).map((pagina) => ({ params: { slug: pagina.slug }, props: { pagina } }));
}

const { pagina } = Astro.props;
const p = pagina.producto;
const vigente = pagina.estado === 'vigente';

const pesos = (n) =>
  new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(Number(n) || 0);
const fechaMx = (iso) =>
  new Intl.DateTimeFormat('es-MX', { timeZone: 'America/Mexico_City', day: 'numeric', month: 'long' }).format(new Date(iso));
/** Días 'YYYY-MM-DD' del histórico, sin que la zona horaria los mueva. */
const dia = (ymd) => new Intl.DateTimeFormat('es-MX', { timeZone: 'UTC', day: 'numeric', month: 'short' }).format(new Date(`${ymd}T12:00:00Z`));

const claves = p.claves_historico ?? [p.id];
const hoy = new Date().toISOString().slice(0, 10);
const serie = seriePrecios(entradasDe(claves), { hasta: hoy, dias: 90 });
const g = graficaPrecios(serie);
const ultimo = g?.puntos.at(-1);
// El veredicto habla del precio de HOY: con un precio vencido sería adivinar.
const v = vigente ? veredictoDe(claves, p.precio_actual, p.descuento) : null;
// El color del sello del veredicto: verde afirma, azul advierte, rojo acusa.
const TONO_VEREDICTO = { minimo: 'verde', bajo: 'verde', alto: 'azul' };

const visto = fechaMx(p.revisado);
const diasDesde = Math.max(0, Math.floor((Date.now() - Date.parse(p.revisado)) / 86_400_000));
const aviso = pagina.estado === 'retirado'
  ? `Ya no está en nuestra selección${pagina.retirado ? ` (desde el ${fechaMx(pagina.retirado)})` : ''}. La dejamos aquí con su historial de precio.`
  : pagina.estado === 'vencido'
    ? (/relámpago/.test(pagina.motivo ?? '')
      ? 'Esta oferta relámpago ya terminó. Abajo está su historial de precio.'
      : `Este precio lo vimos el ${visto}, hace ${diasDesde} días: puede haber cambiado. Revísalo en Mercado Libre antes de comprar.`)
    : null;

const descripcion = vigente
  ? `${p.titulo}: ${pesos(p.precio_actual)}${p.precio_previo ? ` (antes ${pesos(p.precio_previo)})` : ''}, visto el ${visto}. Su historial de precio y nuestro Sello K-P de calidad-precio.`
  : `${p.titulo}: historial de precio y Sello K-P de calidad-precio. Último precio que vimos: ${pesos(p.precio_actual)}, el ${visto}.`;

// La tarjeta 4:5 del producto (la que se comparte en redes) solo existe
// mientras se publica; si no, la imagen genérica del sitio.
const og = vigente
  ? { ogImage: `/promos/${p.id}.jpg`, ogImageAncho: PROMO_ANCHO, ogImageAlto: PROMO_ALTO }
  : {};

const migas = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: p.titulo, item: new URL(`/p/${p.slug}`, Astro.site).href },
  ],
}).replace(/</g, '\\u003c');
---

<Layout title={`${recortar(p.titulo, 45)} · KalidaPresio`} description={descripcion} {...og}>
  <script type="application/ld+json" set:html={migas} />
  <article class="pp hoja">
    <nav class="pp-migas etiqueta" aria-label="Estás en">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span> <span>{recortar(p.titulo, 48)}</span>
    </nav>

    {aviso && (
      <p class={`pp-aviso pp-aviso--${pagina.estado}`} role="note">
        <b class="etiqueta">{pagina.estado === 'retirado' ? 'Ya no la recomendamos' : 'Precio sin revisar'}</b>
        {aviso}
      </p>
    )}

    <div class="pp-cabeza">
      <!-- La foto, pegada con cinta; el Sello K-P va estampado encima. -->
      <figure class="pp-foto cartulina cartulina--blanca con-cinta">
        {p.imagen
          ? <img src={p.imagen} alt={p.titulo} width="420" height="420" loading="eager" fetchpriority="high" />
          : <span class="pp-sinfoto etiqueta" aria-hidden="true">sin foto</span>}
        <span class="pp-foto-sello"><SelloKP score={p.score_kalidad_presio} size={108} /></span>
      </figure>

      <div class="pp-datos">
        <h1 class="pp-titulo">{p.titulo}</h1>

        <div class:list={['pp-precio', 'cartulina', 'con-cinta', { 'cartulina--blanca': !vigente }]}>
          <span class="etiqueta">{vigente ? 'Precio de hoy' : 'Último precio que vimos'}</span>
          <strong class="pp-monto plumon">{pesos(p.precio_actual)}</strong>
          {(p.precio_previo || p.descuento > 0) && (
            <span class="pp-antes">
              {p.precio_previo && <>antes <s class="tache">{pesos(p.precio_previo)}</s></>}
              {p.descuento > 0 && <b class="pp-desc">−{p.descuento}%</b>}
            </span>
          )}
          {!vigente && (
            <span class="pp-vencido sello">{pagina.estado === 'retirado' ? 'Retirado' : 'Vencido'}</span>
          )}
        </div>

        <p class="pp-visto etiqueta">
          Precio visto el {visto}{vigente ? ' · confírmalo en Mercado Libre' : ` · hace ${diasDesde} días`}
        </p>

        <BotonCTA
          id={p.id}
          enlace={p.link_afiliado}
          seccion="producto"
          texto={vigente ? 'Ver oferta en Mercado Libre' : 'Ver precio actual en Mercado Libre'}
        />
        <p class="pp-afiliado">Enlace de afiliado: si compras, recibimos una comisión sin costo extra para ti.</p>

        {p.nota && (
          <section class="pp-nota" aria-labelledby="pp-nota-h">
            <h2 id="pp-nota-h" class="pp-nota-h plumon">¿Por qué este?</h2>
            <p>{p.nota}</p>
          </section>
        )}
      </div>
    </div>

    <div class="pp-cuerpo">
      <!-- La ficha en ticket: los datos duros, sin adjetivos. -->
      <section class="pp-ficha ticket" aria-labelledby="pp-ficha-h">
        <h2 id="pp-ficha-h" class="pp-ficha-h">KalidaPresio · ficha</h2>
        <hr />
        <p class="renglon"><span>{vigente ? 'Precio hoy' : 'Último precio'}</span><span>{pesos(p.precio_actual)}</span></p>
        {p.precio_previo && <p class="renglon"><span>Antes</span><span>{pesos(p.precio_previo)}</span></p>}
        {p.descuento > 0 && <p class="renglon"><span>Descuento</span><span>−{p.descuento}%</span></p>}
        <p class="renglon"><span>Visto el</span><span>{visto}</span></p>
        {p.rating > 0 && (
          <p class="renglon"><span>Calificación</span><span class="pp-estrellas"><Estrellas rating={p.rating} size={12} /> {p.rating.toFixed(1)}</span></p>
        )}
        {p.vendidos > 0 && <p class="renglon"><span>Vendidos</span><span>{formatearVendidos(p.vendidos).replace(/\s*vendidos?$/i, '')}</span></p>}
        {p.envio_gratis && <p class="renglon"><span>Envío</span><span>Gratis</span></p>}
        {serie.length > 0 && <p class="renglon"><span>Días observado</span><span>{serie.length}</span></p>}
        <hr />
        <p class="renglon pp-ficha-total"><span>Sello K-P</span><span>{p.score_kalidad_presio}/100</span></p>
      </section>

      <section class="pp-historial" aria-labelledby="pp-hist-h">
        <h2 id="pp-hist-h" class="pp-h2">{vigente ? '¿Es buen momento para comprarlo?' : 'Así se ha movido su precio'}</h2>
        {v && v.nivel !== 'sin-datos' && (
          v.nivel === 'siguiendo'
            ? <p class="pp-siguiendo etiqueta">{v.texto}</p>
            : <p class={`pp-veredicto sello sello--doble ${TONO_VEREDICTO[v.nivel] ?? ''}`}>{v.texto}</p>
        )}
        {g ? (
          <>
            <figure class="pp-grafica">
              <div class="pp-lienzo">
                <svg
                  viewBox={`0 0 ${g.ancho} ${g.alto}`}
                  role="img"
                  aria-label={`Precio observado entre ${pesos(g.minimo)} y ${pesos(g.maximo)}, del ${dia(g.desde)} al ${dia(g.hasta)}`}
                >
                  <line class="g-minimo" x1="0" x2={g.ancho} y1={g.yMinimo} y2={g.yMinimo} />
                  {g.puntos.filter((pt) => pt.yMax !== pt.yMin).map((pt) => (
                    <line class="g-rango" x1={pt.x} x2={pt.x} y1={pt.yMax} y2={pt.yMin} />
                  ))}
                  <path class="g-linea" d={g.ruta} />
                  {ultimo && <circle class="g-ultimo" cx={ultimo.x} cy={ultimo.yMin} r="6" />}
                </svg>
                <span class="g-nota-min plumon" style={`top:${((g.yMinimo / g.alto) * 100).toFixed(1)}%`} aria-hidden="true">
                  mín. {pesos(g.minimo)}
                </span>
              </div>
              <figcaption class="etiqueta"><span>{dia(g.desde)}</span><span>{dia(g.hasta)}</span></figcaption>
            </figure>
            <p class="pp-resumen">
              Lo vimos {serie.length} días: el más bajo, {pesos(g.minimo)}; el más alto, {pesos(g.maximo)}.
              La línea punteada es su mínimo, y donde la línea se corta, no lo observamos.
            </p>
          </>
        ) : (
          <p class="pp-resumen">Todavía no tenemos historial suficiente de su precio: hacen falta al menos dos días observados.</p>
        )}
      </section>
    </div>

    <!-- «Avísame cuando baje»: solo de lo que seguimos. Un retirado ya no se
         revisa, así que nunca habría un precio nuevo con qué avisar. -->
    {pagina.estado !== 'retirado' && (
      <AlertaPrecio productoId={p.id} precio={p.precio_actual} minimo={g?.minimo ?? null} vigente={vigente} />
    )}

    <section class="pp-como" aria-labelledby="pp-como-h">
      <h2 id="pp-como-h" class="pp-h2">Cómo lo calificamos</h2>
      <p>
        El Sello K-P combina la calificación real de los compradores, el descuento contra el precio anterior
        (con tope, para que un precio inflado no compre puntos) y las unidades vendidas. La fórmula es pública y
        la misma para todos: <a href="/sobre-mi">así se calcula</a>.
      </p>
      <a class="boton boton--papel boton--chico" href="/">Ver todo lo que recomendamos hoy</a>
    </section>
  </article>
</Layout>

<style>
  .pp { padding-block: clamp(1.2rem, 3vw, 2rem) 0; }
  .pp-migas { margin: 0 0 1.4rem; }
  .pp-migas a { color: inherit; }

  /* El aviso de precio viejo o producto retirado: va primero y no se disimula. */
  .pp-aviso {
    display: grid;
    gap: 0.3rem;
    margin: 0 0 2rem;
    padding: 0.9rem 1.1rem;
    max-width: 760px;
    background: var(--cartulina);
    border: 2px dashed var(--sello-rojo);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .pp-aviso .etiqueta { color: var(--sello-rojo); }

  .pp-cabeza {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .pp-foto { --giro: -1.4deg; margin: 0; padding: 1rem; }
  .pp-foto img,
  .pp-sinfoto { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; display: block; background: #fff; }
  .pp-sinfoto { display: grid; place-items: center; background: var(--papel-2); color: var(--tinta-3); }
  .pp-foto-sello { position: absolute; right: -14px; bottom: -22px; z-index: 3; }

  .pp-titulo { font-size: clamp(2.1rem, 4.6vw, 3.6rem); text-transform: uppercase; margin: 0 0 1.6rem; }

  .pp-precio {
    --giro: 1.2deg;
    display: inline-grid;
    justify-items: start;
    gap: 0.15rem;
    padding: 1.2rem 1.4rem 1.1rem;
    margin-bottom: 0.9rem;
    min-width: min(100%, 320px);
  }
  .pp-precio .etiqueta { color: var(--tinta); }
  .pp-monto { font-size: clamp(2.8rem, 7vw, 4.4rem); line-height: 1.05; }
  .pp-antes { display: inline-flex; align-items: baseline; gap: 0.7rem; font: 600 0.95rem/1.3 var(--f-ticket); }
  .pp-antes .tache { color: var(--tinta); }
  .pp-desc { font: 900 1.6rem/1 var(--f-rotulo); }
  .pp-vencido { position: absolute; top: 16%; right: -0.6rem; --giro: -14deg; font-size: 1.5rem; background: rgba(255, 252, 244, 0.55); }

  .pp-visto { margin: 0 0 1.4rem; }
  .pp-afiliado { margin: 0.9rem 0 0; color: var(--tinta-2); font-size: 0.82rem; }

  .pp-nota { margin-top: 2rem; padding: 1.1rem 1.2rem 1.2rem; border-left: 5px solid var(--fosfo); background: var(--cartulina); box-shadow: var(--sombra-papel); }
  .pp-nota-h { font-size: 1.35rem; margin: 0 0 0.4rem; color: var(--sello-rojo); }
  .pp-nota p { margin: 0; }

  .pp-cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 2px solid var(--tinta);
  }

  .pp-ficha { --giro: -1deg; transform: rotate(var(--giro)); font-size: 0.78rem; text-transform: uppercase; }
  .pp-ficha p { margin: 0; }
  .pp-ficha-h { font: 600 0.8rem/1.4 var(--f-ticket); letter-spacing: 0.08em; text-align: center; }
  .pp-ficha .renglon > span:last-child { text-align: right; font-weight: 600; }
  .pp-ficha-total { font-size: 0.95rem; }
  .pp-estrellas { display: inline-flex; align-items: center; gap: 0.4em; }

  .pp-h2 { font-size: clamp(2rem, 4.5vw, 3rem); text-transform: uppercase; margin: 0 0 1rem; }

  /* El veredicto es un sello: verde afirma, azul advierte, rojo acusa. */
  .pp-veredicto { --giro: -2deg; font-size: clamp(1.05rem, 2.4vw, 1.4rem); margin: 0.4rem 0 1.4rem; max-width: 100%; white-space: normal; }
  .pp-veredicto.verde { color: var(--sello-verde); }
  .pp-veredicto.azul { color: var(--sello-azul); }
  .pp-siguiendo { margin: 0 0 1rem; }

  /* La gráfica sobre papel milimétrico. */
  .pp-grafica { margin: 0 0 0.9rem; }
  .pp-lienzo {
    position: relative;
    padding: 0.8rem;
    border: 2px solid var(--tinta);
    background-color: var(--cartulina);
    background-image:
      linear-gradient(rgba(29, 64, 184, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(29, 64, 184, 0.12) 1px, transparent 1px),
      linear-gradient(rgba(29, 64, 184, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(29, 64, 184, 0.05) 1px, transparent 1px);
    background-size: 40px 40px, 40px 40px, 8px 8px, 8px 8px;
    background-position: -1px -1px;
  }
  .pp-lienzo svg { width: 100%; height: auto; display: block; overflow: visible; }
  .g-linea { fill: none; stroke: var(--tinta); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }
  .g-rango { stroke: var(--fosfo-rosa); stroke-width: 7; stroke-linecap: round; opacity: 0.75; }
  .g-minimo { stroke: var(--sello-rojo); stroke-width: 2; stroke-dasharray: 6 7; }
  .g-ultimo { fill: var(--fosfo); stroke: var(--tinta); stroke-width: 3; }
  /* La anotación a mano junto a la línea del mínimo. */
  .g-nota-min {
    position: absolute;
    right: 1.2rem;
    transform: translateY(-115%) rotate(-3deg);
    color: var(--sello-rojo);
    font-size: 1.05rem;
    background: rgba(255, 252, 244, 0.85);
    padding: 0 0.3rem;
    pointer-events: none;
  }
  .pp-grafica figcaption { display: flex; justify-content: space-between; margin-top: 0.4rem; }
  .pp-resumen { color: var(--tinta-2); max-width: 62ch; }

  .pp-como { margin-top: clamp(3rem, 7vw, 4.5rem); max-width: 760px; }
  .pp-como p { color: var(--tinta-2); margin-bottom: 1.4rem; }
  .pp-como a:not(.boton) { font-weight: 700; }

  @media (max-width: 860px) {
    .pp-cabeza,
    .pp-cuerpo { grid-template-columns: 1fr; }
    .pp-foto { max-width: 360px; width: 100%; margin-inline: auto; }
    .pp-ficha { max-width: 420px; }
    .pp-cuerpo > .pp-historial { order: -1; }
  }
  @media (max-width: 520px) {
    /* Sin margen a los lados, el sello se queda dentro de la hoja. */
    .pp-foto-sello { right: -2px; bottom: -28px; }
  }
</style>
