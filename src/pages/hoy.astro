---
/**
 * /hoy — Tu «link en bio»: las ofertas de hoy, cada una con su código fijo.
 *
 * ── POR QUÉ EXISTE ─────────────────────────────────────────────────────────
 * Instagram y TikTok no dejan poner links en las publicaciones: el único link
 * que se toca es el del perfil. Esta página es ese link. Cada producto lleva
 * su CÓDIGO FIJO en grande («K-17»), el mismo que sale en el panel de
 * publicación y en las imágenes verticales, para que un video pueda decir
 * «busca el K-17 en mi perfil» y la persona lo encuentre en un segundo.
 *
 * ── UN LINK DE PERFIL POR RED ──────────────────────────────────────────────
 * Pon /hoy?c=ig en Instagram y /hoy?c=tt en TikTok. Con eso:
 *   · si generaste un link con la etiqueta de esa red (enlaces.ig / .tt en la
 *     vitrina), los botones usan ESE link, y tu panel de Mercado Libre separa
 *     las ventas por red;
 *   · el clic llega a Umami con su canal.
 *
 * El código NO cambia cuando actualizas la vitrina (antes se numeraba por
 * posición y «el #3» de un video viejo terminaba en otro producto). Además,
 * /k/17 lleva directo a la página del producto, aunque ya no esté aquí.
 */
import Layout from '../layouts/Layout.astro';
import { VITRINA } from '../data/ofertas.js';
import { ordenParaPublicar } from '../utils/vitrina.js';
import { categorizar } from '../utils/categorias.js';
import { CODIGOS_CANAL } from '../utils/canales.js';
import { formatoCodigo, anclaCodigo } from '../utils/codigos.js';
import { pesos } from '../utils/pesos.js';

// Cada producto se busca por su CÓDIGO FIJO («K-17», src/utils/codigos.js): no
// cambia cuando cambia la vitrina, así que un video viejo sigue apuntando al
// producto correcto. Si una entrada no tiene código (la escribieron a mano),
// cae a su posición, como antes.
const productos = ordenParaPublicar(VITRINA).map((p, i) => ({
  ...p,
  numero: i + 1,
  etiqueta: formatoCodigo(p.codigo) ?? `#${i + 1}`,
  ancla: anclaCodigo(p.codigo) ?? `n${i + 1}`,
}));
const visto = (iso) => new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'short', timeZone: 'America/Mexico_City' }).format(new Date(iso));
---

<Layout
  title="Ofertas de hoy — KalidaPresio"
  description="Las ofertas de Mercado Libre que recomendamos hoy, numeradas: busca el número que viste en nuestras historias y videos."
>
  <article class="hoy hoja" data-hoy data-canales={CODIGOS_CANAL.join(',')}>
    <header class="hoy-cabeza">
      <p class="etiqueta">Link en bio · KalidaPresio</p>
      <h1 class="hoy-titulo">Las de hoy, <span class="hoy-con plumon">con su código</span></h1>
      <p class="hoy-sub">¿Viste un código como <b>K-17</b> en una historia o un video? Búscalo aquí.</p>
      {productos.length > 1 && (
        <nav class="hoy-saltos" aria-label="Ir al código">
          {/* En orden de código: quien busca el K-12 lo encuentra de un vistazo. */}
          {[...productos]
            .sort((a, b) => (a.codigo ?? Infinity) - (b.codigo ?? Infinity) || a.numero - b.numero)
            .map((p) => <a class="hoy-salto" href={`#${p.ancla}`}>{p.etiqueta}</a>)}
        </nav>
      )}
    </header>

    {productos.length === 0 ? (
      <div class="hoy-vacio cartulina cartulina--blanca con-cinta">
        <p class="hoy-vacio-h rotulo">Estamos eligiendo las de hoy</p>
        <p>Cada oferta lleva un código fijo (como K-17) para que la encuentres desde nuestras historias. Mientras, <a href="/">mira la portada</a>.</p>
      </div>
    ) : (
      <ol class="hoy-lista">
        {productos.map((p) => (
          <li class="hoy-item anima-pegar" id={p.ancla} data-caduca={p.caduca ?? ''} style={`--i:${Math.min(p.numero, 8)}`}>
            <span class="hoy-num" aria-label={`Código ${p.etiqueta}`}>{p.etiqueta}</span>
            <div class="hoy-foto">
              {p.imagen ? <img src={p.imagen} alt={p.titulo} loading={p.numero <= 3 ? 'eager' : 'lazy'} /> : <span class="hoy-sin-foto" aria-hidden="true">{categorizar(p.titulo) !== 'Otros' ? categorizar(p.titulo) : 'Oferta'}</span>}
            </div>
            <div class="hoy-info">
              {p.oferta_relampago && (
                <span class="hoy-relampago etiqueta">⚡ Relámpago{p.fin_oferta && <> · termina en <strong data-hoy-fin={p.fin_oferta}>—</strong></>}</span>
              )}
              <h2 class="hoy-nombre">{p.titulo}</h2>
              {p.nota && <p class="hoy-nota">{p.nota}</p>}
              <p class="hoy-precios">
                <span class="hoy-precio plumon">{pesos(p.precio_actual)}</span>
                {p.precio_previo && <s class="hoy-antes tache">{pesos(p.precio_previo)}</s>}
                {p.descuento > 0 && <b class="hoy-desc">−{p.descuento}%</b>}
              </p>
              <a
                class="hoy-cta boton boton--chico"
                href={p.link_afiliado}
                data-ml-id={p.id}
                data-kp-seccion="hoy"
                data-posicion={p.numero}
                data-precio={p.precio_actual}
                data-kp={p.score_kalidad_presio}
                data-descuento={p.descuento}
                data-cat={categorizar(p.titulo)}
                {...Object.fromEntries(Object.entries(p.enlaces ?? {}).map(([c, l]) => [`data-enlace-${c}`, l]))}
                target="_blank"
                rel="nofollow sponsored noopener noreferrer"
              >Ver en Mercado Libre <span aria-hidden="true">→</span></a>
              <p class="hoy-visto etiqueta">
                Visto el {visto(p.revisado)} · confírmalo en Mercado Libre ·
                <a href={`/p/${p.slug}`}>historial</a> ·
                <a href={`/p/${p.slug}#alerta`}>avísame si baja</a>
              </p>
            </div>
          </li>
        ))}
      </ol>
    )}

    <p class="hoy-aviso">
      Enlaces de afiliado: si compras, KalidaPresio recibe una comisión sin costo extra para ti. La comisión no
      cambia qué recomendamos.
    </p>
  </article>
</Layout>

<script>
  function iniciarHoy() {
    const raiz = document.querySelector('[data-hoy]') as HTMLElement | null;
    if (!raiz) return;
    const canales = (raiz.dataset.canales || '').split(',');
    const c = new URLSearchParams(location.search).get('c')?.toLowerCase() ?? '';

    // ?c=ig → link con la etiqueta de Instagram si existe, y el canal en Umami.
    if (canales.includes(c)) {
      raiz.setAttribute('data-kp-canal', c);
      raiz.querySelectorAll('a.hoy-cta').forEach((a) => {
        const propio = a.getAttribute(`data-enlace-${c}`);
        if (propio) a.setAttribute('href', propio);
      });
    }

    // Retira lo vencido y lleva la cuenta regresiva de las relámpago.
    const p2 = (n: number) => String(n).padStart(2, '0');
    const tic = () => {
      const ahora = Date.now();
      raiz.querySelectorAll('[data-caduca]').forEach((li) => {
        const fin = Date.parse(li.getAttribute('data-caduca') || '');
        if (fin && fin <= ahora) (li as HTMLElement).hidden = true;
      });
      raiz.querySelectorAll('[data-hoy-fin]').forEach((el) => {
        const ms = Date.parse(el.getAttribute('data-hoy-fin') || '') - ahora;
        if (ms > 0) {
          const s = Math.floor(ms / 1000);
          el.textContent = `${p2(Math.floor(s / 3600))}:${p2(Math.floor((s % 3600) / 60))}:${p2(s % 60)}`;
        }
      });
    };
    tic();
    setInterval(tic, 1000);

    // Si llegaron con #k17 en la URL (o la /k/17 de un video), se resalta ese producto.
    const destino = location.hash ? document.querySelector(location.hash) : null;
    destino?.classList.add('hoy-item--destino');
    window.addEventListener('hashchange', () => {
      raiz.querySelectorAll('.hoy-item--destino').forEach((el) => el.classList.remove('hoy-item--destino'));
      const nuevo = location.hash ? document.querySelector(location.hash) : null;
      nuevo?.classList.add('hoy-item--destino');
    });
  }
  // Script de módulo: corre una vez, con el HTML ya leído. (El sitio ya no usa
  // View Transitions, así que no hay astro:page-load que esperar.)
  iniciarHoy();
</script>

<style>
  .hoy { max-width: 760px; padding-block: clamp(1.5rem, 4vw, 2.5rem) 0; }
  .hoy-cabeza { margin-bottom: clamp(2rem, 5vw, 3rem); }
  .hoy-titulo { font-size: clamp(2.8rem, 9vw, 5rem); text-transform: uppercase; margin: 0.5rem 0 0.8rem; }
  .hoy-con { display: inline-block; text-transform: none; color: var(--sello-rojo); font-size: 0.62em; transform: rotate(-4deg) translateY(-0.1em); }
  .hoy-sub { color: var(--tinta-2); margin-bottom: 1.2rem; }

  /* Los números como botones de elevador: tocas el 3 y bajas al 3. */
  .hoy-saltos { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .hoy-salto {
    display: grid;
    place-items: center;
    min-width: 2.6rem;
    height: 2.6rem;
    padding: 0 0.7rem;
    border: 2px solid var(--tinta);
    border-radius: 999px;
    background: var(--cartulina);
    font: 900 1.15rem/1 var(--f-rotulo);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 2px 2px 0 var(--tinta);
  }
  .hoy-salto:hover { background: var(--fosfo); }

  .hoy-vacio { --giro: -0.8deg; padding: clamp(1.4rem, 4vw, 2.2rem); }
  .hoy-vacio-h { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 0.5rem; }
  .hoy-vacio a { font-weight: 700; }

  .hoy-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.2rem; }
  .hoy-item {
    --giro: 0deg;
    position: relative;
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.2rem;
    padding: 1.2rem 1.2rem 1.2rem 1.4rem;
    background: var(--cartulina);
    border: 2px solid var(--tinta);
    box-shadow: 5px 5px 0 var(--tinta);
    scroll-margin-top: 1.5rem;
  }
  .hoy-item:nth-child(even) { --giro: 0.5deg; }
  .hoy-item:nth-child(odd) { --giro: -0.5deg; }
  .hoy-item { transform: rotate(var(--giro)); }
  .hoy-item--destino { background: #fffde0; box-shadow: 5px 5px 0 var(--tinta), 0 0 0 6px var(--fosfo); }

  /* El número, gigante y pegado como cartulina: es lo que se busca. */
  .hoy-num {
    position: absolute;
    top: -1.1rem;
    left: -1rem;
    z-index: 2;
    min-width: 3.4rem;
    padding: 0.25rem 0.6rem 0.15rem;
    background: var(--fosfo);
    border: 2px solid var(--tinta);
    font: 900 2.4rem/1 var(--f-rotulo);
    text-align: center;
    transform: rotate(-6deg);
  }

  .hoy-foto { aspect-ratio: 1; background: #fff; border: 1.5px solid var(--linea); }
  .hoy-foto img { width: 100%; height: 100%; object-fit: contain; padding: 8px; }
  .hoy-sin-foto { display: grid; place-items: center; height: 100%; background: repeating-linear-gradient(-45deg, var(--papel-2) 0 10px, var(--papel) 10px 20px); font: 900 1.05rem/1 var(--f-rotulo); text-transform: uppercase; color: var(--tinta-3); }

  .hoy-info { display: flex; flex-direction: column; gap: 0.45rem; min-width: 0; }
  .hoy-relampago { align-self: flex-start; background: var(--fosfo-naranja); color: var(--tinta); padding: 0.2rem 0.5rem; }
  .hoy-relampago strong { font-variant-numeric: tabular-nums; }
  .hoy-nombre { font: 700 1.05rem/1.3 var(--f-texto); display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .hoy-nota { margin: 0; font-size: 0.9rem; color: var(--tinta-2); }
  .hoy-precios { margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.3rem 0.8rem; }
  .hoy-precio { font-size: 2rem; line-height: 1.1; }
  .hoy-antes { font: 600 0.9rem/1 var(--f-ticket); }
  .hoy-desc { font: 900 1.2rem/1 var(--f-rotulo); color: var(--sello-rojo); }
  .hoy-cta { align-self: flex-start; margin-top: 0.2rem; }
  .hoy-visto { margin: 0.2rem 0 0; font-size: 0.64rem; }
  .hoy-visto a { color: var(--tinta); }

  .hoy-aviso { margin-top: 2.6rem; font-size: 0.82rem; color: var(--tinta-2); }

  @media (max-width: 520px) {
    .hoy-item { grid-template-columns: 96px minmax(0, 1fr); gap: 0.9rem; padding: 1rem; }
    .hoy-precio { font-size: 1.6rem; }
    .hoy-num { font-size: 2rem; }
  }
</style>
