---
/**
 * Estrellas — La calificación de los compradores, en tinta.
 * Cinco estrellas de contorno y, encima, las rellenas recortadas al puntaje.
 */
export interface Props {
  rating: number;
  size?: number;
}

const { rating, size = 16 } = Astro.props;
const r = Math.max(0, Math.min(5, Number(rating) || 0));
const pct = (r / 5) * 100;
---

<span class="estrellas" style={`--tam:${size}px`} role="img" aria-label={`${r.toFixed(1)} de 5 estrellas`}>
  <span class="e-fondo" aria-hidden="true">★★★★★</span>
  <span class="e-lleno" aria-hidden="true" style={`width:${pct}%`}>★★★★★</span>
</span>

<style>
  .estrellas { position: relative; display: inline-block; font-size: var(--tam); line-height: 1; letter-spacing: 0.06em; white-space: nowrap; }
  .e-fondo { color: transparent; -webkit-text-stroke: 1.2px var(--tinta); }
  .e-lleno { position: absolute; inset: 0 auto 0 0; overflow: hidden; color: var(--tinta); }
</style>
