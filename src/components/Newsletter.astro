---
/**
 * Newsletter — Suscripción con doble opt-in (SIN login, SIN BD propia).
 * Front: input + botón, honeypot anti-bots, validación en cliente, estados
 * (enviando/éxito/error) vía fetch (NO <form> que recargue). El backend
 * (/api/subscribe) firma un token HMAC y manda el correo de confirmación.
 *
 * Diseño: una cartulina rosa pegada con cinta, con el correo escrito como en
 * un ticket. El script depende de los atributos data-nl-* y de .nl-btn-txt.
 */
---
<section class="nl hoja" aria-labelledby="nl-titulo" data-newsletter>
  <div class="nl-cartulina cartulina cartulina--rosa con-cinta">
    <div class="nl-copy">
      <p class="etiqueta nl-eyebrow">Gratis · sin spam · baja en un clic</p>
      <h2 id="nl-titulo" class="nl-titulo">Te avisamos cuando <span class="plumon">sí</span> valga la pena</h2>
      <p class="nl-sub">De vez en cuando, las ofertas que pasaron el Sello K-P y los descuentos que resultaron puro cuento.
        Te pedimos confirmar por correo, y cada envío trae su enlace de baja.</p>
    </div>

    <div class="nl-form">
      <div class="nl-row">
        <label for="nl-email" class="nl-label-sr">Correo electrónico</label>
        <input id="nl-email" type="email" inputmode="email" autocomplete="email"
               class="nl-input" placeholder="tu@correo.com" data-nl-email required />
        <!-- Honeypot: oculto para humanos, los bots lo rellenan -->
        <div class="nl-hp" aria-hidden="true">
          <label>No llenar este campo
            <input type="text" name="website" tabindex="-1" autocomplete="off" data-nl-hp />
          </label>
        </div>
        <button type="button" class="boton boton--tinta nl-btn" data-nl-submit>
          <span class="nl-btn-txt">Suscribirme</span>
        </button>
      </div>
      <p class="nl-status" data-nl-status role="status" aria-live="polite" hidden></p>
      <p class="nl-legal">Al suscribirte aceptas nuestro <a href="/privacidad">aviso de privacidad</a>.</p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function bind(root) {
      const wrap = root.querySelector('[data-newsletter]') || (root.matches?.('[data-newsletter]') ? root : null);
      document.querySelectorAll('[data-newsletter]:not([data-nl-bound])').forEach((nl) => {
        nl.setAttribute('data-nl-bound', '');
        const email = nl.querySelector('[data-nl-email]');
        const hp = nl.querySelector('[data-nl-hp]');
        const btn = nl.querySelector('[data-nl-submit]');
        const status = nl.querySelector('[data-nl-status]');
        const txt = btn.querySelector('.nl-btn-txt');

        const setStatus = (msg, tipo) => {
          status.textContent = msg;
          status.hidden = !msg;
          status.dataset.tipo = tipo || '';
        };
        const validar = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test((v || '').trim());

        async function enviar() {
          const valor = email.value.trim();
          if (!validar(valor)) { setStatus('Escribe un correo válido.', 'error'); email.focus(); return; }
          btn.disabled = true;
          txt.textContent = 'Enviando…';
          setStatus('', '');
          try {
            const res = await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email: valor, honeypot: hp ? hp.value : '' }),
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.ok) {
              setStatus('Te mandamos un correo para confirmar. Ábrelo y listo (revisa spam por si acaso).', 'ok');
              // Conversión del boletín. El componente no conoce la herramienta
              // de analítica: solo anuncia lo que pasó (ver Analitica.astro).
              document.dispatchEvent(new CustomEvent('kp:evento', {
                detail: { nombre: 'boletin-alta', datos: { paso: 'correo-enviado' } },
              }));
              email.value = '';
              txt.textContent = 'Revisa tu correo';
            } else {
              const m = data.error === 'email_invalido' ? 'Ese correo no parece válido.'
                : 'No pudimos completar la suscripción. Intenta de nuevo en un momento.';
              setStatus(m, 'error');
              txt.textContent = 'Suscribirme';
              btn.disabled = false;
            }
          } catch {
            setStatus('Hubo un problema de conexión. Intenta de nuevo.', 'error');
            txt.textContent = 'Suscribirme';
            btn.disabled = false;
          }
        }

        btn.addEventListener('click', enviar);
        email.addEventListener('keydown', (e) => { if (e.key === 'Enter') enviar(); });
      });
    }
    // Bind al cargar (idempotente por la marca data-nl-bound).
    if (document.readyState !== 'loading') bind(document);
    else document.addEventListener('DOMContentLoaded', () => bind(document));
  })();
</script>

<style>
  .nl { margin-top: clamp(3rem, 8vw, 5.5rem); }
  .nl-cartulina {
    --giro: -0.8deg;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.2rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.6rem, 4vw, 2.8rem);
  }
  .nl-eyebrow { color: var(--tinta); margin-bottom: 0.6rem; }
  /* Interlineado más holgado que otros títulos: el acento de «sí» a plumón es
     alto y, apretado, se metía en el renglón de arriba. */
  .nl-titulo { font-size: clamp(2.2rem, 5.5vw, 3.6rem); line-height: 1.06; text-transform: uppercase; margin-bottom: 0.7rem; }
  .nl-titulo .plumon { display: inline-block; text-transform: none; font-size: 0.95em; margin-right: 0.12em; color: var(--tinta); }
  .nl-sub { margin: 0; max-width: 46ch; font-size: 0.98rem; }

  .nl-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .nl-label-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
  .nl-input {
    flex: 1 1 220px;
    min-width: 0;
    padding: 0.9rem 1rem;
    border: 2.5px solid var(--tinta);
    border-radius: 999px;
    background: var(--cartulina);
    color: var(--tinta);
    font: 500 1rem var(--f-ticket);
  }
  .nl-input::placeholder { color: var(--tinta-3); }
  .nl-input:focus { outline: 3px solid var(--tinta); outline-offset: 2px; }
  .nl-btn { flex: 0 0 auto; }
  .nl-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .nl-status { margin: 0.8rem 0 0; font: 600 0.82rem/1.5 var(--f-ticket); }
  .nl-status[data-tipo="ok"] { color: var(--tinta); }
  .nl-status[data-tipo="error"] { color: var(--tinta); text-decoration: underline wavy var(--tinta); }
  .nl-legal { margin: 0.8rem 0 0; font-size: 0.8rem; }

  @media (max-width: 760px) {
    .nl-cartulina { grid-template-columns: 1fr; }
  }
</style>
