---
/**
 * Header — La marquesina de avisos y el rótulo del puesto.
 *
 * La marquesina dice en una línea lo que el sitio promete; el rótulo es el
 * nombre pintado a mano encima del puesto. El menú no se esconde detrás de una
 * hamburguesa: en el celular se desliza de lado, siempre a la vista.
 */
import { enTemporada } from '../data/buenFin.js';

// El enlace al Detector solo durante la temporada; el build diario lo quita solo.
const temporadaBuenFin = enTemporada();

const avisos = [
  'Ofertas de Mercado Libre elegidas a mano',
  'Te decimos cuándo el descuento es puro cuento',
  'Cada precio con la fecha en que lo vimos',
  'El Sello K-P no se vende',
  ...(temporadaBuenFin ? ['Buen Fin: 13 al 17 de noviembre · detector de descuentos falsos'] : []),
];
---

<header class="cabecera">
  <div class="marquesina" aria-hidden="true">
    <div class="marquesina-pista">
      {[...avisos, ...avisos].map((a) => <span>{a}</span>)}
    </div>
  </div>

  <div class="hoja cabecera-in">
    <a href="/" class="marca" aria-label="KalidaPresio — Inicio">
      <span class="marca-k" aria-hidden="true">K</span>
      <span class="marca-txt rotulo">Kalida<b>Presio</b></span>
    </a>

    <nav class="menu" aria-label="Principal" data-menu>
      <a href="/">Inicio</a>
      <a href="/hoy">Hoy</a>
      <a href="/ofertas">Por presupuesto</a>
      {temporadaBuenFin && <a href="/buen-fin" class="menu-temporada">Buen Fin</a>}
      <a href="/sobre-mi">Cómo calificamos</a>
      <a href="/contacto">Contacto</a>
    </nav>
  </div>
</header>

<style>
  .cabecera { position: relative; z-index: 20; border-bottom: 2px solid var(--tinta); background: var(--papel); }

  .cabecera-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 0.9rem;
    flex-wrap: wrap;
  }

  .marca { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--tinta); }
  /* La K en cartulina, como etiqueta de precio */
  .marca-k {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    background: var(--fosfo);
    border: 2.5px solid var(--tinta);
    border-radius: 6px;
    font: 900 1.7rem/1 var(--f-rotulo);
    transform: rotate(-6deg);
    box-shadow: 3px 3px 0 var(--tinta);
    transition: transform 0.2s ease;
  }
  .marca:hover .marca-k { transform: rotate(4deg) scale(1.05); }
  .marca-txt { font-size: clamp(1.7rem, 4vw, 2.2rem); letter-spacing: 0.01em; }
  .marca-txt b { font-weight: 900; color: var(--sello-rojo); }

  .menu { display: flex; align-items: center; gap: 0.3rem 1.3rem; font-weight: 700; font-size: 0.98rem; }
  .menu a { text-decoration: none; padding: 0.3rem 0; border-bottom: 3px solid transparent; white-space: nowrap; }
  .menu a:hover { border-bottom-color: var(--fosfo-rosa); }
  .menu a[aria-current="page"] { border-bottom-color: var(--tinta); }
  .menu-temporada { background: var(--fosfo); padding: 0.25rem 0.6rem !important; border: 2px solid var(--tinta) !important; border-radius: 999px; }

  /* Celular: el menú se desliza de lado, a la vista (sin hamburguesa). */
  @media (max-width: 760px) {
    .cabecera-in { padding-bottom: 0; }
    .menu {
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
      padding: 0.6rem var(--gutter) 0.8rem;
      overflow-x: auto;
      scrollbar-width: none;
      border-top: 1.5px dashed var(--linea);
      -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    .menu::-webkit-scrollbar { display: none; }
  }
</style>
