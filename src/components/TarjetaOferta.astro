---
/**
 * TarjetaOferta — Una oferta como cartulina pegada en la pared del tianguis.
 *
 * Lo que manda es el PRECIO, escrito a plumón sobre una etiqueta
 * fosforescente, con el precio viejo tachado en rojo. Debajo, el veredicto
 * del histórico como sello de hule (solo lo observado) y el Sello K-P.
 *
 * El título lleva a la página del producto (historial y detalles); el botón
 * va directo a Mercado Libre con el link OFICIAL, tal cual. La sección de la
 * que sale el clic viaja en data-kp-seccion, nunca dentro del link.
 */
import SelloKP from './SelloKP.astro';
import BotonCTA from './BotonCTA.astro';
import { formatearVendidos } from '../utils/mlPayload.js';
import { veredictoDe } from '../data/historico.js';

export interface Oferta {
  id: string;
  slug?: string;
  titulo: string;
  precio_actual: number;
  precio_previo?: number | null;
  descuento: number;
  rating: number;
  vendidos: number;
  score_kalidad_presio?: number;
  /** Link OFICIAL de afiliado (meli.la/… o /sec/…), tal cual se pegó en la vitrina. */
  link_afiliado: string;
  /** Cuándo se vio ese precio (ISO). Se muestra en la tarjeta. */
  revisado?: string | null;
  imagen: string;
  destacado?: string | null;
  oferta_relampago?: boolean;
  relampago_fin?: string | null;
  envio_gratis?: boolean;
  nota?: string | null;
  claves_historico?: string[];
  /** Qué tan respaldada está la compra, 0..100 (ventas + reputación del vendedor). */
  confianza?: number;
  vendedor_confiable?: boolean;
  [extra: string]: unknown;
}

export interface Props {
  oferta: Oferta;
  /** Score 0..100. Si no se pasa, usa score_kalidad_presio del feed. */
  score?: number;
  /** Índice en el grid: escalona la animación y alterna el giro. */
  indice?: number;
  /** Categoría para el filtro (se expone como data-cat). */
  categoria?: string;
  /** 'grid' (vertical, por defecto) o 'deal' (horizontal, más grande). */
  variant?: 'grid' | 'deal';
  /** Sección de la que sale el clic (viaja a Umami como data-kp-seccion). */
  campana?: string;
}

const { oferta, score, indice = 0, categoria, variant = 'grid', campana } = Astro.props;

const pesos = (n: number) =>
  new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(Number(n) || 0);

const vistoEl = oferta.revisado
  ? new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'short', timeZone: 'America/Mexico_City' }).format(new Date(oferta.revisado))
  : null;

// Histórico de precios: solo se afirma lo OBSERVADO (src/utils/historico.js).
const precio = veredictoDe(oferta.claves_historico ?? oferta.id, oferta.precio_actual, oferta.descuento);
const sello =
  precio.nivel === 'minimo' || precio.nivel === 'bajo' ? { tono: 'verde', texto: precio.texto }
  : precio.nivel === 'alto' ? { tono: 'azul', texto: precio.texto }
  : precio.nivel === 'descuento-falso' ? { tono: 'rojo', texto: precio.texto }
  : null;

const score100 = Math.round(score ?? oferta.score_kalidad_presio ?? 0);
const descuento = Math.round(oferta.descuento ?? 0);
const precioAntes = oferta.precio_previo && oferta.precio_previo > oferta.precio_actual ? oferta.precio_previo : null;

// Cada cartulina se pega un poco chueca, y nunca igual que la de al lado.
const giros = [-1.8, 1.2, -0.7, 1.9, -1.3, 0.8];
const giro = giros[indice % giros.length];
// La tarjeta apenas se ladea; la etiqueta de precio, encima, un poco más.
const giroTarjeta = Math.round(giro * 0.4 * 100) / 100;
const colores = ['', 'cartulina--rosa', 'cartulina--verde', 'cartulina--cielo', 'cartulina--naranja'];
const colorEtiqueta = oferta.oferta_relampago ? 'cartulina--naranja' : colores[indice % colores.length];

// Confianza: cuánta evidencia respalda la compra (ver /sobre-mi). «Alta» es
// exigente a propósito: desde 80.
const confianza = Number(oferta.confianza ?? 0);
const confNivel = confianza >= 80 ? 'alta' : confianza >= 50 ? 'media' : 'básica';

const destacado = typeof oferta.destacado === 'string' ? oferta.destacado : null;
const pagina = oferta.slug ? `/p/${oferta.slug}` : null;

const mensajeWhatsApp = `${oferta.titulo} a ${pesos(oferta.precio_actual)} (precio visto${vistoEl ? ` el ${vistoEl}` : ''}). ${oferta.link_afiliado}`;
const urlWhatsApp = `https://wa.me/?text=${encodeURIComponent(mensajeWhatsApp)}`;
---

<article
  class:list={['oferta', 'anima-pegar', { 'oferta--deal': variant === 'deal' }]}
  style={`--i:${indice % 12};--giro:${giroTarjeta}deg`}
  data-cat={categoria}
  data-ml-id={oferta.id}
  data-precio={oferta.precio_actual}
  data-descuento={descuento}
  data-kp={score100}
>
  {destacado && <p class="oferta-moño plumon">{destacado}</p>}

  <a class="oferta-foto" href={pagina ?? oferta.link_afiliado} {...(pagina ? {} : { target: '_blank', rel: 'nofollow sponsored noopener noreferrer' })} tabindex="-1" aria-hidden="true">
    {oferta.imagen
      ? <img src={oferta.imagen} alt="" width="300" height="300" loading={indice < 4 ? 'eager' : 'lazy'} decoding="async" />
      : <span class="oferta-sinfoto"></span>}
  </a>

  <div class:list={['oferta-precio', 'cartulina', 'con-cinta', colorEtiqueta]} style={`--giro:${giro}deg`}>
    {oferta.oferta_relampago && <p class="etiqueta oferta-rel">⚡ Relámpago{oferta.relampago_fin && <> · <span data-countdown data-fin={oferta.relampago_fin}>—</span></>}</p>}
    <p class="oferta-precio-linea">
      <span class="plumon oferta-precio-num">{pesos(oferta.precio_actual)}</span>
      {descuento > 0 && precioAntes && <span class="oferta-desc">−{descuento}%</span>}
    </p>
    {precioAntes && <p class="oferta-antes">antes <s class="tache">{pesos(precioAntes)}</s></p>}
  </div>

  <div class="oferta-cuerpo">
    <h3 class="oferta-titulo">
      {pagina ? <a href={pagina}>{oferta.titulo}</a> : oferta.titulo}
    </h3>

    <p class="oferta-meta etiqueta">
      {vistoEl && <span>Visto el {vistoEl}</span>}
      {oferta.rating > 0 && <span>★ {Number(oferta.rating).toFixed(1)}</span>}
      {oferta.vendidos > 0 && <span>{formatearVendidos(oferta.vendidos)}</span>}
      {oferta.envio_gratis && <span>Envío gratis</span>}
      <span class="oferta-conf" data-nivel={confNivel} title="Qué tan respaldada está la compra: unidades vendidas y reputación del vendedor">Confianza {confNivel}</span>
      {oferta.vendedor_confiable && <span>Vendedor reputado</span>}
    </p>

    {variant === 'deal' && oferta.nota && <p class="oferta-nota">«{oferta.nota}»</p>}

    <div class="oferta-sellos">
      <SelloKP score={score100} size={variant === 'deal' ? 84 : 66} />
      {sello && <span class:list={['sello', 'oferta-veredicto', 'anima-sellar', `sello--${sello.tono}`]} style={`--giro:${indice % 2 ? 4 : -5}deg`}>{sello.texto}</span>}
    </div>

    <div class="oferta-acciones">
      <BotonCTA id={oferta.id} enlace={oferta.link_afiliado} seccion={campana} texto="Ver en Mercado Libre" />
      <a
        class="oferta-compartir"
        href={urlWhatsApp}
        target="_blank"
        rel="noopener noreferrer"
        data-compartir="whatsapp"
        data-ml-id={oferta.id}
        aria-label={`Compartir ${oferta.titulo} por WhatsApp`}
        title="Compartir por WhatsApp"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.9L2 22l5.25-1.38A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.13 15.06l-.3-.18-3.12.82.83-3.04-.2-.31A8.1 8.1 0 0 1 12.04 3.8Zm4.5 10.2c-.24-.12-1.44-.71-1.66-.8-.22-.08-.39-.12-.55.13-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06a6.6 6.6 0 0 1-3.3-2.89c-.25-.43.25-.4.71-1.32.08-.16.04-.3-.02-.42-.06-.12-.55-1.33-.76-1.82-.2-.47-.4-.4-.55-.41h-.47c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.16 1.7 2.6 4.12 3.64 1.53.66 2.13.72 2.9.6.46-.06 1.44-.58 1.64-1.15.2-.57.2-1.05.14-1.15-.06-.1-.22-.16-.46-.28Z"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .oferta {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--cartulina);
    border: 2px solid var(--tinta);
    border-radius: 3px;
    padding: 0.9rem 0.9rem 1rem;
    transform: rotate(var(--giro));
    box-shadow: var(--sombra-papel);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .oferta:hover { transform: rotate(0deg) translateY(-4px); box-shadow: 8px 10px 0 var(--tinta); }

  /* Moño de «destacado», escrito a plumón y pegado en la esquina */
  .oferta-moño {
    position: absolute;
    top: -0.9rem;
    right: -0.4rem;
    z-index: 3;
    margin: 0;
    padding: 0.25rem 0.7rem;
    background: var(--tinta);
    color: var(--fosfo);
    font-size: 0.95rem;
    transform: rotate(4deg);
    border-radius: 2px;
  }

  .oferta-foto { display: block; aspect-ratio: 1; background: #fff; border-radius: 2px; overflow: hidden; }
  .oferta-foto img { width: 100%; height: 100%; object-fit: contain; padding: 6%; transition: transform 0.3s ease; }
  .oferta:hover .oferta-foto img { transform: scale(1.04); }
  .oferta-sinfoto { display: block; width: 100%; height: 100%; background: var(--papel-2); }

  /* La etiqueta de precio: cartulina fosforescente encimada sobre la foto */
  .oferta-precio {
    align-self: flex-start;
    margin: -1.6rem 0 0 -0.4rem;
    padding: 0.6rem 0.95rem 0.55rem;
    z-index: 2;
    transform: rotate(var(--giro));
  }
  .oferta-rel { margin: 0 0 0.2rem; color: var(--tinta); }
  .oferta-precio-linea { margin: 0; display: flex; align-items: baseline; gap: 0.5rem; }
  .oferta-precio-num { font-size: clamp(1.9rem, 4vw, 2.3rem); line-height: 1; letter-spacing: 0.01em; }
  .oferta-desc { font: 900 1.05rem/1 var(--f-rotulo); background: var(--tinta); color: var(--fosfo); padding: 0.2em 0.4em; border-radius: 2px; }
  .oferta-antes { margin: 0.15rem 0 0; font: 600 0.78rem/1.2 var(--f-ticket); }

  .oferta-cuerpo { display: flex; flex-direction: column; flex: 1; padding-top: 0.8rem; }
  .oferta-titulo {
    font: 700 1rem/1.35 var(--f-texto);
    letter-spacing: 0;
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .oferta-titulo a { text-decoration: none; }
  .oferta-titulo a:hover { text-decoration: underline; text-decoration-color: var(--fosfo-rosa); }
  .oferta-meta { display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; margin: 0 0 0.8rem; font-size: 0.66rem; }
  .oferta-conf::before { content: "●"; margin-right: 0.35em; color: var(--tinta-3); }
  .oferta-conf[data-nivel='alta']::before { color: var(--sello-verde); }
  .oferta-conf[data-nivel='media']::before { color: var(--fosfo-naranja); }
  .oferta-nota { margin: 0 0 0.9rem; font: 400 1.05rem/1.4 var(--f-plumon); color: var(--tinta-2); }

  .oferta-sellos { display: flex; align-items: center; gap: 0.8rem; margin: auto 0 0.9rem; min-height: 66px; }
  .oferta-veredicto { font-size: 0.82rem; max-width: 12rem; line-height: 1.1; }

  .oferta-acciones { display: flex; align-items: center; gap: 0.6rem; }
  .oferta-acciones :global(.cta) { flex: 1; font-size: 1rem; padding: 0.7em 0.9em 0.66em; }
  .oferta-compartir {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--tinta);
    border-radius: 50%;
    color: var(--tinta);
    background: var(--cartulina);
  }
  .oferta-compartir:hover { background: var(--fosfo-verde); }

  /* Variante grande (colecciones): foto a un lado */
  .oferta--deal { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 0 1.4rem; padding: 1.2rem; }
  .oferta--deal .oferta-foto { grid-row: span 2; }
  .oferta--deal .oferta-precio { margin: 0; justify-self: start; }
  .oferta--deal .oferta-titulo { font-size: 1.2rem; }
  @media (max-width: 640px) {
    .oferta--deal { grid-template-columns: 1fr; }
    .oferta--deal .oferta-precio { margin: -1.6rem 0 0 -0.4rem; }
  }

  /* En celular, la cartulina se acuesta: foto a la izquierda, precio y nombre
     a la derecha. Una oferta ocupa la mitad de alto y la lista se recorre
     con el pulgar. (display: contents suelta los hijos del cuerpo en la rejilla.) */
  @media (max-width: 560px) {
    .oferta:not(.oferta--deal) {
      display: grid;
      grid-template-columns: 124px minmax(0, 1fr);
      column-gap: 0.9rem;
      align-items: start;
      padding: 0.8rem;
    }
    .oferta:not(.oferta--deal) .oferta-foto { grid-column: 1; grid-row: 1 / span 2; }
    .oferta:not(.oferta--deal) .oferta-precio { grid-column: 2; grid-row: 1; justify-self: start; margin: 0 0 0.5rem -0.2rem; padding: 0.45rem 0.75rem 0.4rem; }
    .oferta:not(.oferta--deal) .oferta-precio-num { font-size: 1.7rem; }
    .oferta:not(.oferta--deal) .oferta-cuerpo { display: contents; }
    .oferta:not(.oferta--deal) .oferta-titulo { grid-column: 2; grid-row: 2; font-size: 0.95rem; -webkit-line-clamp: 3; line-clamp: 3; margin: 0; }
    .oferta:not(.oferta--deal) .oferta-meta,
    .oferta:not(.oferta--deal) .oferta-sellos,
    .oferta:not(.oferta--deal) .oferta-acciones { grid-column: 1 / -1; }
    .oferta:not(.oferta--deal) .oferta-meta { margin: 0.8rem 0 0.6rem; }
    .oferta:not(.oferta--deal) .oferta-sellos { margin: 0 0 0.7rem; min-height: 0; }
  }
</style>
