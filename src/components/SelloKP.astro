---
/**
 * SelloKP — El Sello K-P como sello de hule: el número que certifica.
 *
 * Verde de 80 para arriba, azul de 70 a 79 y rojo debajo de 70. Mismos
 * cortes que tierKP() en src/utils/veredicto.js. El giro sale del puntaje
 * (no al azar): la misma oferta siempre se sella igual, sin «saltos» entre
 * builds.
 *
 * Props heredadas del diseño anterior (pulse, tooltip, tipAlign) se aceptan
 * y se ignoran: el sello ya explica qué es con su `title`.
 */
export interface Props {
  score: number;
  size?: number;
  pulse?: boolean;
  tooltip?: boolean;
  tipAlign?: 'end' | 'start';
}

const { score, size = 92 } = Astro.props;
const s = Math.max(0, Math.min(100, Math.round(Number(score) || 0)));
const tier = s >= 90 ? 'Excepcional' : s >= 80 ? 'Excelente' : s >= 70 ? 'Buena' : s >= 55 ? 'Aceptable' : 'Baja';
const tono = s >= 80 ? 'verde' : s >= 70 ? 'azul' : 'rojo';
const giro = ((s * 7) % 13) - 6;
---

<span
  class={`sello-kp sello-kp--${tono}`}
  style={`--tam:${size}px;--giro:${giro}deg`}
  role="img"
  aria-label={`Sello K-P: ${s} de 100, ${tier}`}
  title={`Sello K-P: ${s} de 100 (${tier}). Combina la calificación real de los compradores, el descuento real y las ventas.`}
>
  <span class="sk-arco">Sello K-P</span>
  <span class="sk-num">{s}</span>
  <span class="sk-nivel">{tier}</span>
</span>

<style>
  .sello-kp {
    --tam: 92px;
    flex: none;
    width: var(--tam);
    height: var(--tam);
    display: inline-grid;
    place-content: center;
    text-align: center;
    border-radius: 50%;
    border: calc(var(--tam) * 0.04) solid currentColor;
    box-shadow:
      inset 0 0 0 calc(var(--tam) * 0.035) var(--cartulina),
      inset 0 0 0 calc(var(--tam) * 0.06) currentColor;
    background: rgba(255, 252, 244, 0.6);
    transform: rotate(var(--giro));
    mix-blend-mode: multiply;
    -webkit-mask-image: var(--desgaste);
    mask-image: var(--desgaste);
    -webkit-mask-size: 180px;
    mask-size: 180px;
    line-height: 1;
    user-select: none;
  }
  .sello-kp--verde { color: var(--sello-verde); }
  .sello-kp--azul { color: var(--sello-azul); }
  .sello-kp--rojo { color: var(--sello-rojo); }
  .sk-arco { font: 600 calc(var(--tam) * 0.085) / 1 var(--f-ticket); letter-spacing: 0.06em; text-transform: uppercase; }
  .sk-num { font: 900 calc(var(--tam) * 0.44) / 0.95 var(--f-rotulo); }
  .sk-nivel { font: 800 calc(var(--tam) * 0.115) / 1 var(--f-rotulo); letter-spacing: 0.06em; text-transform: uppercase; }
</style>
