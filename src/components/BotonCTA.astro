---
/**
 * BotonCTA — El botón que lleva a Mercado Libre con el link oficial.
 *
 * El link se publica TAL CUAL salió del generador de afiliados: ni sufijos ni
 * redirecciones propias. La sección de la que sale el clic viaja aparte, en
 * data-kp-seccion, para la analítica (src/components/Analitica.astro).
 */
export interface Props {
  id: string;
  /** Link OFICIAL de afiliado, tal cual sale del generador. Obligatorio. */
  enlace: string;
  texto?: string;
  /** Sección de la que sale el clic: viaja a Umami como data-kp-seccion. */
  seccion?: string;
  /** Heredada del diseño anterior; se ignora. */
  magnetic?: boolean;
  /** Variante: `fosfo` (amarillo, la principal) o `tinta` (negra). */
  tono?: 'fosfo' | 'tinta';
}

const { id, enlace, texto = 'Ver oferta', seccion, tono = 'fosfo' } = Astro.props;
---

<a
  href={enlace}
  rel="nofollow sponsored noopener noreferrer"
  target="_blank"
  class:list={['boton', 'cta', { 'boton--tinta': tono === 'tinta' }]}
  data-ml-id={id}
  data-kp-seccion={seccion}
>
  <span>{texto}</span>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6" />
  </svg>
</a>
