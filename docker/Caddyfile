# =============================================================================
# KalidaPresio — Caddy interno: sirve el sitio estático + proxy al backend.
#
# ARQUITECTURA (igual que NS Hub): este Caddy NO toca los puertos 80/443 del
# VPS ni pide certificados. Quien termina TLS y publica el dominio es **Nginx
# Proxy Manager**, que ya es dueño de 80/443 en el host. Caddy escucha en
# HTTP plano dentro de la red de Docker y NPM le hace proxy por nombre de
# contenedor (kalidapresio_web:80).
#
#   Internet → NPM (TLS, :443) → kalidapresio_web:80 (este Caddy)
#                                        ├── /api/*  → kalidapresio-api:3001
#                                        ├── /r/*    → kalidapresio-api:3001
#                                        └── resto   → sitio estático /srv
#
# SITE_ADDRESS lo define docker-compose desde .env.production:
#   · Detrás de NPM (lo normal): SITE_ADDRESS=:80   ← HTTP plano, sin TLS
#   · Caddy solo, con dominio:   SITE_ADDRESS=tu-dominio  (TLS automático)
# =============================================================================
{
	# Sin TLS propio detrás de NPM: no hace falta cuenta ACME ni puerto 443.
	auto_https off
	admin off

	servers {
		# NPM se sienta delante: sin esto {remote_host} sería siempre la IP del
		# proxy y los logs (y cualquier rate-limit futuro) verían un solo cliente.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Raíz a nivel de sitio para que la comparta el bloque de errores (la 404).
	root * /srv

	# ── Cabeceras de seguridad (aplican a todo lo que sirve este bloque) ─────
	header {
		# No adivinar el tipo de contenido: bloquea ataques de MIME sniffing.
		X-Content-Type-Options "nosniff"
		# No filtrar la URL completa a Mercado Libre en el Referer del clic.
		Referrer-Policy "strict-origin-when-cross-origin"
		# El sitio no usa cámara, micrófono ni geolocalización. Que nadie pueda.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Nadie debería poder enmarcar el sitio (clickjacking sobre los CTA).
		X-Frame-Options "SAMEORIGIN"
		# Caddy anuncia su versión por defecto; no hace falta.
		-Server
	}

	# ── Redirecciones viejas de afiliado ─────────────────────────────────────
	# El sitio ya NO redirige a Mercado Libre desde su propio dominio: publica
	# el link oficial del generador (meli.la/…, /sec/…) tal cual. /recomienda/*
	# eran links armados a mano que no generaban comisión; los que sigan
	# publicados por ahí llevan a la portada, donde están las ofertas de hoy.
	handle /recomienda/* {
		# El `*` NO sobra: en `redir / 302` Caddy lee «/» como matcher de ruta
		# (solo la ruta exacta «/»), nada coincide y responde un 200 vacío.
		redir * / 302
	}

	# /r/<canal>/<id>: enlaces viejos publicados en Telegram/WhatsApp. El
	# backend los manda a la ficha del producto (sin parámetros de afiliado) o
	# a la portada. Ningún enlace nuevo usa esta ruta.
	handle /r/* {
		reverse_proxy api:3001
	}

	# ── API → backend Express (servicio 'api' en la red interna de Docker) ──
	handle /api/* {
		reverse_proxy api:3001
	}

	# ── Sitio estático (Astro SSG) ──────────────────────────────────────────
	handle {
		# Los JSON de datos NO se cachean. El de relámpago porque el sitio lo lee
		# en runtime (frescura del carrusel sin rebuild); feed.json porque lo
		# consume n8n, y un intermediario que sirva una copia vieja hace
		# publicar precios que ya no existen.
		@datos path /data/relampago.json /data/feed.json
		header @datos Cache-Control "no-cache, must-revalidate"

		# Las tarjetas de promoción tienen nombre estable (MLM123.png) pero
		# contenido que cambia en cada build: el precio de dentro caduca. Sin
		# esto, n8n podría publicar una tarjeta cacheada con un precio que ya
		# no existe — y el sitio que presume de precios honestos sería el que
		# anuncia el viejo.
		@promos path /promos/*
		header @promos Cache-Control "no-cache, must-revalidate"

		# Assets con hash de Astro → caché agresiva e inmutable.
		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Astro genera /ruta/index.html; esto resuelve las rutas limpias.
		# OJO: sin /index.html al final. Antes lo tenía, y eso convertía CADA
		# URL inexistente en la portada con HTTP 200 (soft-404 para Google).
		try_files {path} {path}/ {path}.html
		file_server
	}

	# Errores reales con la página 404 del sitio y su código de estado correcto.
	# (Forma documentada de Caddy: matcher `expression` + rewrite + file_server.)
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
