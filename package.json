{
  "name": "kalidapresio2.0",
  "type": "module",
  "version": "1.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "obtener-ofertas": "node src/scripts/importarOfertas.js",
    "obtener-secciones": "node src/scripts/extraer-secciones.mjs",
    "enriquecer-curados": "node src/scripts/enriquecerCurados.js",
    "generar-og": "node src/scripts/generarOgImage.js",
    "detectar-nichos": "node src/scripts/detectarNichos.js",
    "verificar-frescura": "node src/scripts/verificarFrescura.js",
    "registrar-historico": "node src/scripts/registrarHistorico.js",
    "generar-feed": "node src/scripts/generarFeedPublico.js",
    "build": "node src/scripts/generadorRedirects.js && node src/scripts/generarRelampago.js && node src/scripts/generarFeedPublico.js && astro build",
    "build:completo": "node src/scripts/importarOfertas.js && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.2",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
