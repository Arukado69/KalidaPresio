# =============================================================================
# KalidaPresio — plantilla de entorno.
#
# En el VPS este archivo se llama .env.production y NO se versiona:
#   cp .env.example .env.production && nano .env.production
#   docker compose --env-file .env.production up -d --build
#
# Un solo archivo cubre los dos mundos:
#   · BUILD-TIME  → se hornean en el sitio estático (docker-compose build.args)
#   · RUNTIME     → los lee el backend en caliente (docker-compose env_file)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# BUILD-TIME · se hornean. Si cambias algo de aquí, hace falta `--build`.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio, SIN barra final. NO es cosmética: alimenta
# rel="canonical", og:url, og:image y el sitemap. Sin ella todas las páginas
# de producción declaran su canónica en http://localhost:4321 y Google las
# descarta. El build FALLA si está vacía (a propósito).
SITE_URL=https://kalidapresio.com

# === CREDENCIALES AFILIADO MERCADO LIBRE ===
# El camino del dinero: se inyectan en cada link_afiliado y en los redirects
# /recomienda/*. No son secretos (viajan visibles en cada enlace), pero sin
# ellos no se te atribuye ninguna comisión.
# Obtén estos valores en: https://www.mercadolibre.com.mx/afiliados
ML_MATT_TOOL=68549198
ML_MATT_WORD=ci20241127172754

# === OFERTAS RELÁMPAGO ===
# Origen del JSON de relámpago que el cliente descarga. Se hornea en el bundle
# (prefijo PUBLIC_ = visible en el navegador). Por defecto sirve el archivo
# local que genera el build; apúntalo a un KV/R2/CDN externo si algún día
# quieres refrescar el carrusel SIN reconstruir.
PUBLIC_RELAMPAGO_URL=/data/relampago.json

# === CONTROL ESTACIONAL ===
IS_HOT_SALE=false

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME · los lee el contenedor `api`. Cambiarlos NO exige `--build`,
# basta con `docker compose --env-file .env.production up -d`.
# ─────────────────────────────────────────────────────────────────────────────

# Dirección en la que escucha Caddy DENTRO del contenedor.
#   · Detrás de Nginx Proxy Manager (lo normal): :80  → HTTP plano, NPM da el TLS
#   · Caddy solo, con dominio propio:  kalidapresio.com  → TLS automático
SITE_ADDRESS=:80

# URL pública que usa el backend para construir los enlaces de confirmación y
# de baja del boletín. Debe coincidir con SITE_URL.
PUBLIC_SITE_URL=https://kalidapresio.com

# === BOLETÍN (doble opt-in) ===
# Secreto para firmar los tokens HMAC de confirmación y de baja. Genera uno
# largo y aleatorio; si falta, /api/subscribe responde 503 (controlado).
#   openssl rand -hex 32
SUBSCRIBE_SECRET=

# API key del ESP (Resend por defecto) para los correos transaccionales.
# Sin ella no se puede confirmar a nadie: el boletín queda deshabilitado.
RESEND_API_KEY=

# Remitente verificado en el ESP (debe ser un dominio verificado en Resend).
EMAIL_FROM=KalidaPresio <hola@kalidapresio.com>

# Bandeja que recibe los mensajes del formulario de contacto. Sin ella los
# mensajes solo se guardan en la base y nadie se entera de que llegaron.
SUPPORT_INBOX=hola@kalidapresio.com

# === EXPORTACIÓN DE SUSCRIPTORES ===
# Protege GET /api/export/subscribers, que entrega correos e IPs. SIN valor
# por defecto a propósito: si lo dejas vacío el endpoint responde 503 en vez
# de quedar abierto con un token adivinable.
# Se manda como cabecera:  Authorization: Bearer <token>
#   openssl rand -hex 32
EXPORT_TOKEN=

# Orígenes extra permitidos por CORS, separados por coma (opcional).
# Ya vienen incluidos localhost:4321, kalidapresio.com y www.kalidapresio.com.
CORS_EXTRA_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# SOLO LOCAL · scripts de datos que no corren en el VPS.
# ─────────────────────────────────────────────────────────────────────────────

# === CREDENCIALES OAuth 2.0 MERCADO LIBRE (npm run enriquecer-curados) ===
# Solo hacen falta para rellenar título e imagen de src/data/curados.json
# desde la API de catálogo. Obténlas en:
# https://developers.mercadolibre.com.mx/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
